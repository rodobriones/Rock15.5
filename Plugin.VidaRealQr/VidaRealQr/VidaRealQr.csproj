<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <RootNamespace>com.vidareal.Qr</RootNamespace>
    <AssemblyName>com.vidareal.Qr</AssemblyName>
  </PropertyGroup>

  <!-- Referencias a Rock tomadas del build del repo (RockWeb\Bin), mismo patron
       que Plugin.VidaRealEvents. Assembly propio a proposito: mezclar modulos en
       un mismo ensamblado de migraciones hace divergir dev y produccion. -->
  <ItemGroup>
    <Reference Include="Rock">
      <HintPath>..\..\RockWeb\Bin\Rock.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Common">
      <HintPath>..\..\RockWeb\Bin\Rock.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Enums">
      <HintPath>..\..\RockWeb\Bin\Rock.Enums.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntityFramework">
      <HintPath>..\..\RockWeb\Bin\EntityFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\RockWeb\Bin\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
