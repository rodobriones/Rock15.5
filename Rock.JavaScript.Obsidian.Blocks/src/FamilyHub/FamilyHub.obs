<template>
    <Panel type="block" title="Mi Familia">
        <template #default>
            <div class="fhwrap">
                <NotificationBox v-if="config.notLogged" alertType="warning">
                    Debes iniciar sesión para ver y administrar tu familia.
                </NotificationBox>

                <div v-else>
                    <div class="fhhead">
                        <div class="fhheadLeft">
                            <div class="fhtitle">Mi Familia</div>
                            <div class="fhsub text-muted">Administra miembros, datos y parentescos.</div>
                        </div>

                        <div class="fhheadRight">
                            <RockButton class="fhAddBtn" btnType="primary" @click="openNew" :disabled="busy">
                                Agregar miembro
                            </RockButton>
                        </div>
                    </div>

                    <div v-if="statusHtml" v-html="statusHtml"></div>

                    <div class="fhgrid">
                        <div v-for="m in members" :key="m.personId" class="fhcol">
                            <div class="card fhcard">
                                <div class="card-body fhcardBody">
                                    <div class="fhavatarWrap">
                                        <div class="fhavatar">
                                            <img v-if="m.photoUrl" :src="m.photoUrl" alt="Foto" />
                                            <span v-else>{{ m.initials }}</span>
                                        </div>
                                    </div>

                                    <div class="fhmemberBody">
                                        <div class="fhmemberTop">
                                            <div class="fhmemberTitle">
                                                <div class="fhname">
                                                    <span class="fhnameText">{{ m.fullName }}</span>
                                                    <span v-if="m.isMe" class="fhbadge">Yo</span>
                                                </div>

                                                <div class="fhmeta text-muted">
                                                    {{ m.familyRole }} <span class="mx-1">•</span> {{ m.ageText }}
                                                </div>
                                            </div>

                                            <button class="fhEditIconBtn" @click="openEdit(m.personId)" :disabled="busy"
                                                aria-label="Editar">
                                                ✎
                                            </button>
                                        </div>

                                        <div class="fhmemberInfo">
                                            <div class="fhinfoRow fhHideMobile">
                                                <strong>Email:</strong>
                                                <span class="fhinfoVal">{{ m.emailText }}</span>
                                            </div>

                                            <div class="fhinfoRow fhHideMobile">
                                                <strong>Móvil:</strong>
                                                <span class="fhinfoVal">{{ m.mobileText }}</span>
                                            </div>

                                            <div class="fhinfoRow">
                                                <strong>Parentesco conmigo:</strong>
                                                <span class="fhinfoVal">{{ m.relationshipToMeText }}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL -->
                    <div v-if="modalOpen" class="fhmodalBack" @click="closeModal">
                        <div class="fhmodal fhmodalApp" @click.stop>
                            <div class="fhmodalTop">
                                <div class="fhmodalTitle">
                                    {{ editModel.personId ? "Editar miembro" : "Agregar miembro" }}
                                </div>

                                <RockButton btnType="link" @click="closeModal" :disabled="busy">
                                    Cerrar
                                </RockButton>
                            </div>

                            <div class="fhmodalBody">
                                <div v-if="editError" class="fhalert">
                                    <NotificationBox alertType="danger">
                                        {{ editError }}
                                    </NotificationBox>
                                </div>

                                <div class="fhformGrid">
                                    <div class="fhformLeft">
                                        <TextBox v-model="editModel.firstName" label="Nombres" />
                                        <TextBox v-model="editModel.lastName" label="Apellidos" />

                                        <div class="fhform2">
                                            <DatePicker v-model="editModel.birthDate" label="Fecha de nacimiento" />
                                            <DropDownList v-model="genderValue" :items="genderOptions" label="Género" />
                                        </div>

                                        <TextBox v-model="editModel.email" label="Email" />

                                      <div class="fhField">
    <div class="fhLabel">Teléfono</div>

    <div class="fhPhoneInput">
        <button
            type="button"
            class="fhPhoneCodeBtn"
            :disabled="busy"
            @click="phoneMenuOpen = !phoneMenuOpen">
            {{ editModel.phoneCountry }}
            <span class="fhCaret" aria-hidden="true"></span>
        </button>

        <input
            class="fhPhoneNumberInput"
            type="tel"
            inputmode="numeric"
            autocomplete="tel-national"
            :disabled="busy"
            v-model="editModel.phoneNumber"
            placeholder="Teléfono móvil"
            @input="onPhoneNumberInput"
            @blur="phoneMenuOpen = false" />

        <div v-if="phoneMenuOpen" class="fhPhoneMenu">
            <button type="button" class="fhPhoneMenuItem" @mousedown.prevent="setPhoneCountry('502')">502</button>
            <button type="button" class="fhPhoneMenuItem" @mousedown.prevent="setPhoneCountry('503')">503</button>
            <button type="button" class="fhPhoneMenuItem" @mousedown.prevent="setPhoneCountry('1')">1</button>
        </div>
    </div>

    <div class="fhHelp text-muted">Código por defecto: 502</div>
</div>



                                        <DropDownList v-model="relationshipValue" :items="relationshipRoles"
                                            label="Parentesco conmigo (Known Relationships)" />

                                        <div class="fhhelp text-muted">
                                            Esto crea/actualiza la relación desde tu perfil hacia este miembro en Known
                                            Relationships.
                                        </div>
                                    </div>

                                    <div class="fhformRight">
    <div class="fhphotoCard">
        <div class="fhphotoStage">
            <div class="fhavatar fhavatarLg fhavatarPhoto">
                <img v-if="photoPreviewUrl" :src="photoPreviewUrl" alt="Foto" />
                <span v-else>{{ photoPreviewInitials }}</span>

                <!-- Botón lápiz -->
                <button
                    type="button"
                    class="fhPhotoPencil"
                    :disabled="busy"
                    @click="triggerPhotoPicker"
                    aria-label="Cambiar foto">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- FileUploader oculto (no debe verse) -->
        <div class="fhHiddenUploader" ref="uploaderHost">
            <FileUploader
                v-model="photoFile"
                label=""
                :binaryFileTypeGuid="config.personImageBinaryFileTypeGuid" />
        </div>

        <div class="fhhelp text-muted">
            Tocá el lápiz para cambiar la foto. Al guardar, se asigna como PhotoId del miembro.
        </div>
    </div>
</div>

                                </div>
                            </div>

                            <div class="fhmodalActions">
                                <RockButton btnType="primary" @click="save" :disabled="busy">
                                    {{ busy ? "Guardando…" : "Guardar" }}
                                </RockButton>

                                <RockButton btnType="default" @click="closeModal" :disabled="busy">
                                    Cancelar
                                </RockButton>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel";
import RockButton from "@Obsidian/Controls/rockButton";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import TextBox from "@Obsidian/Controls/textBox";
import DatePicker from "@Obsidian/Controls/datePicker.obs";
import DropDownList from "@Obsidian/Controls/dropDownList";
import FileUploader from "@Obsidian/Controls/fileUploader";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type ListItemBag = { text: string; value: string };

type Member = {
    personId: number;
    fullName: string;
    isMe: boolean;
    familyRole: string;
    ageText: string;
    emailText: string;
    mobileText: string;
    relationshipToMeText: string;
    photoUrl: string;
    initials: string;
};

type InitBag = {
    notLogged: boolean;
    statusHtml: string;
    members: Member[];
    relationshipRoles: ListItemBag[];
    genderOptions: ListItemBag[];
    personImageBinaryFileTypeGuid: string;
};

type EditModel = {
    personId: number | null;
    firstName: string;
    lastName: string;
    birthDate: string;
    gender: number | null;
    email: string;

    phoneCountry: string; // "+502", "+503", "+1"
    phoneNumber: string; // dígitos

    relationshipRoleId: number | null;
    photoUrl: string;
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const members = ref<Member[]>(config.members || []);
const statusHtml = ref<string>(config.statusHtml || "");

const relationshipRoles = ref<ListItemBag[]>(config.relationshipRoles || []);
const genderOptions = ref<ListItemBag[]>(config.genderOptions || []);

const phoneCountries = ref<ListItemBag[]>([
    { text: "+502", value: "+502" },
    { text: "+503", value: "+503" },
    { text: "+1", value: "+1" }
]);

const phoneMenuOpen = ref<boolean>(false);

function setPhoneCountry(cc: string) {
    editModel.value.phoneCountry = cc;
    phoneMenuOpen.value = false;
}

function onPhoneNumberInput(e: Event) {
    const el = e.target as HTMLInputElement;
    const digits = String(el.value || "").replace(/[^\d]/g, "");
    if (digits !== el.value) {
        el.value = digits;
    }
    editModel.value.phoneNumber = digits;
}


const modalOpen = ref<boolean>(false);
const busy = ref<boolean>(false);
const editError = ref<string>("");

const editModel = ref<EditModel>({
    personId: null,
    firstName: "",
    lastName: "",
    birthDate: "",
    gender: null,
    email: "",
    phoneCountry: "+502",
    phoneNumber: "",
    relationshipRoleId: null,
    photoUrl: ""
});

const genderValue = computed<string>({
    get() {
        return editModel.value.gender == null ? "" : String(editModel.value.gender);
    },
    set(v: string) {
        const n = Number(v);
        editModel.value.gender = v ? (Number.isFinite(n) ? n : null) : null;
    }
});

const relationshipValue = computed<string>({
    get() {
        return editModel.value.relationshipRoleId == null ? "" : String(editModel.value.relationshipRoleId);
    },
    set(v: string) {
        const n = Number(v);
        editModel.value.relationshipRoleId = v ? (Number.isFinite(n) ? n : null) : null;
    }
});

// Rock 15.5.1 FileUploader v-model: ListItemBag|null
const photoFile = ref<ListItemBag | null>(null);
watch(photoFile, (val) => {
    console.log("PHOTO FILE CHANGED:", val);
});

function onlyDigits(s: string): string {
    return String(s || "").replace(/[^\d]/g, "");
}

function parsePhone(raw: string): { cc: string; num: string } {
    const d = onlyDigits(raw || "");
    if (!d) return { cc: "+502", num: "" };

    if (d.startsWith("502")) return { cc: "+502", num: d.substring(3) };
    if (d.startsWith("503")) return { cc: "+503", num: d.substring(3) };
    if (d.startsWith("1")) return { cc: "+1", num: d.substring(1) };

    return { cc: "+502", num: d };
}

// FileUploader entrega el BinaryFileId como string en .value
const photoBinaryFileGuid = computed<string | null>(() => {
    const raw = photoFile.value?.value;
    if (!raw) return null;

    const s = String(raw).trim();
    return s.length > 0 ? s : null;
});

const photoPreviewUrl = computed<string>(() => {
    const guid = photoBinaryFileGuid.value;
    if (guid) {
        return `/GetImage.ashx?guid=${encodeURIComponent(guid)}&w=160&h=160&mode=crop`;
    }
    return editModel.value.photoUrl || "";
});

const photoPreviewInitials = computed<string>(() => {
    const full = `${(editModel.value.firstName || "").trim()} ${(editModel.value.lastName || "").trim()}`.trim();
    const parts = full.split(" ").filter(p => p.trim().length > 0);
    if (parts.length === 0) return "—";
    const a = parts[0]?.[0] || "";
    const b = parts.length > 1 ? (parts[parts.length - 1]?.[0] || "") : "";
    const s = (a + b).trim();
    return s ? s.toUpperCase() : "—";
});

function closeModal() {
    if (busy.value) return;
    modalOpen.value = false;
    editError.value = "";
}

function openNew() {
    editError.value = "";
    photoFile.value = null;

    editModel.value = {
        personId: null,
        firstName: "",
        lastName: "",
        birthDate: "",
        gender: null,
        email: "",
        phoneCountry: "+502",
        phoneNumber: "",
        relationshipRoleId: null,
        photoUrl: ""
    };

    modalOpen.value = true;
}

async function openEdit(personId: number) {
    editError.value = "";
    photoFile.value = null;
    busy.value = true;

    try {
        const res = await invokeBlockAction<any>("GetEdit", { bag: { personId } });

        if (!res.isSuccess || !res.data?.model) {
            editError.value = res.errorMessage || "No se pudo cargar el miembro.";
            modalOpen.value = true;
            return;
        }

        const m = res.data.model;
        const p = parsePhone(String(m.mobile || ""));

        editModel.value = {
            personId: m.personId ?? null,
            firstName: String(m.firstName || ""),
            lastName: String(m.lastName || ""),
            birthDate: String(m.birthDate || ""),
            gender: m.gender == null ? null : Number(m.gender),
            email: String(m.email || ""),
            phoneCountry: p.cc,
            phoneNumber: p.num,
            relationshipRoleId: m.relationshipRoleId == null ? null : Number(m.relationshipRoleId),
            photoUrl: String(m.photoUrl || "")
        };

        modalOpen.value = true;
    } catch {
        editError.value = "Error cargando el miembro.";
        modalOpen.value = true;
    } finally {
        busy.value = false;
    }
}

async function save() {
    editError.value = "";

    const first = (editModel.value.firstName || "").trim();
    const last = (editModel.value.lastName || "").trim();

    if (!first || !last) {
        editError.value = "Nombres y apellidos son requeridos.";
        return;
    }

    busy.value = true;

    try {
        const phoneDigits = onlyDigits(editModel.value.phoneNumber || "");
        const ccDigits = onlyDigits(editModel.value.phoneCountry || "+502");
        const combinedMobile = phoneDigits ? (ccDigits + phoneDigits) : "";

        const bag = {
            personId: editModel.value.personId,
            firstName: first,
            lastName: last,
            birthDate: editModel.value.birthDate || "",
            gender: editModel.value.gender,
            email: editModel.value.email || "",
            mobile: combinedMobile,
            relationshipRoleId: editModel.value.relationshipRoleId,
            photoBinaryFileGuid: photoBinaryFileGuid.value
        };

        const res = await invokeBlockAction<any>("SaveMember", { bag });

        if (!res.isSuccess || !res.data) {
            editError.value = res.errorMessage || "No se pudo guardar.";
            return;
        }

        statusHtml.value = String(res.data.statusHtml || "");
        members.value = (res.data.members || []) as Member[];
        modalOpen.value = false;
    } catch {
        editError.value = "Error guardando cambios.";
    } finally {
        busy.value = false;
    }
}

const uploaderHost = ref<HTMLElement | null>(null);

function triggerPhotoPicker() {
    if (busy.value) return;

    // Buscar el input file que FileUploader genera internamente y disparar click
    const host = uploaderHost.value;
    const input = host?.querySelector('input[type="file"]') as HTMLInputElement | null;
    input?.click();
}

</script>

<style>
/* ========= Base wrapper ========= */
.fhavatarPhoto { position: relative; }

.fhPhotoPencil {
    position: absolute;
    right: 6px;
    top: 6px;

    width: 38px;
    height: 38px;
    border-radius: 999px;

    border: 1px solid rgba(0,0,0,0.10);
    background: rgba(255,255,255,0.92);
    box-shadow: 0 6px 16px rgba(0,0,0,0.12);

    display: grid;
    place-items: center;

    color: rgba(0,0,0,0.75);
    cursor: pointer;
}

.fhPhotoPencil:hover { background: rgba(255,255,255,1); color: rgba(0,0,0,0.95); }
.fhPhotoPencil:disabled { opacity: 0.6; cursor: not-allowed; }

/* Ocultar totalmente el uploader */
.fhHiddenUploader {
    position: absolute;
    left: -99999px;
    top: -99999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
}


.fhwrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 8px;
}

.fhhead {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
}

.fhheadLeft {
    min-width: 0;
}

.fhtitle {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
}

.fhsub {
    font-size: 13px;
    line-height: 1.3;
}

.fhheadRight {
    flex: 0 0 auto;
}

.fhAddBtn {
    white-space: nowrap;
}

.fhgrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

@media (min-width: 768px) {
    .fhgrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (min-width: 1200px) {
    .fhgrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

.fhcard {
    height: 100%;
}

.fhcardBody {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-width: 0;
}

.fhavatarWrap {
    flex: 0 0 auto;
}

.fhavatar {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #f3f3f3;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

.fhavatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.fhavatar span {
    font-weight: 700;
}

.fhmemberBody {
    min-width: 0;
    width: 100%;
}

.fhmemberTop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
}

.fhmemberTitle {
    min-width: 0;
}

.fhname {
    display: flex;
    gap: 8px;
    align-items: center;
    min-width: 0;
}

.fhnameText {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
}

.fhbadge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    white-space: nowrap;
}

.fhmeta {
    font-size: 12px;
    margin-top: 2px;
}

.fhmemberInfo {
    margin-top: 8px;
    font-size: 12.5px;
    display: grid;
    gap: 6px;
}

.fhinfoRow {
    display: flex;
    gap: 6px;
    min-width: 0;
}

.fhinfoVal {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Botón lápiz (lista) */
.fhEditIconBtn {
    border: none;
    background: transparent;
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    line-height: 1;
    border-radius: 50%;
    color: #6c757d;
}

.fhEditIconBtn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #000;
}

.fhEditIconBtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

/* ========= Modal (app style) ========= */
.fhmodalBack {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    padding: 12px;
    display: grid;
    place-items: center;
    z-index: 1050;
}

.fhmodal {
    width: min(920px, 100%);
    max-height: 90vh;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
}

.fhmodalApp {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.fhmodalTop {
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 2;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.fhmodalTitle {
    font-size: 16px;
    font-weight: 700;
}

.fhmodalBody {
    padding: 12px;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
}

.fhalert {
    margin-top: 10px;
}

.fhmodalActions {
    position: sticky;
    bottom: 0;
    background: #fff;
    z-index: 2;
    padding: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.fhformGrid {
    margin-top: 12px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
}

@media (min-width: 992px) {
    .fhformGrid {
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 14px;
        align-items: start;
    }
}

.fhformLeft,
.fhformRight {
    min-width: 0;
}

.fhform2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
}

@media (min-width: 576px) {
    .fhform2 {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
}

.fhformGrid .form-control,
.fhformGrid input,
.fhformGrid select,
.fhformGrid textarea {
    width: 100%;
    max-width: 100%;
}

/* Teléfono: selector + input */
.fhPhoneRow {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 12px;
}

@media (max-width: 576px) {
    .fhPhoneRow {
        grid-template-columns: 1fr;
    }
}

/* Foto con lápiz overlay */
.fhphotoCard {
    display: grid;
    gap: 10px;
}

.fhphotoStage {
    display: grid;
    place-items: center;
    position: relative;
    padding: 6px 0 2px;
}

.fhavatarLg {
    width: 96px;
    height: 96px;
}

.fhPhotoEditOverlay {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.10);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
    display: grid;
    place-items: center;
    color: rgba(0, 0, 0, 0.75);
}

.fhPhotoEditOverlay.isDisabled {
    opacity: 0.6;
    pointer-events: none;
}

.fhUploaderOverlay {
    position: absolute;
    inset: 0;
    opacity: 0.001;
}

.fhUploaderOverlay * {
    width: 100% !important;
    height: 100% !important;
}

.fhhelp {
    font-size: 12px;
    margin-top: 6px;
}

/* ========= Mobile tweaks ========= */
@media (max-width: 576px) {
    .fhwrap {
        padding: 10px 6px;
    }

    .fhhead {
        flex-direction: column;
        align-items: stretch;
    }

    .fhheadRight,
    .fhAddBtn {
        width: 100%;
    }

    .fhcardBody {
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .fhavatarWrap {
        display: block;
    }

    .fhavatar {
        width: 52px;
        height: 52px;
    }

    .fhHideMobile {
