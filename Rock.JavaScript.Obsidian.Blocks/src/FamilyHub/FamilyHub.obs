<template>
    <Panel type="block" title="Mi Familia">
        <template #default>
            <div class="fhwrap">
                <NotificationBox v-if="config.notLogged" alertType="warning">
                    Debes iniciar sesión para ver y administrar tu familia.
                </NotificationBox>

                <div v-else>
                    <div class="fhhead">
                        <div class="fhheadLeft">
                            <div class="fhtitle">Mi Familia</div>
                            <div class="fhsub text-muted">Administra miembros, datos y parentescos.</div>
                        </div>

                        <div class="fhheadRight">
                            <RockButton class="fhAddBtn" btnType="primary" @click="openNew" :disabled="busy">
                                Agregar miembro
                            </RockButton>
                        </div>
                    </div>

                    <div v-if="statusHtml" v-html="statusHtml"></div>

                    <div class="fhgrid">
                        <div v-for="m in members" :key="m.personId" class="fhcol">
                            <div class="card fhcard">
                                <div class="card-body fhcardBody">
                                    <div class="fhavatarWrap">
                                        <div class="fhavatar">
                                            <img v-if="m.photoUrl" :src="m.photoUrl" alt="Foto" />
                                            <span v-else>{{ m.initials }}</span>
                                        </div>
                                    </div>

                                    <div class="fhmemberBody">
                                        <div class="fhmemberTop">
    <div class="fhmemberTitle">
        <div class="fhname">
            <span class="fhnameText">{{ m.fullName }}</span>
            <span v-if="m.isMe" class="fhbadge">Yo</span>
        </div>

        <div class="fhmeta text-muted">
            {{ m.familyRole }} <span class="mx-1">•</span> {{ m.ageText }}
        </div>
    </div>

    <!-- BOTÓN LÁPIZ -->
    <button
    class="fhEditIconBtn"
    @click="openEdit(m.personId)"
    :disabled="busy"
    aria-label="Editar">
    ✎
</button>

</div>


                                        <div class="fhmemberInfo">
                                        <div class="fhinfoRow fhHideMobile">
                                            <strong>Email:</strong>
                                            <span class="fhinfoVal">{{ m.emailText }}</span>
                                        </div>

                                        <div class="fhinfoRow fhHideMobile">
                                            <strong>Móvil:</strong>
                                            <span class="fhinfoVal">{{ m.mobileText }}</span>
                                        </div>

                                        <div class="fhinfoRow">
                                            <strong>Parentesco conmigo:</strong>
                                            <span class="fhinfoVal">{{ m.relationshipToMeText }}</span>
                                        </div>
                                    </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL -->
                    <div v-if="modalOpen" class="fhmodalBack" @click="closeModal">
                        <div class="fhmodal" @click.stop>
                            <div class="fhmodalTop">
                                <div class="fhmodalTitle">
                                    {{ editModel.personId ? "Editar miembro" : "Agregar miembro" }}
                                </div>

                                <RockButton btnType="link" @click="closeModal" :disabled="busy">
                                    Cerrar
                                </RockButton>
                            </div>

                            <div v-if="editError" class="fhalert">
                                <NotificationBox alertType="danger">
                                    {{ editError }}
                                </NotificationBox>
                            </div>

                            <div class="fhformGrid">
                                <div class="fhformLeft">
                                    <TextBox v-model="editModel.firstName" label="Nombres" />
                                    <TextBox v-model="editModel.lastName" label="Apellidos" />

                                    <div class="fhform2">
                                        <DatePicker v-model="editModel.birthDate" label="Fecha de nacimiento" />
                                        <DropDownList v-model="genderValue" :items="genderOptions" label="Género" />
                                    </div>

                                    <TextBox v-model="editModel.email" label="Email" />
                                    <TextBox v-model="editModel.mobile" label="Teléfono móvil" />

                                    <DropDownList
                                        v-model="relationshipValue"
                                        :items="relationshipRoles"
                                        label="Parentesco conmigo (Known Relationships)" />

                                    <div class="fhhelp text-muted">
                                        Esto crea/actualiza la relación desde tu perfil hacia este miembro en Known Relationships.
                                    </div>
                                </div>

                                <div class="fhformRight">
                                    <div class="fhphotoPreview">
                                        <div class="fhavatar fhavatarLg">
                                            <img v-if="photoPreviewUrl" :src="photoPreviewUrl" alt="Foto" />
                                            <span v-else>{{ photoPreviewInitials }}</span>
                                        </div>
                                    </div>

                                    <FileUploader
                                        v-model="photoFile"
                                        label="Foto"
                                        :binaryFileTypeGuid="config.personImageBinaryFileTypeGuid" />

                                    <div class="fhhelp text-muted">
                                        Al guardar, la foto se asigna como PhotoId del miembro.
                                    </div>
                                </div>
                            </div>

                            <div class="fhmodalActions">
                                <RockButton btnType="primary" @click="save" :disabled="busy">
                                    {{ busy ? "Guardando…" : "Guardar" }}
                                </RockButton>

                                <RockButton btnType="default" @click="closeModal" :disabled="busy">
                                    Cancelar
                                </RockButton>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel";
import RockButton from "@Obsidian/Controls/rockButton";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import TextBox from "@Obsidian/Controls/textBox";
import DatePicker from "@Obsidian/Controls/datePicker.obs";
import DropDownList from "@Obsidian/Controls/dropDownList";
import FileUploader from "@Obsidian/Controls/fileUploader";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";



type ListItemBag = { text: string; value: string };

type Member = {
    personId: number;
    fullName: string;
    isMe: boolean;
    familyRole: string;
    ageText: string;
    emailText: string;
    mobileText: string;
    relationshipToMeText: string;
    photoUrl: string;
    initials: string;
};

type InitBag = {
    notLogged: boolean;
    statusHtml: string;
    members: Member[];
    relationshipRoles: ListItemBag[];
    genderOptions: ListItemBag[];
    personImageBinaryFileTypeGuid: string;
};

type EditModel = {
    personId: number | null;
    firstName: string;
    lastName: string;
    birthDate: string; // yyyy-MM-dd
    gender: number | null;
    email: string;
    mobile: string;
    relationshipRoleId: number | null;
    photoUrl: string;
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const members = ref<Member[]>(config.members || []);
const statusHtml = ref<string>(config.statusHtml || "");

const relationshipRoles = ref<ListItemBag[]>(config.relationshipRoles || []);
const genderOptions = ref<ListItemBag[]>(config.genderOptions || []);

const modalOpen = ref<boolean>(false);
const busy = ref<boolean>(false);
const editError = ref<string>("");

const editModel = ref<EditModel>({
    personId: null,
    firstName: "",
    lastName: "",
    birthDate: "",
    gender: null,
    email: "",
    mobile: "",
    relationshipRoleId: null,
    photoUrl: ""
});

const genderValue = computed<string>({
    get() {
        return editModel.value.gender == null ? "" : String(editModel.value.gender);
    },
    set(v: string) {
        const n = Number(v);
        editModel.value.gender = v ? (Number.isFinite(n) ? n : null) : null;
    }
});

const relationshipValue = computed<string>({
    get() {
        return editModel.value.relationshipRoleId == null ? "" : String(editModel.value.relationshipRoleId);
    },
    set(v: string) {
        const n = Number(v);
        editModel.value.relationshipRoleId = v ? (Number.isFinite(n) ? n : null) : null;
    }
});

// Rock 15.5.1 FileUploader v-model: ListItemBag|null
const photoFile = ref<ListItemBag | null>(null);
watch(photoFile, (val) => {
    console.log("PHOTO FILE CHANGED:", val);
});


// FileUploader entrega el BinaryFileId como string en .value
const photoBinaryFileGuid = computed<string | null>(() => {
    const raw = photoFile.value?.value;
    if (!raw) return null;

    const s = String(raw).trim();
    return s.length > 0 ? s : null;
});


const photoPreviewUrl = computed<string>(() => {
    const guid = photoBinaryFileGuid.value;
    if (guid) {
        return `/GetImage.ashx?guid=${encodeURIComponent(guid)}&w=160&h=160&mode=crop`;
    }
    return editModel.value.photoUrl || "";
});


const photoPreviewInitials = computed<string>(() => {
    const full = `${(editModel.value.firstName || "").trim()} ${(editModel.value.lastName || "").trim()}`.trim();
    const parts = full.split(" ").filter(p => p.trim().length > 0);
    if (parts.length === 0) return "—";
    const a = parts[0]?.[0] || "";
    const b = parts.length > 1 ? (parts[parts.length - 1]?.[0] || "") : "";
    const s = (a + b).trim();
    return s ? s.toUpperCase() : "—";
});

function closeModal() {
    if (busy.value) return;
    modalOpen.value = false;
    editError.value = "";
}

function openNew() {
    editError.value = "";
    photoFile.value = null;

    editModel.value = {
        personId: null,
        firstName: "",
        lastName: "",
        birthDate: "",
        gender: null,
        email: "",
        mobile: "",
        relationshipRoleId: null,
        photoUrl: ""
    };

    modalOpen.value = true;
}

async function openEdit(personId: number) {
    editError.value = "";
    photoFile.value = null;
    busy.value = true;

    try {
        const res = await invokeBlockAction<any>("GetEdit", { bag: { personId } });

        if (!res.isSuccess || !res.data?.model) {
            editError.value = res.errorMessage || "No se pudo cargar el miembro.";
            modalOpen.value = true;
            return;
        }

        const m = res.data.model;

        editModel.value = {
            personId: m.personId ?? null,
            firstName: String(m.firstName || ""),
            lastName: String(m.lastName || ""),
            birthDate: String(m.birthDate || ""),
            gender: m.gender == null ? null : Number(m.gender),
            email: String(m.email || ""),
            mobile: String(m.mobile || ""),
            relationshipRoleId: m.relationshipRoleId == null ? null : Number(m.relationshipRoleId),
            photoUrl: String(m.photoUrl || "")
        };

        modalOpen.value = true;
    } catch {
        editError.value = "Error cargando el miembro.";
        modalOpen.value = true;
    } finally {
        busy.value = false;
    }
}

async function save() {
    editError.value = "";

    const first = (editModel.value.firstName || "").trim();
    const last = (editModel.value.lastName || "").trim();

    if (!first || !last) {
        editError.value = "Nombres y apellidos son requeridos.";
        return;
    }

    busy.value = true;

    try {
            console.log("PHOTO FILE MODEL:", photoFile.value);
    console.log("PHOTO BINARY FILE GUID:", photoBinaryFileGuid.value);


        const bag = {
            personId: editModel.value.personId,
            firstName: first,
            lastName: last,
            birthDate: editModel.value.birthDate || "",
            gender: editModel.value.gender,
            email: editModel.value.email || "",
            mobile: editModel.value.mobile || "",
            relationshipRoleId: editModel.value.relationshipRoleId,
            photoBinaryFileGuid: photoBinaryFileGuid.value

        };

        const res = await invokeBlockAction<any>("SaveMember", { bag });

        if (!res.isSuccess || !res.data) {
            editError.value = res.errorMessage || "No se pudo guardar.";
            return;
        }

        statusHtml.value = String(res.data.statusHtml || "");
        members.value = (res.data.members || []) as Member[];
        modalOpen.value = false;
    } catch {
        editError.value = "Error guardando cambios.";
    } finally {
        busy.value = false;
    }
}
</script>

<style>
/* (tu CSS igual, lo dejo tal cual lo tenías) */
/* ========= Base wrapper ========= */
.fhwrap { max-width: 1100px; margin: 0 auto; padding: 10px 8px; }
.fhhead { display: flex; gap: 10px; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
.fhheadLeft { min-width: 0; }
.fhtitle { font-size: 20px; font-weight: 700; line-height: 1.2; }
.fhsub { font-size: 13px; line-height: 1.3; }
.fhheadRight { flex: 0 0 auto; }
.fhAddBtn { white-space: nowrap; }
.fhgrid { display: grid; grid-template-columns: 1fr; gap: 12px; }
@media (min-width: 768px) { .fhgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1200px) { .fhgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.fhcard { height: 100%; }
.fhcardBody { display: flex; gap: 12px; align-items: flex-start; min-width: 0; }
.fhavatarWrap { flex: 0 0 auto; }
.fhavatar { width: 56px; height: 56px; border-radius: 999px; overflow: hidden; display: grid; place-items: center; background: #f3f3f3; border: 1px solid rgba(0,0,0,0.06); }
.fhavatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.fhavatar span { font-weight: 700; }
.fhmemberBody { min-width: 0; width: 100%; }
.fhmemberTop { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start; }
.fhmemberTitle { min-width: 0; }
.fhname { display: flex; gap: 8px; align-items: center; min-width: 0; }
.fhnameText { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
.fhbadge { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: rgba(0,0,0,0.06); white-space: nowrap; }
.fhmeta { font-size: 12px; margin-top: 2px; }
.fhactions { display: flex; justify-content: flex-end; }
.fhEditBtn { white-space: nowrap; }
.fhmemberInfo { margin-top: 8px; font-size: 12.5px; display: grid; gap: 6px; }
.fhinfoRow { display: flex; gap: 6px; min-width: 0; }
.fhinfoVal { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fhmodalBack { position: fixed; inset: 0; background: rgba(0,0,0,0.55); padding: 12px; display: grid; place-items: center; z-index: 1050; }
.fhmodal { width: min(920px, 100%); max-height: 90vh; overflow: auto; background: #fff; border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); padding: 12px; }
.fhmodalTop { position: sticky; top: 0; background: #fff; z-index: 2; display: flex; gap: 10px; align-items: center; justify-content: space-between; padding: 8px 2px 10px 2px; border-bottom: 1px solid rgba(0,0,0,0.06); }
.fhmodalTitle { font-size: 16px; font-weight: 700; }
.fhalert { margin-top: 10px; }
/* Botón lápiz */
.fhEditIconBtn {
    border: none;
    background: transparent;
    cursor: pointer;

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;
    line-height: 1;

    border-radius: 50%;
    color: #6c757d;
}

.fhEditIconBtn:hover {
    background: rgba(0,0,0,0.06);
    color: #000;
}

.fhEditIconBtn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}



.fhformGrid { margin-top: 12px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
@media (min-width: 992px) { .fhformGrid { grid-template-columns: minmax(0, 1fr) 320px; gap: 14px; align-items: start; } }
.fhformLeft, .fhformRight { min-width: 0; }
.fhform2 { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
@media (min-width: 576px) { .fhform2 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
.fhformGrid .form-control, .fhformGrid input, .fhformGrid select, .fhformGrid textarea { width: 100%; max-width: 100%; }
.fhphotoPreview { display: grid; place-items: center; padding: 8px 0 10px; }
.fhavatarLg { width: 96px; height: 96px; }
.fhhelp { font-size: 12px; margin-top: 6px; }
.fhmodalActions { margin-top: 14px; display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
@media (max-width: 576px) {
    .fhwrap { padding: 10px 6px; }
    .fhhead { flex-direction: column; align-items: stretch; }
    .fhheadRight, .fhAddBtn { width: 100%; }

    /* Card layout móvil: foto izquierda, info derecha */
    .fhcardBody {
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .fhavatarWrap { display: block; }
    .fhavatar { width: 52px; height: 52px; }

    /* Título/meta a la derecha; acciones abajo */
    .fhmemberTop { grid-template-columns: 1fr; }
    .fhactions { width: 100%; justify-content: stretch; margin-top: 8px; }
    .fhEditBtn { width: 100%; }

    /* Ocultar Email y Móvil SOLO en móvil */
    .fhHideMobile { display: none !important; }

    /* Deja relación en una línea bonita */
    .fhinfoVal {
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
        word-break: break-word;
    }

    .fhmodal { padding: 10px; border-radius: 10px; }
    .fhmodalActions { justify-content: stretch; }
    .fhmodalActions > * { width: 100%; }

    .fhmemberTop {
        grid-template-columns: 1fr auto;
        align-items: center;
    }
}

</style>
