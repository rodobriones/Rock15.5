<template>
    <div class="registrationentry-success">
        <NotificationBox v-if="showRegistrationFullNotification" class="text-left" alertType="warning">
            <strong>{{ t("headingRegistrationFull", { registration: registrationEntryTerms.registrationSingularTitleCase }) }}</strong>
            <p>
                {{ t("messageRegistrationNoCapacity", { registration: registrationEntryTerms.registrationSingularLowerCase }) }}
            </p>
        </NotificationBox>
        <NotificationBox v-if="showSomeRegistrantsWaitListedNotification" class="text-left" alertType="warning">
            <strong>{{ t("labelUnfortunately") }}</strong>
            <p>{{ someRegistrantsWaitListedMessage }}</p>
        </NotificationBox>
        <NotificationBox v-if="showAllRegistrantsWaitListedNotification" class="text-left" alertType="warning">
            <strong>{{ t("labelUnfortunately") }}</strong>
            <p>{{ allRegistrantsWaitListedMessage }}</p>
        </NotificationBox>
        <div class="registrationentry-success-message well" v-html="messageHtml"></div>
    </div>
</template>

<script setup lang="ts">
    import { computed } from "vue";
    import { CurrentRegistrationEntryState, getRegistrationEntryText, isSpanishUiLanguage, RegistrationEntryTerms, use } from "./utils.partial";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { pluralConditional } from "@Obsidian/Utility/stringUtils";

    const registrationEntryState = use(CurrentRegistrationEntryState);
    const registrationEntryTerms = use(RegistrationEntryTerms);
    const t = getRegistrationEntryText;

    // #region Computed Values

    const registeredCount = computed<number>(() => {
        return registrationEntryState.successViewModel?.registeredCount ?? 0;
    });

    /** The number of these registrants that will be placed on a waitlist because of capacity rules */
    const waitListedCount = computed<number>(() => {
        return registrationEntryState.successViewModel?.waitListedCount ?? 0;
    });

    /** The registrants wait-listed phrase: Ex: "camper was" or "2 campers were" */
    const allRegistrantsWaitListedMessage = computed<string>(() => {
        const {
            registrantSingularLowerCase,
            registrantPluralLowerCase
        } = registrationEntryTerms.value;
        const waitlistedCountPhrase = pluralConditional(waitListedCount.value, `${registrantSingularLowerCase} was`, `${waitListedCount.value} ${registrantPluralLowerCase} were`);
        return t("messageRegistrationAllWaitlisted", { waitlistedCountPhrase });
    });

    const someRegistrantsWaitListedMessage = computed<string>(() => {
        const {
            registrationSingularLowerCase,
            registrantSingularLowerCase,
            registrantPluralLowerCase
        } = registrationEntryTerms.value;

        const registeredCountPhrase = pluralConditional(registeredCount.value, `1 ${registrantSingularLowerCase}`, `${registeredCount.value} ${registrantPluralLowerCase}`);
        const firstWaitlistedPhrase = pluralConditional(registeredCount.value, `${registrantSingularLowerCase} you added was`, `${registeredCount.value} ${registrantPluralLowerCase} you added were`);
        const remainingWaitlistedPhrase = pluralConditional(waitListedCount.value, `${registrantSingularLowerCase} was`, `${waitListedCount.value} ${registrantPluralLowerCase} were`);

        return t("messageRegistrationSomeWaitlisted", {
            registration: registrationSingularLowerCase,
            registeredCountPhrase,
            firstWaitlistedPhrase,
            instanceName: registrationEntryState.viewModel.instanceName || '',
            remainingWaitlistedPhrase
        });
    });

    /** Should the "registration full" notification be shown? */
    const showRegistrationFullNotification = computed<boolean>(() => {
        // Show if there are no spots remaining and no one was wait-listed nor registered.
        return registrationEntryState.successViewModel?.spotsRemaining === 0
            && waitListedCount.value === 0
            && registeredCount.value === 0;
    });

    /** Should the "all registrants wait-listed" notification be shown? */
    const showAllRegistrantsWaitListedNotification = computed<boolean>(() => {
        // Show if there are no spots remaining and all people were wait-listed (no one was registered).
        return registrationEntryState.successViewModel?.spotsRemaining === 0
            && waitListedCount.value > 0
            && registeredCount.value === 0;
    });

    /** Should the "some registrants wait-listed" notification be shown? */
    const showSomeRegistrantsWaitListedNotification = computed<boolean>(() => {
        // Show if there are no spots remaining and some people were wait-listed and registered.
        return registrationEntryState.successViewModel?.spotsRemaining === 0
            && waitListedCount.value > 0
            && registeredCount.value > 0;
    });

    const rawMessageHtml = computed<string>(() => {
        return registrationEntryState.successViewModel?.messageHtml || t("messageRegistrationDefaultSuccess", { registration: registrationEntryTerms.value.registrationSingularLowerCase });
    });

    /** The success lava markup */
    const messageHtml = computed<string>(() => {
        let html = rawMessageHtml.value;

        // Hide sensitive payment references (account mask / reference number)
        // in the final success message.
        html = html.replace(/\(\s*Acct\s*#:[^)]*?(?:Ref\s*#:[^)]*?)?\)/gi, "");

        if (!isSpanishUiLanguage()) {
            return html;
        }

        const replacements: Record<string, string> = {
            "Congratulations": "Felicidades",
            "You have successfully completed this": "Has completado exitosamente este",
            "Total Cost:": "Costo total:",
            "Balance Due:": "Saldo pendiente:",
            "A confirmation email has been sent to": "Se envio un correo de confirmacion a",
            "If you have any questions please contact": "Si tienes preguntas, por favor contacta a"
        };

        for (const sourceText of Object.keys(replacements)) {
            html = html.split(sourceText).join(replacements[sourceText]);
        }

        html = html
            .replace(/\bTe haz\b/gi, "Te has")
            .replace(/\bperson\b/gi, registrationEntryTerms.value.registrantSingularLowerCase)
            .replace(/\bpeople\b/gi, registrationEntryTerms.value.registrantPluralLowerCase)
            .replace(/\bregistration\b/gi, registrationEntryTerms.value.registrationSingularLowerCase)
            .replace(/\bregistrations\b/gi, registrationEntryTerms.value.registrationPluralLowerCase)
            .replace(/Pagado(?=[Q$])/g, "Pagado ");

        return html;
    });

    // #endregion
</script>

<style scoped>
.registrationentry-success {
    display: grid;
    gap: 14px;
}

.registrationentry-success-message {
    border: 1px solid #d2d6dc;
    border-radius: 16px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08);
    margin: 0;
    padding: 18px 20px;
    position: relative;
    overflow: hidden;
}

.registrationentry-success-message::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #1d4ed8 0%, #0ea5e9 45%, #22c55e 100%);
}

.registrationentry-success-message :deep(ul) {
    padding-left: 24px;
}

.registrationentry-success-message :deep(li) {
    margin-bottom: 6px;
}

.registrationentry-success-message :deep(*) {
    overflow-wrap: anywhere;
    word-break: break-word;
}

@media (max-width: 767px) {
    .registrationentry-success {
        gap: 10px;
    }

    .registrationentry-success-message {
        border-radius: 12px;
        padding: 14px 12px;
        box-shadow: 0 10px 18px rgba(15, 23, 42, 0.08);
    }

    .registrationentry-success-message :deep(ul) {
        padding-left: 18px;
    }
}
</style>
