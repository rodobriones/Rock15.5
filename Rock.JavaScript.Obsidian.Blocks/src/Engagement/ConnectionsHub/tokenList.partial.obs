<template>
    <div class="token-overflow-root">
        <div v-if="!expanded" ref="containerRef" class="token-row">
            <template v-for="(item, index) in visibleItems" :key="index">
                <slot name="item" :item="item" :index="index" />
            </template>

            <div v-if="showOverflowIndicator"
                 ref="overflowRef"
                 class="overflow-indicator">
                <Token>{{ items.length - visibleItems.length }} more</Token>
                <RockButton isSquare @click="expand">
                    <i class="ti ti-chevrons-down"></i>
                </RockButton>
            </div>
        </div>

        <div v-if="expanded" class="expanded-list">
            <template v-for="(item, index) in items" :key="index">
                <slot name="item" :item="item" :index="index" />
            </template>

            <RockButton isSquare @click="collapse">
                <i class="ti ti-chevrons-up"></i>
            </RockButton>
        </div>

        <div ref="measureRef" class="measure-row">
            <template v-for="(item, index) in items" :key="index">
                <slot name="item" :item="item" :index="index" />
            </template>
        </div>
    </div>
</template>

<style scoped>
.token-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--spacing-xsmall);
    overflow: hidden;
    white-space: nowrap;
}

.expanded-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xsmall);
    margin-top: var(--spacing-xsmall);
}

.overflow-indicator {
    /* Prevent the indicator from shrinking or growing so the width can be calculated correctly. */
    flex: 0 0 auto;
    display: inline-flex;
    white-space: nowrap;
    gap: var(--spacing-xsmall);
}

.measure-row {
    position: absolute;
    visibility: hidden;
    white-space: nowrap;
    height: 0;
    overflow: hidden;

    display: flex;
    flex-wrap: nowrap;
    gap: var(--spacing-xsmall);
}
</style>

<script setup lang="ts" generic="T">
    import { computed, nextTick, onMounted, onBeforeUnmount, ref, watch } from "vue";
    import Token from "./token.partial.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";

    const props = defineProps<{
        items: T[]
        expandable?: boolean
    }>();

    const expandable = props.expandable ?? true;

    const containerRef = ref<HTMLElement>();
    const measureRef = ref<HTMLElement>();
    const overflowRef = ref<HTMLElement>();

    const expanded = ref(false);
    const visibleCount = ref(props.items.length);

    let resizeObserver: ResizeObserver | undefined;

    async function calculateVisibleItems(): Promise<void> {
        if (expanded.value || !expandable) {
            visibleCount.value = props.items.length;
            return;
        }

        const container = containerRef.value;
        const measure = measureRef.value;
        if (!container || !measure) return;

        const children = Array.from(measure.children) as HTMLElement[];

        const fitCountForWidth = (width: number): number => {
            let used = 0;
            let count = 0;
            for (const child of children) {
                const w = child.offsetWidth;
                if (used + w > width) break;
                used += w;
                count++;
            }
            return count;
        };

        const containerWidth = container.clientWidth;

        // Pass 1: assume no overflow indicator, see how many fit
        const countWithoutIndicator = fitCountForWidth(containerWidth);

        // If everything fits, we are done
        if (countWithoutIndicator >= props.items.length) {
            visibleCount.value = props.items.length;
            return;
        }

        // Ensure the overflow indicator renders so we can measure its real width
        visibleCount.value = countWithoutIndicator;
        await nextTick();

        const indicatorWidth = overflowRef.value?.offsetWidth ?? 0;
        const effectiveWidth = Math.max(0, containerWidth - indicatorWidth);

        // Pass 2: compute final count with the indicator width subtracted
        visibleCount.value = fitCountForWidth(effectiveWidth);
    }


    const visibleItems = computed(() =>
        props.items.slice(0, visibleCount.value)
    );

    const hiddenCount = computed(() =>
        props.items.length - visibleItems.value.length
    );

    const showOverflowIndicator = computed(() =>
        expandable && !expanded.value && hiddenCount.value > 0
    );

    async function expand(): Promise<void> {
        expanded.value = true;
        await nextTick();
        await calculateVisibleItems();
    }

    async function collapse(): Promise<void> {
        expanded.value = false;
        await nextTick();
        await calculateVisibleItems();
    }

    watch(
        () => props.items,
        async () => {
            await nextTick();
            await calculateVisibleItems();
        },
        { deep: true }
    );

    onMounted(async () => {
        resizeObserver = new ResizeObserver(() => {
            calculateVisibleItems();
        });

        if (containerRef.value) {
            resizeObserver.observe(containerRef.value);
        }
        await nextTick();
        await calculateVisibleItems();
    });

    onBeforeUnmount(() => {
        resizeObserver?.disconnect();
    });
</script>
