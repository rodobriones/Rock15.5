<template>
    <div>
        <div v-if="options.caption" class="aeExistingBox">
            <p>{{ options.caption }}</p>
        </div>

        <slot name="captcha" />

        <div class="aeActions">
            <button
                class="aeSubmitBtn"
                :disabled="disabled"
                type="button"
                @click="onEmailUsernameClicked">
                Sí, envíamelo
            </button>
            <button
                class="aeSecondaryBtn"
                :disabled="disabled"
                type="button"
                @click="onSendToLoginClicked">
                No, quiero ingresar
            </button>
            <button
                class="aeLinkBtn"
                :disabled="disabled"
                type="button"
                @click="onPreviousClicked">
                Regresar
            </button>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { PropType } from "vue";
    import { AccountEntryExistingAccountStepBag } from "@Obsidian/ViewModels/Blocks/Security/AccountEntry/accountEntryExistingAccountStepBag";

    defineProps({
        disabled: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        },
        options: {
            type: Object as PropType<AccountEntryExistingAccountStepBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "movePrevious"): void,
        (e: "emailUsername"): void,
        (e: "sendToLogin"): void
    }>();

    //#region Event Handlers

    function onEmailUsernameClicked(): void {
        emit("emailUsername");
    }

    function onPreviousClicked(): void {
        emit("movePrevious");
    }

    function onSendToLoginClicked(): void {
        emit("sendToLogin");
    }

    //#endregion
</script>
