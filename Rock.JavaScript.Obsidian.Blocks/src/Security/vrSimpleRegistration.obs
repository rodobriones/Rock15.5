<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div v-if="!config.isBlocked" class="cyWrap">
        <div class="cyScreen">
            <!-- Overlay de carga -->
            <div v-if="isSubmitting" class="cyStateOverlay">
                <div class="cyStateModal">
                    <div class="cySpinner"></div>
                    <h4 class="cyStateTitle">Registrando</h4>
                    <p class="cyStateText">Por favor espera un momento...</p>
                </div>
            </div>

            <header class="cyTopBar">
                <div class="cyTopBrand">
                    <span class="cyTopName">Completa tu perfil</span>
                </div>
            </header>

            <section class="cyAmountHero" style="padding-bottom:48px;">
                <p class="cyAmountLabel" style="font-size:16px;">Solo necesitamos un par de datos más</p>
            </section>

            <div class="cyStage">
                <div v-if="errorMessage" class="cyMainCard" style="background:#fef3f2; border-color:#fecdc9;">
                    <p style="margin:0; color:#b42318; font-weight:600; font-size:14px;" v-html="errorMessage"></p>
                </div>

                <div class="cyMainCard" v-if="currentStep === 'form'">
                    <form @submit.prevent="onRegister">
                        <div class="cySection">
                            <div class="cySectionHead">
                                <h3 class="cySectionTitle">Datos personales</h3>
                            </div>

                            <div class="cyGrid">
                                <label class="cyField">
                                    <span>• Nombre</span>
                                    <input class="cyInput" type="text" required
                                           v-model.trim="firstName" :disabled="isSubmitting" autocomplete="given-name" />
                                </label>

                                <label class="cyField">
                                    <span>• Apellido</span>
                                    <input class="cyInput" type="text" required
                                           v-model.trim="lastName" :disabled="isSubmitting" autocomplete="family-name" />
                                </label>

                                <label class="cyField cyWide">
                                    <span>
                                        • Correo electrónico
                                        <span v-if="emailVerified" class="cyStatusBadge isGood" style="margin-left:6px;">Verificado</span>
                                    </span>
                                    <input class="cyInput" type="email"
                                           :required="!phoneVerified"
                                           :readonly="emailVerified"
                                           :style="emailVerified ? 'background:#f3f4f6; color:#6b7280; cursor:not-allowed;' : ''"
                                           v-model.trim="email"
                                           :disabled="isSubmitting" autocomplete="email" />
                                </label>

                                <label class="cyField">
                                    <span>• Género</span>
                                    <select class="cyInput" required v-model="gender" :disabled="isSubmitting">
                                        <option value="" disabled>Selecciona...</option>
                                        <option value="1">Masculino</option>
                                        <option value="2">Femenino</option>
                                    </select>
                                </label>

                                <label class="cyField">
                                    <span>
                                        Teléfono
                                        <span v-if="phoneVerified" class="cyStatusBadge isGood" style="margin-left:6px;">Verificado</span>
                                    </span>
                                    <div style="display:flex; gap:6px;">
                                        <select class="cyInput"
                                                style="flex:0 0 90px; padding-right:8px;"
                                                v-model="phoneCountryCode"
                                                :disabled="isSubmitting || phoneVerified"
                                                :style="phoneVerified ? 'flex:0 0 90px; padding-right:8px; background:#f3f4f6; color:#6b7280; cursor:not-allowed;' : 'flex:0 0 90px; padding-right:8px;'">
                                            <option v-for="code in config.countryCodes" :key="code" :value="code">
                                                {{ code }}
                                            </option>
                                        </select>
                                        <input class="cyInput" type="tel" placeholder="5555-1234"
                                               style="flex:1;"
                                               v-model.trim="phoneNumber"
                                               :readonly="phoneVerified"
                                               :style="phoneVerified ? 'flex:1; background:#f3f4f6; color:#6b7280; cursor:not-allowed;' : 'flex:1;'"
                                               :disabled="isSubmitting" />
                                    </div>
                                </label>

                                <label v-if="config.isCampusPickerShown && config.campuses && config.campuses.length"
                                       class="cyField cyWide">
                                    <span>Campus</span>
                                    <select class="cyInput" v-model="selectedCampusGuid" :disabled="isSubmitting">
                                        <option value="">Selecciona un campus...</option>
                                        <option v-for="c in config.campuses" :key="c.guid" :value="c.guid">
                                            {{ c.name }}
                                        </option>
                                    </select>
                                </label>
                            </div>
                        </div>

                        <div class="cyActions">
                            <button class="btn btn-primary" type="submit" :disabled="isSubmitting">
                                <span v-if="isSubmitting">Registrando...</span>
                                <span v-else>Continuar</span>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="cyMainCard" v-else-if="currentStep === 'conflict'">
                    <div class="cySection">
                        <h3 class="cySectionTitle">Cuenta existente</h3>
                        <p class="cySectionText">Ya existe una cuenta con esta información. Por favor inicia sesión.</p>
                    </div>
                    <div class="cyActions">
                        <a class="btn btn-primary" :href="config.loginPageUrl || '/Login'"
                           style="text-decoration:none;">
                            Ir a inicio de sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import { useConfigurationValues, useInvokeBlockAction, onConfigurationValuesChanged, useReloadBlock } from "@Obsidian/Utility/block";

    interface VRCampusItem {
        name: string;
        guid: string;
    }

    interface VRSimpleRegistrationInitBox {
        isBlocked?: boolean;
        email?: string | null;
        phoneNumber?: string | null;
        phoneCountryCode?: string | null;
        countryCodes: string[];
        defaultCountryCode?: string | null;
        state?: string | null;
        isCampusPickerShown: boolean;
        campuses: VRCampusItem[];
        loginPageUrl?: string | null;
        returnUrl?: string | null;
    }

    interface VRRegisterResponseBag {
        isSuccess: boolean;
        redirectUrl?: string | null;
        errorMessage?: string | null;
    }

    const config = useConfigurationValues<VRSimpleRegistrationInitBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // If the passwordless session is invalid or already used, redirect to login immediately.
    if (config.isBlocked) {
        window.location.replace(config.loginPageUrl || "/Login");
    }

    const emailVerified = computed(() => !!config.email);
    const phoneVerified = computed(() => !!config.phoneNumber);

    type Step = "form" | "conflict";
    const currentStep = ref<Step>("form");
    const isSubmitting = ref(false);
    const errorMessage = ref<string | null>(null);

    const firstName = ref("");
    const lastName = ref("");
    const email = ref(config.email ?? "");
    const gender = ref("");
    const phoneNumber = ref(config.phoneNumber ?? "");
    const phoneCountryCode = ref(config.phoneCountryCode ?? config.defaultCountryCode ?? "502");
    const selectedCampusGuid = ref("");

    async function onRegister(): Promise<void> {
        errorMessage.value = null;
        isSubmitting.value = true;
        try {
            const result = await invokeBlockAction<VRRegisterResponseBag>("Register", {
                bag: {
                    firstName: firstName.value,
                    lastName: lastName.value,
                    email: email.value,
                    gender: parseInt(gender.value, 10) || 0,
                    phoneNumber: phoneNumber.value,
                    phoneCountryCode: phoneCountryCode.value,
                    campusGuid: selectedCampusGuid.value || null,
                    state: config.state,
                    returnUrl: config.returnUrl
                }
            });

            if (!result?.isSuccess || !result.data) {
                errorMessage.value = result?.errorMessage ?? "Ocurrió un error inesperado.";
                return;
            }

            if (result.data.redirectUrl) {
                window.location.replace(result.data.redirectUrl);
            }
        }
        catch {
            errorMessage.value = "Ocurrió un error inesperado. Intenta de nuevo.";
        }
        finally {
            isSubmitting.value = false;
        }
    }

    onConfigurationValuesChanged(useReloadBlock());
</script>

