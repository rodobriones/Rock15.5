/* Estilos del flujo de recibo fiscal (NIT) */
.cyReceiptSection {
    background: #fafafa; /* Fondo ligeramente distinto para diferenciar la sección */
}

.cyReceiptToggle {
    display: flex;
    justify-content: space-between;
