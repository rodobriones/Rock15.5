<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div v-if="!config.isBlocked" class="vrRegScreen">
        <header class="vrRegHeader">
            <p class="vrRegEyebrow">Crear cuenta</p>
            <h1 class="vrRegTitle">Completa tu perfil</h1>
            <p class="vrRegSubtitle">Solo necesitamos un par de datos más para terminar.</p>
        </header>

        <section class="vrRegCard">
            <div class="vrRegCardBody">
                <div v-if="errorMessage" class="vrRegAlert">
                    <span v-html="errorMessage"></span>
                </div>

                <form v-if="currentStep === 'form'" @submit.prevent="onRegister">
                    <div class="vrRegFields">
                        <label class="vrRegField">
                            <span class="vrRegLabel">Nombre</span>
                            <input class="vrRegInput" type="text" required maxlength="50"
                                   v-model.trim="firstName" :disabled="isSubmitting" autocomplete="given-name" />
                        </label>

                        <label class="vrRegField">
                            <span class="vrRegLabel">Apellido</span>
                            <input class="vrRegInput" type="text" required maxlength="50"
                                   v-model.trim="lastName" :disabled="isSubmitting" autocomplete="family-name" />
                        </label>

                        <label class="vrRegField">
                            <span class="vrRegLabel">
                                Correo electrónico
                                <span v-if="emailVerified" class="vrRegBadge">Verificado</span>
                            </span>
                            <input class="vrRegInput" type="email"
                                   :class="{ isLocked: emailVerified }"
                                   :required="!phoneVerified"
                                   :readonly="emailVerified"
                                   v-model.trim="email"
                                   :disabled="isSubmitting"
                                   placeholder="correo@ejemplo.com"
                                   autocomplete="email" />
                        </label>

                        <label class="vrRegField">
                            <span class="vrRegLabel">Género</span>
                            <select class="vrRegInput vrRegSelect" required v-model="gender" :disabled="isSubmitting">
                                <option value="" disabled>Selecciona...</option>
                                <option value="1">Masculino</option>
                                <option value="2">Femenino</option>
                            </select>
                        </label>

                        <label class="vrRegField">
                            <span class="vrRegLabel">
                                Teléfono
                                <span v-if="phoneVerified" class="vrRegBadge">Verificado</span>
                            </span>
                            <div class="vrRegFieldRow">
                                <select class="vrRegCountrySelect"
                                        v-model="phoneCountryCode"
                                        :disabled="isSubmitting || phoneVerified">
                                    <option v-for="code in config.countryCodes" :key="code" :value="code">
                                        {{ code }}
                                    </option>
                                </select>
                                <input class="vrRegInput vrRegInputRight" type="tel" placeholder="55555555"
                                       :class="{ isLocked: phoneVerified }"
                                       v-model.trim="phoneNumber"
                                       :readonly="phoneVerified"
                                       :disabled="isSubmitting"
                                       autocomplete="tel-national" />
                            </div>
                        </label>

                        <label v-if="config.isCampusPickerShown && config.campuses && config.campuses.length"
                               class="vrRegField">
                            <span class="vrRegLabel">Campus</span>
                            <select class="vrRegInput vrRegSelect" v-model="selectedCampusGuid" :disabled="isSubmitting">
                                <option value="">Selecciona un campus...</option>
                                <option v-for="c in config.campuses" :key="c.guid" :value="c.guid">
                                    {{ c.name }}
                                </option>
                            </select>
                        </label>
                    </div>

                    <button class="vrRegBtn vrRegBtnDark" type="submit" :disabled="isSubmitting">
                        {{ isSubmitting ? "Registrando..." : "Continuar" }}
                    </button>

                    <p class="vrRegHelper">Con esto completas tu acceso a VidaReal.tv</p>
                </form>

                <div v-else-if="currentStep === 'conflict'" class="vrRegConflict">
                    <h2 class="vrRegCardTitle">Cuenta existente</h2>
                    <p class="vrRegCardSubtitle">
                        Ya existe una cuenta con esta información. Por favor inicia sesión.
                    </p>
                    <a class="vrRegBtn vrRegBtnDark" :href="config.loginPageUrl || '/Login'">
                        Ir a inicio de sesión
                    </a>
                </div>
            </div>
        </section>
    </div>

    <!-- Overlay de carga -->
    <div v-if="isSubmitting" class="vrRegOverlay">
        <div class="vrRegOverlayModal">
            <div class="vrRegSpinner"></div>
            <h2 class="vrRegOverlayTitle">Registrando</h2>
            <p class="vrRegOverlayText">Por favor espera un momento...</p>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { computed, ref } from "vue";
    import { useConfigurationValues, useInvokeBlockAction, onConfigurationValuesChanged, useReloadBlock } from "@Obsidian/Utility/block";

    interface VRCampusItem {
        name: string;
        guid: string;
    }

    interface VRSimpleRegistrationInitBox {
        isBlocked?: boolean;
        email?: string | null;
        phoneNumber?: string | null;
        phoneCountryCode?: string | null;
        countryCodes: string[];
        defaultCountryCode?: string | null;
        state?: string | null;
        isCampusPickerShown: boolean;
        campuses: VRCampusItem[];
        loginPageUrl?: string | null;
        returnUrl?: string | null;
    }

    interface VRRegisterResponseBag {
        isSuccess: boolean;
        isExistingAccount?: boolean;
        redirectUrl?: string | null;
        errorMessage?: string | null;
    }

    const config = useConfigurationValues<VRSimpleRegistrationInitBox>();
    const invokeBlockAction = useInvokeBlockAction();

    // If the passwordless session is invalid or already used, redirect to login immediately.
    if (config.isBlocked) {
        window.location.replace(config.loginPageUrl || "/Login");
    }

    const emailVerified = computed(() => !!config.email);
    const phoneVerified = computed(() => !!config.phoneNumber);

    type Step = "form" | "conflict";
    const currentStep = ref<Step>("form");
    const isSubmitting = ref(false);
    const errorMessage = ref<string | null>(null);

    const firstName = ref("");
    const lastName = ref("");
    const email = ref(config.email ?? "");
    const gender = ref("");
    const phoneNumber = ref(config.phoneNumber ?? "");
    const phoneCountryCode = ref(config.phoneCountryCode ?? config.defaultCountryCode ?? "502");
    const selectedCampusGuid = ref("");

    async function onRegister(): Promise<void> {
        errorMessage.value = null;
        isSubmitting.value = true;
        try {
            const result = await invokeBlockAction<VRRegisterResponseBag>("Register", {
                bag: {
                    firstName: firstName.value,
                    lastName: lastName.value,
                    email: email.value,
                    gender: parseInt(gender.value, 10) || 0,
                    phoneNumber: phoneNumber.value,
                    phoneCountryCode: phoneCountryCode.value,
                    campusGuid: selectedCampusGuid.value || null,
                    state: config.state,
                    returnUrl: config.returnUrl
                }
            });

            if (!result?.isSuccess || !result.data) {
                errorMessage.value = result?.errorMessage ?? "Ocurrió un error inesperado.";
                return;
            }

            if (result.data.isExistingAccount) {
                currentStep.value = "conflict";
                return;
            }

            if (!result.data.isSuccess) {
                errorMessage.value = result.data.errorMessage ?? "Ocurrió un error inesperado.";
                return;
            }

            if (result.data.redirectUrl) {
                window.location.replace(result.data.redirectUrl);
            }
        }
        catch {
            errorMessage.value = "Ocurrió un error inesperado. Intenta de nuevo.";
        }
        finally {
            isSubmitting.value = false;
        }
    }

    onConfigurationValuesChanged(useReloadBlock());
</script>

<style>
/* Oculta el marco del panel de Rock: esta pantalla es de pantalla completa. */
.panel-block .panel-heading,
.panel-block .panel-header {
    display: none !important;
}

.panel-block {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

.panel-block > .panel-body {
    padding: 0 !important;
}

/* ── Variables y contenedor ────────────────────────────────── */
.vrRegScreen {
    --vr-surface: #ffffff;
    --vr-dark: #272b31;
    --vr-text-secondary: #767676;
    --vr-text-muted: #71727a;
    --vr-gray: #8e8e93;
    --vr-gray-2: #aeaeb2;
    --vr-gray-5: #e5e5ea;
    --vr-border: #c5c6cc;
    --vr-accent: #006ffd;
    --vr-danger: #b42318;
    --vr-radius-lg: 12px;
    --vr-radius-xl: 16px;
    --vr-font-heading: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --vr-font-body: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;

    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    padding: 8px 0 32px;
    font-family: var(--vr-font-body);
    color: var(--vr-dark);
    animation: vrRegRise 0.3s ease-out both;
}

.vrRegScreen * {
    box-sizing: border-box;
}

/* ── Encabezado ────────────────────────────────────────────── */
.vrRegHeader {
    margin-bottom: 24px;
}

.vrRegEyebrow {
    margin: 0 0 4px;
    font-family: var(--vr-font-heading);
    font-weight: 300;
    font-size: 20px;
    line-height: 1.2;
    color: var(--vr-text-secondary);
}

.vrRegTitle {
    margin: 0 0 12px;
    font-family: var(--vr-font-heading);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: #000;
}

.vrRegSubtitle {
    margin: 0;
    font-family: var(--vr-font-heading);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    color: var(--vr-text-secondary);
    max-width: 360px;
}

/* ── Tarjeta ───────────────────────────────────────────────── */
.vrRegCard {
    background: var(--vr-surface);
    border-radius: var(--vr-radius-lg);
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.15);
    overflow: hidden;
}

.vrRegCardBody {
    padding: 30px 24px 26px;
}

.vrRegCardTitle {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: #1f2024;
    text-align: center;
}

.vrRegCardSubtitle {
    margin: 0 0 24px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--vr-text-muted);
    text-align: center;
}

/* ── Campos ────────────────────────────────────────────────── */
.vrRegFields {
    display: grid;
    gap: 18px;
    margin-bottom: 24px;
}

.vrRegField {
    display: grid;
    gap: 7px;
    margin: 0;
    font-weight: 400;
}

.vrRegLabel {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #1f2024;
}

.vrRegBadge {
    border-radius: 999px;
    background: rgba(0, 111, 253, 0.1);
    color: var(--vr-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
}

.vrRegFieldRow {
    display: flex;
    align-items: stretch;
}

.vrRegInput {
    width: 100%;
    height: 48px;
    border: 1px solid var(--vr-border);
    border-radius: var(--vr-radius-lg);
    background: var(--vr-surface);
    color: var(--vr-dark);
    font-family: var(--vr-font-body);
    font-size: 14px;
    padding: 0 16px;
    box-shadow: none;
    -webkit-appearance: none;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.vrRegInput::placeholder {
    color: #8f9098;
}

.vrRegInput:focus,
.vrRegCountrySelect:focus {
    border-color: var(--vr-accent);
    box-shadow: 0 0 0 2px rgba(0, 111, 253, 0.15);
}

.vrRegInput.isLocked,
.vrRegInput:disabled,
.vrRegCountrySelect:disabled {
    background: #f3f3f3;
    color: var(--vr-gray);
    cursor: not-allowed;
}

.vrRegInputRight {
    flex: 1 1 auto;
    min-width: 0;
    width: auto;
    border-radius: 0 var(--vr-radius-lg) var(--vr-radius-lg) 0;
    border-left: 0;
}

.vrRegSelect,
.vrRegCountrySelect {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    cursor: pointer;
    background-repeat: no-repeat;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%238e8e93' d='M6 8L0 0h12z'/></svg>");
}

.vrRegSelect {
    padding-right: 38px;
    background-position: right 16px center;
    background-size: 10px 7px;
}

.vrRegCountrySelect {
    flex: 0 0 78px;
    width: 78px;
    height: 48px;
    border: 0.5px solid var(--vr-gray-2);
    border-right: 0;
    border-radius: var(--vr-radius-lg) 0 0 var(--vr-radius-lg);
    background-color: var(--vr-gray-5);
    color: var(--vr-gray);
    font-family: var(--vr-font-body);
    font-size: 14px;
    padding: 0 22px 0 10px;
    outline: none;
    background-position: right 8px center;
    background-size: 9px 6px;
}

/* Evita el zoom automático de iOS sin perder la escala del diseño. */
@media (max-width: 991px) {
    .rock-blank input.vrRegInput:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
    .vrRegInput,
    .vrRegCountrySelect {
        font-size: 16px !important;
    }
}

/* ── Botones ───────────────────────────────────────────────── */
.vrRegBtn {
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: var(--vr-radius-lg);
    font-family: var(--vr-font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
}

.vrRegBtnDark,
.vrRegBtnDark:hover,
.vrRegBtnDark:focus {
    background: var(--vr-dark);
    color: #fff;
    text-decoration: none;
}

.vrRegBtnDark:hover:not(:disabled) {
    opacity: 0.9;
}

.vrRegBtnDark:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.vrRegHelper {
    margin: 16px 0 0;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--vr-text-muted);
}

/* ── Alerta de error ───────────────────────────────────────── */
.vrRegAlert {
    background: #fef3f2;
    border: 1px solid #fecdc9;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 20px;
}

.vrRegAlert span {
    color: var(--vr-danger);
    font-size: 13px;
    font-weight: 600;
}

/* ── Paso de cuenta existente ──────────────────────────────── */
.vrRegConflict {
    display: flex;
    flex-direction: column;
}

/* ── Overlay de carga ──────────────────────────────────────── */
.vrRegOverlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(31, 32, 36, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    animation: vrRegFade 0.2s ease;
}

.vrRegOverlayModal {
    width: 100%;
    max-width: 320px;
    background: #fff;
    border-radius: 16px;
    padding: 32px 20px;
    text-align: center;
    font-family: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
}

.vrRegOverlayTitle {
    margin: 20px 0 8px;
    font-size: 18px;
    font-weight: 700;
    color: #1f2024;
}

.vrRegOverlayText {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    color: #71727a;
}

.vrRegSpinner {
    width: 52px;
    height: 52px;
    margin: 0 auto;
    border: 4px solid #e5e5ea;
    border-top-color: #272b31;
    border-radius: 50%;
    animation: vrRegSpin 0.9s linear infinite;
}

/* ── Animaciones ───────────────────────────────────────────── */
@keyframes vrRegRise {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes vrRegFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes vrRegSpin {
    to { transform: rotate(360deg); }
}

/* ── Responsive móvil ──────────────────────────────────────── */
@media (max-width: 575px) {
    .vrRegTitle {
        font-size: 34px;
    }

    .vrRegEyebrow {
        font-size: 16px;
    }

    .vrRegSubtitle {
        font-size: 14px;
    }

    .vrRegCardBody {
        padding: 26px 20px 22px;
    }
}
</style>
