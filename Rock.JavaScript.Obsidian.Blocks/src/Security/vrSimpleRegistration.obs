@keyframes cyFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes cyScaleUp {
    from { opacity: 0; transform: translateY(16px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes cySpin {
    to { transform: rotate(360deg); }
}

