<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <div class="plScreen">
        <header class="plHeader">
            <p class="plEyebrow">Login</p>
            <h1 class="plTitle">Bienvenido</h1>
            <p class="plSubtitle">Ingresa con tu correo electrónico o número de teléfono registrado.</p>
        </header>

        <section class="plCard">
            <div class="plTabs" role="tablist" aria-label="Método de ingreso">
                <button
                    type="button"
                    role="tab"
                    class="plTab"
                    :class="{ isActive: selectedMethod === 'phone' }"
                    :aria-selected="selectedMethod === 'phone'"
                    :disabled="disabled"
                    @click="onSelectMethod('phone')">
                    Número de teléfono
                </button>
                <button
                    type="button"
                    role="tab"
                    class="plTab"
                    :class="{ isActive: selectedMethod === 'email' }"
                    :aria-selected="selectedMethod === 'email'"
                    :disabled="disabled"
                    @click="onSelectMethod('email')">
                    Correo electrónico
                </button>
            </div>

            <div class="plCardBody">
                <RockForm @submit="onPasswordlessLoginStartSubmitted">
                    <div v-if="validationErrors.length" class="plAlert">
                        <span v-for="err in validationErrors" :key="err.text">{{ err.text }}</span>
                    </div>

                    <div class="plFieldRow">
                        <template v-if="selectedMethod === 'phone'">
                            <label class="plSrOnly" for="pl-country-code">Código de país</label>
                            <select
                                id="pl-country-code"
                                v-model="selectedCountryCode"
                                class="plCountrySelect"
                                :disabled="disabled">
                                <option v-for="cc in countryCodes" :key="cc" :value="cc">{{ cc }}</option>
                            </select>
                            <label class="plSrOnly" for="pl-phone-number">Número de teléfono</label>
                            <input
                                id="pl-phone-number"
                                v-model="emailOrPhoneNumber"
                                class="plInput plInputRight"
                                :disabled="disabled"
                                inputmode="tel"
                                type="tel"
                                placeholder="55555555"
                                autocomplete="tel-national" />
                        </template>
                        <template v-else>
                            <label class="plSrOnly" for="pl-email-address">Correo electrónico</label>
                            <input
                                id="pl-email-address"
                                v-model="emailOrPhoneNumber"
                                class="plInput"
                                :disabled="disabled"
                                inputmode="email"
                                type="email"
                                placeholder="correo@ejemplo.com"
                                autocomplete="email" />
                        </template>
                    </div>

                    <button
                        class="plBtn plBtnDark"
                        :disabled="disabled || !isInputComplete"
                        type="submit">
                        Continuar
                    </button>

                    <p class="plHelper">
                        Te enviamos un código a tu {{ selectedMethod === 'phone' ? 'número' : 'correo' }}
                    </p>
                </RockForm>
            </div>
        </section>
    </div>
</template>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import { isEmail } from "@Obsidian/Utility/email";
    import { FormError } from "@Obsidian/Utility/form";
    import { formatPhoneNumber, getPhoneNumberConfiguration, stripPhoneNumber } from "@Obsidian/Utility/phone";
    import { validateValue } from "@Obsidian/ValidationRules";
    import { PasswordlessLoginStartRequestBag } from "@Obsidian/ViewModels/Blocks/Security/Login/passwordlessLoginStartRequestBag";
    import { PhoneNumberBoxGetConfigurationResultsBag } from "@Obsidian/ViewModels/Rest/Controls/phoneNumberBoxGetConfigurationResultsBag";
    import { PhoneNumberCountryCodeRulesConfigurationBag } from "@Obsidian/ViewModels/Rest/Controls/phoneNumberCountryCodeRulesConfigurationBag";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<PasswordlessLoginStartRequestBag>,
            required: true
        },
        disabled: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        },
        isMobileForced: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "start"): void,
        (e: "update:modelValue", _value: PasswordlessLoginStartRequestBag): void
    }>();

    //#region Values

    const validationErrors = ref<FormError[]>([]);
    const phoneNumberConfig = ref<PhoneNumberBoxGetConfigurationResultsBag>();
    const emailOrPhoneNumberRaw = ref<string>("");
    // El diseño abre en la pestaña de teléfono (canal principal en Guatemala).
    const selectedMethod = ref<"email" | "phone">("phone");
    const countryCodes = ["+502", "+503", "+1"];
    const selectedCountryCode = ref<string>("+502");

    //#endregion

    //#region Computed Values

    const label = computed<string>(() => selectedMethod.value === "email" ? "Correo electrónico" : "Número de teléfono");

    const emailOrPhoneNumber = computed<string>({
        get() {
            return emailOrPhoneNumberRaw.value;
        },
        set(newValue: string) {
            emailOrPhoneNumberRaw.value = newValue;
            validateEmailOrPhoneNumber(newValue);
        }
    });

    /**
     * Chequeo permisivo solo para habilitar el botón "Continuar". La validación
     * real (reglas de Rock por país) sigue corriendo en el submit.
     */
    const isInputComplete = computed<boolean>(() => {
        const value = emailOrPhoneNumberRaw.value;
        if (!value) {
            return false;
        }

        if (selectedMethod.value === "email") {
            return isEmail(value);
        }

        return stripPhoneNumber(value).length >= 7;
    });

    //#endregion

    //#region Event Handlers

    function onSelectMethod(method: "email" | "phone"): void {
        if (selectedMethod.value === method) return;
        selectedMethod.value = method;
        emailOrPhoneNumberRaw.value = "";
        validationErrors.value = [];
        emit("update:modelValue", {
            ...props.modelValue,
            email: null,
            phoneNumber: null,
            shouldSendEmailCode: false,
            shouldSendEmailLink: false,
            shouldSendSmsCode: false
        });
    }

    function onPasswordlessLoginStartSubmitted(): void {
        validateForm();

        if (validationErrors.value.length === 0) {
            emit("start");
        }
    }

    //#endregion

    //#region Functions

    function getConfiguredRules(): PhoneNumberCountryCodeRulesConfigurationBag[] {
        const rules = phoneNumberConfig.value?.rules;
        if (!rules) return [];

        // Only apply rules for the country the user actually selected.
        const selectedKey = selectedCountryCode.value.replace(/^\+/, "");
        const bag = rules[selectedKey];
        return bag ? [...bag] : [];
    }

    async function loadPhoneNumberConfig(): Promise<void> {
        phoneNumberConfig.value = await getPhoneNumberConfiguration();
    }

    function validateForm(): void {
        const errorMessages = validateValue(emailOrPhoneNumber.value, validateEmailOrPhoneNumber);

        if (errorMessages && errorMessages.length) {
            validationErrors.value = errorMessages.map(
                errorMessage => ({
                    name: label.value,
                    text: errorMessage
                })
            );
        }
        else {
            validationErrors.value = [];
        }
    }

    function validateEmailOrPhoneNumber(value: unknown): string | boolean {
        if (!value) {
            return true;
        }

        if (selectedMethod.value === "email") {
            const errors = validateEmail(value);
            if (errors === "") {
                emit("update:modelValue", {
                    ...props.modelValue,
                    email: value as string,
                    phoneNumber: null,
                    shouldSendEmailCode: true,
                    shouldSendEmailLink: true,
                    shouldSendSmsCode: false
                });
                return true;
            }
            emit("update:modelValue", {
                ...props.modelValue,
                email: null,
                phoneNumber: null,
                shouldSendEmailCode: false,
                shouldSendEmailLink: false,
                shouldSendSmsCode: false
            });
            return "Ingresa un correo electrónico válido";
        }

        const stripped = stripPhoneNumber(value as string);
        const formattedNumber = formatPhoneNumber(stripped);
        if (formattedNumber) {
            const errors = validatePhoneNumber(stripped);
            if (errors === "") {
                emailOrPhoneNumberRaw.value = formattedNumber;

                // Always send "+<code><digits>" so providers (Twilio / WhatsApp Cloud)
                // route correctly. The backend matches existing people with or without
                // country code, so legacy records still resolve.
                const phoneToSend = selectedCountryCode.value + stripped;

                emit("update:modelValue", {
                    ...props.modelValue,
                    email: null,
                    phoneNumber: phoneToSend,
                    shouldSendEmailCode: false,
                    shouldSendEmailLink: false,
                    shouldSendSmsCode: true
                });
                return true;
            }
        }

        emit("update:modelValue", {
            ...props.modelValue,
            email: null,
            phoneNumber: null,
            shouldSendEmailCode: false,
            shouldSendEmailLink: false,
            shouldSendSmsCode: false
        });
        return "Ingresa un número de teléfono válido";
    }

    function validateEmail(value: unknown): string {
        if (!value) return "";
        if (isEmail(value)) return "";
        return "Ingresa un correo electrónico válido.";
    }

    function validatePhoneNumber(value: string): string {
        if (!value) return "";

        const rules = getConfiguredRules();

        // If Rock has a rule for the selected country, honor it.
        if (rules.length > 0) {
            for (const rule of rules) {
                const regex = new RegExp(rule.match ?? "");
                if (regex.test(value)) return "";
            }
            return `El número '${value}' no es un número de teléfono válido.`;
        }

        // No rule for the selected country — fall back to a generic E.164 length check.
        if (value.length >= 7 && value.length <= 15) return "";
        return `El número '${value}' no es un número de teléfono válido.`;
    }

    //#endregion

    watch(selectedCountryCode, () => {
        if (selectedMethod.value === "phone" && emailOrPhoneNumberRaw.value) {
            validateEmailOrPhoneNumber(emailOrPhoneNumberRaw.value);
        }
    });

    loadPhoneNumberConfig();
</script>

<style>
/* ── Variables y contenedor ────────────────────────────────── */
.plScreen {
    --pl-surface: #ffffff;
    --pl-dark: #272b31;
    --pl-text-secondary: #767676;
    --pl-text-muted: #71727a;
    --pl-gray: #8e8e93;
    --pl-gray-2: #aeaeb2;
    --pl-gray-5: #e5e5ea;
    --pl-border: #c5c6cc;
    --pl-accent: #006ffd;
    --pl-danger: #b42318;
    --pl-radius-lg: 12px;
    --pl-radius-xl: 16px;
    --pl-font-heading: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --pl-font-body: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;

    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    font-family: var(--pl-font-body);
    color: var(--pl-dark);
    animation: plRise 0.3s ease-out both;
}

.plScreen * {
    box-sizing: border-box;
}

/* ── Encabezado ────────────────────────────────────────────── */
.plScreen .plHeader {
    margin-bottom: 24px;
}

.plScreen .plEyebrow {
    margin: 0 0 4px;
    font-family: var(--pl-font-heading);
    font-weight: 300;
    font-size: 20px;
    line-height: 1.2;
    color: var(--pl-text-secondary);
}

.plScreen .plTitle {
    margin: 0 0 12px;
    font-family: var(--pl-font-heading);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: #000;
}

.plScreen .plSubtitle {
    margin: 0;
    font-family: var(--pl-font-heading);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    color: var(--pl-text-secondary);
    max-width: 360px;
}

/* ── Tarjeta ───────────────────────────────────────────────── */
.plScreen .plCard {
    background: var(--pl-surface);
    border-radius: var(--pl-radius-lg);
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.15);
    overflow: hidden;
}

.plScreen .plCardBody {
    padding: 30px 24px 26px;
}

/* ── Pestañas ──────────────────────────────────────────────── */
.plScreen .plTabs {
    display: flex;
}

.plScreen .plTab {
    flex: 1;
    border: 0;
    background: var(--pl-gray-5);
    color: var(--pl-gray);
    font-family: var(--pl-font-body);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    padding: 14px 8px;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
}

.plScreen .plTab.isActive {
    background: var(--pl-surface);
    color: var(--pl-dark);
}

.plScreen .plTab:disabled {
    cursor: not-allowed;
}

/* ── Campos ────────────────────────────────────────────────── */
.plScreen .plFieldRow {
    display: flex;
    align-items: stretch;
    margin-bottom: 24px;
}

.plScreen .plInput {
    flex: 1 1 auto;
    min-width: 0;
    height: 48px;
    border: 1px solid var(--pl-border);
    border-radius: var(--pl-radius-lg);
    background: var(--pl-surface);
    color: var(--pl-dark);
    font-family: var(--pl-font-body);
    font-size: 14px;
    padding: 0 16px;
    box-shadow: none;
    -webkit-appearance: none;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.plScreen .plInputRight {
    border-radius: 0 var(--pl-radius-lg) var(--pl-radius-lg) 0;
    border-left: 0;
}

.plScreen .plInput::placeholder {
    color: #8f9098;
}

.plScreen .plInput:focus,
.plScreen .plCountrySelect:focus {
    border-color: var(--pl-accent);
    box-shadow: 0 0 0 2px rgba(0, 111, 253, 0.15);
}

.plScreen .plInput:disabled,
.plScreen .plCountrySelect:disabled {
    background: #f3f3f3;
    color: var(--pl-gray);
    cursor: not-allowed;
}

.plScreen .plCountrySelect {
    flex: 0 0 78px;
    width: 78px;
    height: 48px;
    border: 0.5px solid var(--pl-gray-2);
    border-right: 0;
    border-radius: var(--pl-radius-lg) 0 0 var(--pl-radius-lg);
    background: var(--pl-gray-5);
    color: var(--pl-gray);
    font-family: var(--pl-font-body);
    font-size: 14px;
    padding: 0 22px 0 10px;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    outline: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%238e8e93' d='M6 8L0 0h12z'/></svg>");
    background-repeat: no-repeat;
    background-position: right 8px center;
    background-size: 9px 6px;
}

/* Evita el zoom automático de iOS sin perder la escala del diseño. */
@media (max-width: 991px) {
    .rock-blank input.plInput:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
    .plScreen .plInput,
    .plScreen .plCountrySelect {
        font-size: 16px !important;
    }
}

/* ── Botones ───────────────────────────────────────────────── */
.plScreen .plBtn {
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: var(--pl-radius-lg);
    font-family: var(--pl-font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, background 0.2s ease;
}

.plScreen .plBtnDark {
    background: var(--pl-dark);
    color: #fff;
}

.plScreen .plBtnDark:hover:not(:disabled) {
    opacity: 0.9;
}

.plScreen .plBtnDark:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.plScreen .plHelper {
    margin: 16px 0 0;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--pl-text-muted);
}

/* ── Alerta de error ───────────────────────────────────────── */
.plScreen .plAlert {
    background: #fef3f2;
    border: 1px solid #fecdc9;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 16px;
    display: grid;
    gap: 4px;
}

.plScreen .plAlert span {
    color: var(--pl-danger);
    font-size: 13px;
    font-weight: 600;
}

/* ── Utilidades ────────────────────────────────────────────── */
.plScreen .plSrOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

@keyframes plRise {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ── Responsive móvil ──────────────────────────────────────── */
@media (max-width: 575px) {
    .plScreen .plTitle {
        font-size: 36px;
    }

    .plScreen .plEyebrow {
        font-size: 16px;
    }

    .plScreen .plSubtitle {
        font-size: 14px;
    }

    .plScreen .plCardBody {
        padding: 26px 20px 22px;
    }
}
</style>
