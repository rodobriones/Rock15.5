<template>
    <div class="plWrap">
        <div v-if="validationErrors.length" class="plAlert">
            <span v-for="err in validationErrors" :key="err.text">{{ err.text }}</span>
        </div>

        <RockForm @submit="onPasswordlessLoginStartSubmitted">
            <div class="plMethodSwitch" role="group" :aria-label="'Ingresar con ' + (selectedMethod === 'email' ? 'Email' : 'Teléfono')">
                <button
                    type="button"
                    class="plMethodBtn"
                    :class="{ isActive: selectedMethod === 'email' }"
                    @click="onSelectMethod('email')">
                    Email
                </button>
                <button
                    type="button"
                    class="plMethodBtn"
                    :class="{ isActive: selectedMethod === 'phone' }"
                    @click="onSelectMethod('phone')">
                    Teléfono
                </button>
            </div>

            <div class="plField">
                <span>{{ label }}</span>
                <div v-if="selectedMethod === 'phone'" class="plPhoneRow">
                    <select
                        v-model="selectedCountryCode"
                        class="plInput plCountrySelect"
                        :disabled="disabled"
                        aria-label="Código de país">
                        <option v-for="cc in countryCodes" :key="cc" :value="cc">{{ cc }}</option>
                    </select>
                    <input
                        v-model="emailOrPhoneNumber"
                        class="plInput plPhoneInput"
                        :disabled="disabled"
                        inputmode="tel"
                        type="tel"
                        placeholder="0000-0000"
                        autocomplete="off" />
                </div>
                <input
                    v-else
                    v-model="emailOrPhoneNumber"
                    class="plInput"
                    :disabled="disabled"
                    inputmode="email"
                    type="email"
                    placeholder="correo@ejemplo.com"
                    autocomplete="off" />
            </div>

            <div class="plActions">
                <button
                    class="plSubmitBtn"
                    :disabled="disabled"
                    type="submit">
                    Continuar
                </button>
            </div>
        </RockForm>
    </div>
</template>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import { isEmail } from "@Obsidian/Utility/email";
    import { FormError } from "@Obsidian/Utility/form";
    import { formatPhoneNumber, getPhoneNumberConfiguration, stripPhoneNumber } from "@Obsidian/Utility/phone";
    import { validateValue } from "@Obsidian/ValidationRules";
    import { PasswordlessLoginStartRequestBag } from "@Obsidian/ViewModels/Blocks/Security/Login/passwordlessLoginStartRequestBag";
    import { PhoneNumberBoxGetConfigurationResultsBag } from "@Obsidian/ViewModels/Rest/Controls/phoneNumberBoxGetConfigurationResultsBag";
    import { PhoneNumberCountryCodeRulesConfigurationBag } from "@Obsidian/ViewModels/Rest/Controls/phoneNumberCountryCodeRulesConfigurationBag";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<PasswordlessLoginStartRequestBag>,
            required: true
        },
        disabled: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        },
        isMobileForced: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "start"): void,
        (e: "update:modelValue", _value: PasswordlessLoginStartRequestBag): void
    }>();

    //#region Values

    const validationErrors = ref<FormError[]>([]);
    const phoneNumberConfig = ref<PhoneNumberBoxGetConfigurationResultsBag>();
    const emailOrPhoneNumberRaw = ref<string>("");
    const selectedMethod = ref<"email" | "phone">("email");
    const countryCodes = ["+502", "+503", "+1"];
    const selectedCountryCode = ref<string>("+502");

    //#endregion

    //#region Computed Values

    const label = computed<string>(() => selectedMethod.value === "email" ? "Correo electrónico" : "Número de teléfono");

    const emailOrPhoneNumber = computed<string>({
        get() {
            return emailOrPhoneNumberRaw.value;
        },
        set(newValue: string) {
            emailOrPhoneNumberRaw.value = newValue;
            validateEmailOrPhoneNumber(newValue);
        }
    });

    //#endregion

    //#region Event Handlers

    function onSelectMethod(method: "email" | "phone"): void {
        if (selectedMethod.value === method) return;
        selectedMethod.value = method;
        emailOrPhoneNumberRaw.value = "";
        validationErrors.value = [];
        emit("update:modelValue", {
            ...props.modelValue,
            email: null,
            phoneNumber: null,
            shouldSendEmailCode: false,
            shouldSendEmailLink: false,
            shouldSendSmsCode: false
        });
    }

    function onPasswordlessLoginStartSubmitted(): void {
        validateForm();

        if (validationErrors.value.length === 0) {
            emit("start");
        }
    }

    //#endregion

    //#region Functions

    function getConfiguredRules(): PhoneNumberCountryCodeRulesConfigurationBag[] {
        const rules = phoneNumberConfig.value?.rules;
        if (!rules) return [];

        // Only apply rules for the country the user actually selected.
        const selectedKey = selectedCountryCode.value.replace(/^\+/, "");
        const bag = rules[selectedKey];
        return bag ? [...bag] : [];
    }

    async function loadPhoneNumberConfig(): Promise<void> {
        phoneNumberConfig.value = await getPhoneNumberConfiguration();
    }

    function validateForm(): void {
        const errorMessages = validateValue(emailOrPhoneNumber.value, validateEmailOrPhoneNumber);

        if (errorMessages && errorMessages.length) {
            validationErrors.value = errorMessages.map(
                errorMessage => ({
                    name: label.value,
                    text: errorMessage
                })
            );
        }
        else {
            validationErrors.value = [];
        }
    }

    function validateEmailOrPhoneNumber(value: unknown): string | boolean {
        if (!value) {
            return true;
        }

        if (selectedMethod.value === "email") {
            const errors = validateEmail(value);
            if (errors === "") {
                emit("update:modelValue", {
                    ...props.modelValue,
                    email: value as string,
                    phoneNumber: null,
                    shouldSendEmailCode: true,
                    shouldSendEmailLink: true,
                    shouldSendSmsCode: false
                });
                return true;
            }
            emit("update:modelValue", {
                ...props.modelValue,
                email: null,
                phoneNumber: null,
                shouldSendEmailCode: false,
                shouldSendEmailLink: false,
                shouldSendSmsCode: false
            });
            return "Ingresa un correo electrónico válido";
        }

        const stripped = stripPhoneNumber(value as string);
        const formattedNumber = formatPhoneNumber(stripped);
        if (formattedNumber) {
            const errors = validatePhoneNumber(stripped);
            if (errors === "") {
                emailOrPhoneNumberRaw.value = formattedNumber;

                // Always send "+<code><digits>" so providers (Twilio / WhatsApp Cloud)
                // route correctly. The backend matches existing people with or without
                // country code, so legacy records still resolve.
                const phoneToSend = selectedCountryCode.value + stripped;

                emit("update:modelValue", {
                    ...props.modelValue,
                    email: null,
                    phoneNumber: phoneToSend,
                    shouldSendEmailCode: false,
                    shouldSendEmailLink: false,
                    shouldSendSmsCode: true
                });
                return true;
            }
        }

        emit("update:modelValue", {
            ...props.modelValue,
            email: null,
            phoneNumber: null,
            shouldSendEmailCode: false,
            shouldSendEmailLink: false,
            shouldSendSmsCode: false
        });
        return "Ingresa un número de teléfono válido";
    }

    function validateEmail(value: unknown): string {
        if (!value) return "";
        if (isEmail(value)) return "";
        return "Ingresa un correo electrónico válido.";
    }

    function validatePhoneNumber(value: string): string {
        if (!value) return "";

        const rules = getConfiguredRules();

        // If Rock has a rule for the selected country, honor it.
        if (rules.length > 0) {
            for (const rule of rules) {
                const regex = new RegExp(rule.match ?? "");
                if (regex.test(value)) return "";
            }
            return `El número '${value}' no es un número de teléfono válido.`;
        }

        // No rule for the selected country — fall back to a generic E.164 length check.
        if (value.length >= 7 && value.length <= 15) return "";
        return `El número '${value}' no es un número de teléfono válido.`;
    }

    //#endregion

    watch(selectedCountryCode, () => {
        if (selectedMethod.value === "phone" && emailOrPhoneNumberRaw.value) {
            validateEmailOrPhoneNumber(emailOrPhoneNumberRaw.value);
        }
    });

    loadPhoneNumberConfig();
</script>

<style>
/* ── Variables ─────────────────────────────────────────────── */
.plWrap {
    --pl-gray-100: #f3f3f3;
    --pl-gray-200: #e5e5e5;
    --pl-gray-300: #d5d5d5;
    --pl-gray-500: #7d7d7d;
    --pl-text:     #1f2933;
    --pl-danger:   #c22016;
    --pl-radius-lg:   14px;
    --pl-radius-pill: 999px;

    font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    color: var(--pl-text);
    animation: plRise 0.3s ease-out both;
    max-width: 440px;
    margin: 0 auto;
    width: 100%;
}

/* ── Card ──────────────────────────────────────────────────── */
.plWrap .plCard {
    background: #fff;
    border: 1px solid var(--pl-gray-300);
    border-radius: var(--pl-radius-lg);
    box-shadow: 0 10px 24px rgba(8, 8, 8, 0.08);
    padding: 20px;
}

/* ── Selector Email / Teléfono ─────────────────────────────── */
.plWrap .plMethodSwitch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #111;
    border: 1px solid #3e3e3e;
    border-radius: var(--pl-radius-pill);
    padding: 4px;
    gap: 4px;
    margin-bottom: 20px;
}

.plWrap .plMethodBtn {
    min-height: 42px;
    border: 0;
    border-radius: var(--pl-radius-pill);
    background: transparent;
    color: #cfcfcf;
    font-family: Manrope, "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
}

.plWrap .plMethodBtn.isActive {
    background: #fff;
    color: #0f0f0f;
}

/* ── Campo ─────────────────────────────────────────────────── */
.plWrap .plField {
    display: grid;
    gap: 7px;
    margin-bottom: 16px;
}

.plWrap .plField > span {
    color: #4a4a4a;
    font-family: Manrope, "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.plWrap .plInput {
    width: 100%;
    min-height: 48px;
    border: 1px solid #bfbfbf;
    border-radius: 12px;
    background: #fff;
    color: #1e1e1e;
    font-size: 15px;
    font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    padding: 10px 14px;
    box-shadow: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    outline: none;
}

.plWrap .plInput:focus {
    border-color: #7b7b7b;
    box-shadow: 0 0 0 3px rgba(51, 51, 51, 0.12);
}

.plWrap .plInput::placeholder {
    color: #a0a0a0;
}

.plWrap .plInput:disabled {
    background: var(--pl-gray-100);
    color: var(--pl-gray-500);
    cursor: not-allowed;
}

/* ── Selector de código de país + número ───────────────────── */
.plWrap .plPhoneRow {
    display: flex;
    gap: 8px;
    align-items: stretch;
}

.plWrap .plCountrySelect {
    flex: 0 0 96px;
    width: 96px;
    padding-right: 28px;
    cursor: pointer;
    font-weight: 700;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%231e1e1e' d='M6 8L0 0h12z'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 10px 7px;
    text-align: center;
    text-align-last: center;
}

.plWrap .plPhoneInput {
    flex: 1 1 auto;
    min-width: 0;
}

/* Evita zoom en iOS */
@media (max-width: 991px) {
    .plWrap .plInput {
        font-size: 16px !important;
    }
}

/* ── Botón principal ───────────────────────────────────────── */
.plWrap .plActions {
    margin-top: 4px;
}

.plWrap .plSubmitBtn {
    width: 100%;
    min-height: 52px;
    border-radius: var(--pl-radius-pill);
    border: 1px solid #000;
    background: #000;
    color: #fff;
    font-family: Manrope, "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.02em;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background 0.18s ease;
}

.plWrap .plSubmitBtn:hover:not(:disabled) {
    background: #1a1a1a;
    border-color: #1a1a1a;
}

.plWrap .plSubmitBtn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ── Alerta de error ───────────────────────────────────────── */
.plWrap .plAlert {
    background: #fef3f2;
    border: 1px solid #fecdc9;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 14px;
    display: grid;
    gap: 4px;
}

.plWrap .plAlert span {
    color: #b42318;
    font-size: 13px;
    font-weight: 600;
}

/* ── Animación ─────────────────────────────────────────────── */
@keyframes plRise {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ── Responsive móvil ──────────────────────────────────────── */
@media (max-width: 575px) {
    .plWrap .plMethodBtn {
        font-size: 13px;
        min-height: 38px;
    }

    .plWrap .plSubmitBtn {
        min-height: 48px;
        font-size: 15px;
    }

    .plWrap .plInput {
        min-height: 44px;
        font-size: 15px;
    }
}
</style>
