    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
}

.plVerifyWrap .plPersonIcon svg {
    width: 18px;
    height: 18px;
}

.plVerifyWrap .plPersonTitle {
    margin: 0 0 2px;
    font-family: Manrope, "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    font-weight: 800;
    color: #1a1a1a;
}

.plVerifyWrap .plPersonSubtitle {
    margin: 0;
    font-size: 13px;
    color: #6b6b6b;
    line-height: 1.4;
}

.plVerifyWrap .plPersonList {
    display: grid;
    gap: 8px;
}

.plVerifyWrap .plPersonCard {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 14px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.plVerifyWrap .plPersonCard:hover {
    border-color: #ababab;
    background: #fafafa;
}

.plVerifyWrap .plPersonCard.isSelected {
    border-color: #1a1a1a;
    background: #f7f7f7;
    box-shadow: 0 0 0 1px #1a1a1a;
}

.plVerifyWrap .plPersonAvatar {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #1a1a1a;
    color: #fff;
    font-family: Manrope, "Plus Jakarta Sans", sans-serif;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.02em;
    overflow: hidden;
}

.plVerifyWrap .plPersonAvatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.plVerifyWrap .plPersonCard.isSelected .plPersonAvatar {
    background: #000;
}

.plVerifyWrap .plPersonName {
    flex: 1;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
}

.plVerifyWrap .plPersonCheck {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
}

.plVerifyWrap .plPersonCheck svg {
    width: 22px;
    height: 22px;
}

.plVerifyWrap .plPersonCheckEmpty {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #d0d0d0;
}

/* ── Animación ─────────────────────────────────────────────── */
@keyframes plVerifyRise {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
