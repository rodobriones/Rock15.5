<!--
    Este componente reutiliza el sistema de diseño (.plScreen, .plCard, .plBtn,
    tipografías y variables) declarado en passwordlessLoginStartStep.partial.obs.
    Ambos parciales se empaquetan juntos en el bloque Login, así que sus estilos
    siempre están disponibles. Aquí solo se agregan las clases propias del paso
    de verificación (OTP, selección de perfil y modal de confirmación).
-->
<template>
    <div class="plScreen plVerifyScreen">
        <header class="plHeader">
            <p class="plEyebrow">Login</p>
            <h1 class="plTitle">Bienvenido</h1>
        </header>

        <section class="plCard">
            <div class="plCardBody">
                <RockForm v-model:submit="internalSubmitPasswordlessLoginVerification"
                          @submit="onPasswordlessLoginVerifySubmitted">

                    <h2 class="plCardTitle" ref="instructionsDiv">Ingresa código de confirmación</h2>
                    <p class="plCardSubtitle">
                        Hemos enviado el código de 6 dígitos a tu
                        {{ internalCommunicationType === 'email' ? 'correo' : 'número' }} de registro
                    </p>

                    <div class="plCodeWrap">
                        <CodeBox v-model.capitalize="internalCode"
                                 :disabled="disabled"
                                 :maxLength="6"
                                 rules="required"
                                 validationTitle="Código"
                                 @complete="onCodeCompleted" />
                    </div>

                    <!-- Paso 1: verificar el código -->
                    <div v-if="!isProfileSelectionStep" class="plOtpActions">
                        <button
                            class="plBtn plBtnDark complete-sign-in-btn"
                            :disabled="disabled"
                            type="submit">
                            Completar acceso
                        </button>

                        <p class="plHelper">Si no has recibido el código, haz click en el siguiente enlace</p>

                        <button
                            class="plLink"
                            :class="{ isDisabled: disabled || resendCooldown > 0 }"
                            :disabled="disabled || resendCooldown > 0"
                            type="button"
                            @click="onResendCodeClicked">
                            {{ resendCooldown > 0 ? `Reenviar código en ${resendCooldown}` : "Reenviar código" }}
                        </button>
                    </div>

                    <!-- Paso 2: elegir a qué persona se asocia el correo / teléfono -->
                    <div v-else class="plProfilePicker">
                        <div class="plProfileHeader">
                            <div class="plProfileIcon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div>
                                <p class="plProfileTitle">¿Cuál eres tú?</p>
                                <p class="plProfileSubtitle">
                                    Elige el usuario al cual quieres asociar este
                                    {{ internalCommunicationType === 'email' ? 'correo' : 'número' }}
                                </p>
                            </div>
                        </div>

                        <div class="plProfileList">
                            <label v-for="person in internalMatchingPeople"
                                   :key="person.value ?? ''"
                                   class="plProfileRow"
                                   :class="{ isSelected: internalMatchingPersonValue === person.value }">
                                <span class="plProfileAvatar">
                                    <img v-if="person.category"
                                         :src="person.category"
                                         :alt="personName(person.text ?? '')"
                                         class="plProfileAvatarImg" />
                                    <span v-else>{{ personInitials(personName(person.text ?? '')) }}</span>
                                </span>
                                <span class="plProfileInfo">
                                    <span class="plProfileName">{{ personName(person.text ?? '') }}</span>
                                    <span v-if="personAge(person.text ?? '')" class="plProfileMeta">
                                        {{ personAge(person.text ?? '') }} años
                                    </span>
                                </span>
                                <input type="radio"
                                       class="plProfileRadio"
                                       name="plMatchingPerson"
                                       :value="person.value ?? ''"
                                       :disabled="disabled"
                                       :checked="internalMatchingPersonValue === person.value"
                                       @change="internalMatchingPersonValue = person.value ?? ''" />
                            </label>
                        </div>

                        <button
                            class="plBtn plBtnDark plProfileSubmit"
                            :disabled="disabled || !internalMatchingPersonValue"
                            type="button"
                            @click="onConfirmProfileClicked">
                            Completar acceso
                        </button>
                    </div>
                </RockForm>
            </div>
        </section>

        <button class="plBackLink" type="button" :disabled="disabled" @click="onBackClicked">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.03 3.97a.75.75 0 0 1 0 1.06L5.06 11H21a.75.75 0 0 1 0 1.5H5.06l5.97 5.97a.75.75 0 1 1-1.06 1.06l-7.25-7.25a.75.75 0 0 1 0-1.06l7.25-7.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
            </svg>
            <span>Regresar</span>
        </button>
    </div>

    <!-- Modal de confirmación: la asociación es permanente. -->
    <div v-if="isConfirmModalShown" class="plModalOverlay" @click.self="isConfirmModalShown = false">
        <div class="plModal" role="dialog" aria-modal="true" aria-labelledby="plModalTitle">
            <h2 id="plModalTitle" class="plModalTitle">Completar acceso</h2>
            <p class="plModalText">
                Tu {{ internalCommunicationType === 'email' ? 'correo' : 'número' }} quedará asociado
                permanentemente al perfil seleccionado.
            </p>
            <p class="plModalText isStrong">
                Asegúrate de utilizar tu perfil y no el de otra persona asociada a tu cuenta,
                pues no podrás cambiarlo posteriormente.
            </p>
            <div class="plModalActions">
                <button class="plBtn plBtnOutline" type="button" @click="isConfirmModalShown = false">Cancelar</button>
                <button class="plBtn plBtnDark" type="button" :disabled="disabled" @click="onConfirmModalAccepted">Aceptar</button>
            </div>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { computed, onMounted, onUnmounted, PropType, ref } from "vue";
    import { PasswordlessCommunicationType } from "./types.partial";
    import CodeBox from "../codeBox.obs";
    import RockForm from "@Obsidian/Controls/rockForm.obs";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { PasswordlessLoginVerifyOptionsBag } from "@Obsidian/ViewModels/Blocks/Security/Login/passwordlessLoginVerifyOptionsBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<PasswordlessLoginVerifyOptionsBag>,
            required: true
        },
        communicationType: {
            type: String as PropType<PasswordlessCommunicationType>,
            required: false,
            default: "data"
        },
        disabled: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        },
        isMobileForced: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        },
        submitPasswordlessLoginVerification: {
            type: Boolean as PropType<boolean>,
            required: false,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "back"): void,
        (e: "backToCode"): void,
        (e: "resendCode"): void,
        (e: "update:submitPasswordlessLoginVerification", _value: boolean): void
        (e: "update:modelValue", _value: PasswordlessLoginVerifyOptionsBag),
        (e: "verify"): void,
    }>();

    //#region Values

    const internalSubmitPasswordlessLoginVerification = useVModelPassthrough(props, "submitPasswordlessLoginVerification", emit);
    const instructionsDiv = ref<HTMLElement | undefined>();
    const isConfirmModalShown = ref(false);

    // Cooldown anti-abuso: cada reenvío manda un SMS/correo con costo.
    const resendCooldown = ref(0);
    let cooldownTimer: number | undefined;

    function startResendCooldown(): void {
        resendCooldown.value = 30;
        window.clearInterval(cooldownTimer);
        cooldownTimer = window.setInterval(() => {
            if (resendCooldown.value > 0) {
                resendCooldown.value--;
            }
            else {
                window.clearInterval(cooldownTimer);
            }
        }, 1000);
    }

    // El código recién se envió cuando aparece este paso.
    onMounted(startResendCooldown);
    onUnmounted(() => window.clearInterval(cooldownTimer));

    //#endregion

    //#region Computed Values

    const internalCode = computed({
        get() {
            return props.modelValue.code || "";
        },
        set(newValue: string) {
            emit("update:modelValue", {
                ...props.modelValue,
                code: newValue
            });
        }
    });

    const internalCommunicationType = computed(() => props.communicationType || "data");

    const isProfileSelectionStep = computed<boolean>(() => !!props.modelValue.isPersonSelectionRequired);

    const internalMatchingPeople = computed({
        get() {
            return props.modelValue.matchingPeople ?? [];
        },
        set(newValue: ListItemBag[]) {
            emit("update:modelValue", {
                ...props.modelValue,
                matchingPeople: newValue
            });
        }
    });

    const internalMatchingPersonValue = computed({
        get() {
            return props.modelValue.matchingPersonValue || "";
        },
        set(newValue: string) {
            emit("update:modelValue", {
                ...props.modelValue,
                matchingPersonValue: newValue
            });
        }
    });

    //#endregion

    //#region Functions

    function personInitials(name: string): string {
        return name.trim().split(/\s+/).slice(0, 2).map(w => w[0]?.toUpperCase() ?? "").join("");
    }

    // El backend anexa la edad al nombre como "Nombre|34" (ListItemBag no tiene campo libre).
    function personName(text: string): string {
        return text.split("|")[0] ?? "";
    }

    function personAge(text: string): string {
        return text.split("|")[1] ?? "";
    }

    //#endregion

    //#region Event Handlers

    function onPasswordlessLoginVerifySubmitted(): void {
        emit("verify");
    }

    function onConfirmProfileClicked(): void {
        if (props.disabled || !internalMatchingPersonValue.value) {
            return;
        }

        isConfirmModalShown.value = true;
    }

    function onConfirmModalAccepted(): void {
        isConfirmModalShown.value = false;

        // El código ya fue validado por el servidor en el primer envío; aquí solo
        // se agrega la persona elegida, así que no hace falta revalidar el form.
        emit("verify");
    }

    function onBackClicked(): void {
        if (isProfileSelectionStep.value) {
            // Lo maneja el padre: apagar isPersonSelectionRequired solo aquí dejaría
            // el estado del bloque en "true" y el selector ya no volvería a aparecer
            // (el watcher del padre solo sincroniza los campos que cambiaron).
            emit("backToCode");
            return;
        }

        emit("back");
    }

    function onResendCodeClicked(): void {
        startResendCooldown();

        // Un solo emit: emits consecutivos parten del mismo props.modelValue
        // (que no se actualiza hasta el re-render) y se pisan entre sí.
        emit("update:modelValue", {
            ...props.modelValue,
            code: "",
            matchingPersonValue: "",
            matchingPeople: [],
            isPersonSelectionRequired: false
        });
        emit("resendCode");
    }

    function onCodeCompleted(): void {
        const signInButton = instructionsDiv.value?.parentElement?.querySelector<HTMLButtonElement>("button.complete-sign-in-btn");

        if (signInButton) {
            signInButton.focus();
        }
    }

    //#endregion
</script>

<style>
/* ── Textos de la tarjeta ──────────────────────────────────── */
.plVerifyScreen .plCardTitle {
    margin: 0 0 8px;
    font-family: var(--pl-font-body);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: #1f2024;
    text-align: center;
}

.plVerifyScreen .plCardSubtitle {
    margin: 0 0 24px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--pl-text-muted);
    text-align: center;
}

/* ── Cajas del OTP (override de codeBox.obs) ───────────────── */
.plVerifyScreen .plCodeWrap {
    margin-bottom: 24px;
}

.plVerifyScreen .plCodeWrap .rock-code-box {
    margin: 0;
}

.plVerifyScreen .plCodeWrap .rock-code-box .d-flex {
    gap: 8px;
    justify-content: center;
}

/* codeBox.obs usa estilos scoped de alta especificidad: hay que forzarlos. */
.plVerifyScreen .plCodeWrap .rock-code-box input {
    width: 44px !important;
    height: 56px !important;
    font-family: var(--pl-font-body) !important;
    font-size: 20px !important;
    font-weight: 600 !important;
    text-align: center !important;
    color: var(--pl-dark) !important;
    border: 1px solid var(--pl-border) !important;
    border-radius: 10px !important;
    background: #fff !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
    outline: none !important;
    padding: 0 !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
}

.plVerifyScreen .plCodeWrap .rock-code-box input:focus {
    border-color: var(--pl-accent) !important;
    box-shadow: 0 0 0 1px var(--pl-accent) !important;
}

.plVerifyScreen .plCodeWrap .rock-code-box input:disabled {
    background: #f3f3f3 !important;
    color: var(--pl-gray) !important;
    cursor: not-allowed !important;
}

/* ── Acciones del paso OTP ─────────────────────────────────── */
.plVerifyScreen .plOtpActions {
    display: flex;
    flex-direction: column;
}

.plVerifyScreen .plLink {
    display: block;
    margin: 12px auto 0;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--pl-font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--pl-dark);
    text-decoration: underline;
    cursor: pointer;
}

.plVerifyScreen .plLink.isDisabled {
    color: var(--pl-gray-2);
    text-decoration: none;
    cursor: default;
}

/* ── Selección de perfil ───────────────────────────────────── */
.plVerifyScreen .plProfilePicker {
    display: flex;
    flex-direction: column;
}

.plVerifyScreen .plProfileHeader {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
}

.plVerifyScreen .plProfileIcon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(118, 118, 128, 0.12);
    color: #3c3c43;
    display: flex;
    align-items: center;
    justify-content: center;
}

.plVerifyScreen .plProfileIcon svg {
    width: 16px;
    height: 16px;
}

.plVerifyScreen .plProfileTitle {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 700;
    color: #000;
}

.plVerifyScreen .plProfileSubtitle {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: var(--pl-text-muted);
}

.plVerifyScreen .plProfileList {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.plVerifyScreen .plProfileRow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 7px 16px 7px 8px;
    background: #fff;
    border: 1px solid transparent;
    border-radius: 10px;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    font-weight: 400;
    transition: background 0.18s ease, border-color 0.18s ease;
}

.plVerifyScreen .plProfileRow:hover {
    background: #f9f9f9;
}

.plVerifyScreen .plProfileRow.isSelected {
    border-color: var(--pl-dark);
}

.plVerifyScreen .plProfileAvatar {
    flex-shrink: 0;
    width: 52px;
    height: 49px;
    border-radius: 10px;
    background: var(--pl-gray-5);
    color: #3c3c43;
    font-family: var(--pl-font-body);
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.plVerifyScreen .plProfileAvatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.plVerifyScreen .plProfileInfo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.plVerifyScreen .plProfileName {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    color: #0c243e;
}

.plVerifyScreen .plProfileMeta {
    font-size: 11px;
    color: var(--pl-text-muted);
}

.plVerifyScreen .plProfileRadio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--pl-dark);
    cursor: pointer;
}

.plVerifyScreen .plProfileSubmit {
    margin-top: 20px;
}

/* ── Enlace "Regresar" ─────────────────────────────────────── */
.plVerifyScreen .plBackLink {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 24px auto 0;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--pl-font-body);
    font-size: 14px;
    font-weight: 500;
    color: #000;
    cursor: pointer;
}

.plVerifyScreen .plBackLink svg {
    width: 15px;
    height: 15px;
}

.plVerifyScreen .plBackLink:disabled {
    color: var(--pl-gray-2);
    cursor: not-allowed;
}

/* ── Modal de confirmación ─────────────────────────────────── */
.plModalOverlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(31, 32, 36, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    animation: plModalFade 0.2s ease;
}

.plModal {
    --pl-surface: #ffffff;
    --pl-dark: #272b31;
    --pl-text-muted: #71727a;
    --pl-border: #c5c6cc;
    --pl-radius-lg: 12px;
    --pl-radius-xl: 16px;
    --pl-font-body: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;

    width: 100%;
    max-width: 320px;
    background: var(--pl-surface);
    border-radius: var(--pl-radius-xl);
    padding: 24px 16px;
    text-align: center;
    font-family: var(--pl-font-body);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
    animation: plModalRise 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.1);
    box-sizing: border-box;
}

.plModalTitle {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 700;
    color: #1f2024;
}

.plModalText {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--pl-text-muted);
}

.plModalText.isStrong {
    font-weight: 600;
}

.plModalActions {
    display: flex;
    gap: 8px;
    margin-top: 20px;
}

.plModalActions .plBtn {
    flex: 1;
    width: auto;
    height: 40px;
    border: 0;
    border-radius: var(--pl-radius-lg);
    font-family: var(--pl-font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.plModalActions .plBtnDark {
    background: var(--pl-dark);
    color: #fff;
}

.plModalActions .plBtnDark:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.plModalActions .plBtnOutline {
    background: transparent;
    border: 1.5px solid var(--pl-dark);
    color: var(--pl-dark);
}

.plModalActions .plBtnOutline:hover {
    background: #f3f3f3;
}

@keyframes plModalFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes plModalRise {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── Responsive móvil ──────────────────────────────────────── */
@media (max-width: 575px) {
    .plVerifyScreen .plCodeWrap .rock-code-box input {
        width: 42px !important;
        height: 52px !important;
        font-size: 18px !important;
    }

    .plVerifyScreen .plCodeWrap .rock-code-box .d-flex {
        gap: 6px;
    }

    .plVerifyScreen .plProfileAvatar {
        width: 46px;
        height: 44px;
    }
}
</style>
