<template>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError"></NotificationBox>

    <Panel v-if="!blockError"
           v-model:mode="panelMode"
           :title="friendlyEntityName"
           class="m-0 p-0">
        <template #headerActions>
            <RockButton v-if="!options.blockProperties?.showOnlyCategories && isEntityInfoInitialized"
                        :title="`Add ${friendlyEntityName}`"
                        :btnSize="BtnSize.ExtraSmall"
                        :btnType="BtnType.Link"
                        :isSquare="true"
                        :disabled="!treeListSelectedItems || treeListSelectedItems.length === 0"
                        @click.prevent.stop="onAddEntity">
                <i class="ti ti-plus color-medium"></i>
            </RockButton>
            <DropDownMenu :items="dropDownMenuItems"
                          title="Add Category"
                          :anchorButtonSize="BtnSize.ExtraSmall"
                          :anchorButtonType="BtnType.Link"
                          :align="dropDownMenuHorizontalAlign"
                          :verticalAlign="dropDownMenuVerticalAlign"
                          anchorIconCssClass="ti ti-folder-plus color-medium"
                          :isAnchorButtonOverflow="false" />
            <RockButton v-if="hasDefinedSearchPage && searchPageUrl !== undefined"
                        title="Search"
                        :btnSize="BtnSize.ExtraSmall"
                        :btnType="BtnType.Link"
                        :isSquare="true"
                        @click.prevent.stop="onToggleSearchDrawer">
                <i class="ti ti-search color-medium"></i>
            </RockButton>
            <RockButton v-if="bag.isActivatedType"
                        title=""
                        :btnSize="BtnSize.ExtraSmall"
                        :btnType="BtnType.Link"
                        :isSquare="true"
                        @click.prevent.stop="onTogglePersonPreferenceDrawer">
                <i class="ti ti-dots-vertical color-medium"></i>
            </RockButton>
        </template>
        <div v-if="hasDefinedSearchPage && searchPageUrl !== undefined" class="panel-drawer" :class="isSearchDrawerVisible ? 'open' : ''">
            <TransitionVerticalCollapse>
                <div v-show="isSearchDrawerVisible" class="drawer-content">
                    <SearchResultsSearchField v-model="searchTerm"
                                              :searchResultsPageUrl="searchPageUrl" />
                </div>
            </TransitionVerticalCollapse>
        </div>
        <div class="panel-drawer" :class="personPreferenceDrawer.isDrawerVisible.value ? 'open' : ''">
            <TransitionVerticalCollapse>
                <div v-show="personPreferenceDrawer.isDrawerVisible.value" class="drawer-content">
                    <Toggle v-model="personPreferenceDrawer.personPreferences.isHidingInactiveItems.value"
                            label="Show"
                            :btnSize="BtnSize.ExtraSmall"
                            trueText="Active"
                            falseText="All"
                            @update:modelValue="onToggleHideInactiveItems" />
                </div>
            </TransitionVerticalCollapse>
        </div>
        <TreeList v-if="isTreeListDataInitialized"
                  v-model="treeListSelectedItems"
                  :items="treeListItems"
                  :disableFolderSelection="isTreeListFolderSelectionDisabled"
                  :showChildCount="isTreeListShowingChildCount"
                  :enableDeselect="isTreeListAllowingDeselection"
                  :initiallyExpanded="treeListInitiallyExpandedGuids"
                  @update:modelValue="onSelect"
                  @update:items="onUpdateItems"
                  @treeitem-expanded="onTreeItemExpanded"
                  @treeitem-collapsed="onTreeItemCollapsed"
                  autoExpand />
    </Panel>
</template>

<style scoped>
:deep(.panel-header-actions button i) {
    color: var(--color-interface-stronger);
}

:deep(.panel-header-actions button:disabled i),
:deep(.panel-header-actions .dropdown-menu button:disabled i) {
    color: var(--color-interface-medium);
}

:deep(.panel-body .rocktree span:hover) {
    background-color: var(--base-interface-softer);
}

:deep(.panel-body .rocktree .rocktree-name.selected) {
    background-color: var(--color-info-soft);
}

:deep(.panel-header-actions .dropdown-menu) {
    min-width: 170px;
}
</style>

<script setup lang="ts">
    import { ref, computed, onBeforeMount } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import TreeList from "@Obsidian/Controls/treeList.obs";
    import DropDownMenu from "@Obsidian/Controls/dropDownMenu.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import TransitionVerticalCollapse from "@Obsidian/Controls/transitionVerticalCollapse.obs";
    import SearchResultsSearchField from "@Obsidian/Controls/searchResultsSearchField.obs";
    import Toggle from "@Obsidian/Controls/toggle.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { DetailPanelMode } from "@Obsidian/Enums/Controls/detailPanelMode";
    import { MenuAction } from "@Obsidian/Types/Controls/dropDownMenu";
    import { CustomBlockBox } from "@Obsidian/ViewModels/Blocks/customBlockBox";
    import { CategoryTreeViewBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewBag";
    import { CategoryTreeViewTreeListBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewTreeListBag";
    import { CategoryTreeViewOptionsBag } from "@Obsidian/ViewModels/Blocks/Core/CategoryTreeView/categoryTreeViewOptionsBag";
    import { TreeItemBag } from "@Obsidian/ViewModels/Utility/treeItemBag";
    import { NavigationUrlKey, PersonPreferenceKey } from "./CategoryTreeView/types.partial";
    import { CategoryTreeViewItemProvider } from "@Obsidian/Utility/treeItemProviders";
    import { Guid } from "@Obsidian/Types";
    import { useSecurityGrantToken } from "@Obsidian/Utility/block";
    import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";

    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const box = useConfigurationValues<CustomBlockBox<CategoryTreeViewBag, CategoryTreeViewOptionsBag>>();
    const bag = box.bag ?? { isEditable: false, isActivatedType: false, isUserHidingInactiveItems: false };
    const options = box.options ?? getEmptyOptionsBag();

    const panelMode = ref<DetailPanelMode>(bag.isEditable ? DetailPanelMode.Edit : DetailPanelMode.View);

    const isTreeListDataInitialized = ref<boolean>(false);

    const treeList = ref<CategoryTreeViewTreeListBag>(bag.treeList ?? getEmptyTreeListBag());
    const treeListSelectedItems = ref<string[]>(treeList.value.selectedItems ?? []);
    const treeListItems = ref<TreeItemBag[]>(treeList.value.items ?? []);
    const treeListExpandedItems = ref<string[]>(treeList.value.expandedItems ?? []);
    const treeListInitiallyExpandedGuids = ref<string[]>(treeList.value.initiallyExpandedItems ?? []);
    const isTreeListFolderSelectionDisabled = ref<boolean>(treeList.value.isFolderSelectionDisabled ?? false);
    const isTreeListShowingChildCount = ref<boolean>(treeList.value.isShowingChildCount ?? false);
    const isTreeListAllowingDeselection = ref<boolean>(treeList.value.isAllowingDeselection ?? false);

    /**
     * Entity Info must be initialized before we can show the Add button.
     * Once a tooltip-style title is set, it cannot be changed due to how
     * HTML title attributes work. So we wait until we have the correct
     * entity name before showing the button.
     */
    const isEntityInfoInitialized = ref<boolean>(false);
    const entityTypeGuid = computed<string | undefined>(() => {
        return options.blockProperties?.entityType || undefined;
    });
    const friendlyEntityName = ref<string>("Category Tree View");
    /** */


    const blockError = ref<string>("");

    const navigationUrls = computed(() => box.navigationUrls ?? {});
    const searchPageUrl = computed<string | undefined>(() => {
        return navigationUrls.value ? navigationUrls.value[NavigationUrlKey.SearchResultsPage] : undefined;
    });

    const hasDefinedSearchPage = computed(() =>
        !!(options.blockProperties
            && options.blockProperties.searchResultsPage
            && options.blockProperties.searchResultsPage !== "")
    );

    // UI state for dropdowns, modals, and search/config panels
    const isSearchDrawerVisible = ref(false);
    const searchTerm = ref("");

    // TreeList Item Provider
    const itemProvider = ref(new CategoryTreeViewItemProvider());
    const securityGrantToken = useSecurityGrantToken();
    itemProvider.value.rootCategoryGuid = options.blockProperties?.rootCategory ?? "";
    itemProvider.value.entityTypeGuid = entityTypeGuid.value ?? "";
    itemProvider.value.entityTypeQualifierColumn = options.blockProperties?.entityTypeQualifierProperty ?? "";
    itemProvider.value.entityTypeQualifierValue = options.blockProperties?.entityTypeQualifierValue ?? "";
    itemProvider.value.includeInactiveItems = bag.isUserHidingInactiveItems ?? false;
    itemProvider.value.includeUnnamedEntityItems = options.blockProperties?.showUnnamedEntityItems ?? true;
    itemProvider.value.securityGrantToken = securityGrantToken.value;

    const personPreferenceDrawer = {
        isDrawerVisible: ref<boolean>(false),
        personPreferences: {
            isHidingInactiveItems: ref<boolean>(bag.isUserHidingInactiveItems ?? false),
        }
    };

    const dropDownMenuItems = computed<MenuAction[]>(() => [
        {
            title: "Add Top-Level",
            type: "default",
            handler: onAddCategoryRoot
        },
        {
            title: "Add Child To Selected",
            type: "default",
            handler: onAddCategoryChild,
            disabled: !treeListSelectedItems || treeListSelectedItems.value.length !== 1
        }
    ]);

    /** Define the horizontal alignment of the drop down menu. */
    const dropDownMenuHorizontalAlign = ref<"left" | "right">("right");

    /** Define the vertical alignment of the drop down menu. */
    const dropDownMenuVerticalAlign = ref<"down" | "up">("down");

    // #endregion Values

    // #region Functions

    /**
     * Creates and returns an empty CategoryTreeViewTreeListBag.
     *
     * @returns An empty CategoryTreeViewTreeListBag.
     */
    function getEmptyTreeListBag(): CategoryTreeViewTreeListBag {
        return {
            selectedItems: [],
            items: [],
            expandedItems: [],
            initiallyExpandedItems: [],
            isFolderSelectionDisabled: false,
            isShowingChildCount: false,
            isAllowingDeselection: false,
        };
    }

    function getEmptyOptionsBag(): CategoryTreeViewOptionsBag {
        return {
            blockProperties: {
                entityType: "",
                entityTypeFriendlyName: "",
                entityTypeQualifierProperty: "",
                entityTypeQualifierValue: "",
                rootCategory: "",
                showOnlyCategories: false,
                showUnnamedEntityItems: true,
                searchResultsPage: "",
                defaultIconCSSClass: "",
                excludeCategories: "",
                pageParameterKey: ""
            }
        };
    }

    /**
     * Sets the panel name based on the entity type friendly name.
     */
    async function setPanelName(): Promise<void> {
        friendlyEntityName.value = options.blockProperties?.entityTypeFriendlyName
            || await getEntityTypeFriendlyNameFromGuid(entityTypeGuid.value)
            || "Category Tree View";
        isEntityInfoInitialized.value = true;
    }

    /**
     * Sets the tree list items by retrieving and formatting them.
     */
    async function setTreeListItems(): Promise<void> {
        treeListItems.value = await getFormattedTreeListItems();
    }

    /**
     * Retrieves the formatted tree list items, applying any necessary icon settings
     * and filtering excluded categories.
     *
     * @param items Optional list of TreeItemBag to format. If not provided, root items will be fetched from the provider.
     * @returns A promise that resolves to the formatted list of TreeItemBag.
     */
    async function getFormattedTreeListItems(items: TreeItemBag[] | null = null): Promise<TreeItemBag[]> {
        let formattedItems = items !== null ? JSON.parse(JSON.stringify(items)) as TreeItemBag[] : await itemProvider.value.getRootItems();

        /** Set default icons for items that don't have one */
        const setDefaultIconsRecursively = (items: TreeItemBag[]): void => {
            items.forEach(item => {
                if (!item.iconCssClass || item.iconCssClass === "") {
                    if (item.type?.toLowerCase() === "category") {
                        item.iconCssClass = "ti ti-folder-open";
                    }
                    else {
                        item.iconCssClass = options.blockProperties?.defaultIconCSSClass || "ti ti-list-numbers";
                    }
                }
                if (item.children && item.children.length > 0) {
                    setDefaultIconsRecursively(item.children);
                }
            });
        };

        /** TreeList doesn't support excluding items, so we need to filter them out. */
        const filterExcludedCategoriesRecursively = (items: TreeItemBag[]): void => {
            for (let i = items.length - 1; i >= 0; i--) {
                const item = items[i];
                if (options.blockProperties?.excludeCategories?.includes(item.value ?? "")) {
                    items.splice(i, 1);
                }
                else if (item.children && item.children.length > 0) {
                    filterExcludedCategoriesRecursively(item.children);
                    if (item.children.length === 0) {
                        item.hasChildren = false;
                    }
                }
            }
        };

        setDefaultIconsRecursively(formattedItems);
        filterExcludedCategoriesRecursively(formattedItems);

        return formattedItems;
    }

    /**
     * Refreshes the page after a person preference change.
     *
     * @param includeQueryParams Whether to include existing query parameters in the refreshed URL.
     */
    function refreshAfterPersonPreferenceChange(includeQueryParams: boolean): void {
        const url = new URL(window.location.href);
        if (!includeQueryParams) {
            url.search = "";
        }
        window.location.href = url.toString();
    }

    // #endregion Functions

    // #region Event Handlers

    /**
     * Toggles the visibility of the search drawer.
     */
    function onToggleSearchDrawer(): void {
        isSearchDrawerVisible.value = !isSearchDrawerVisible.value;

        if (isSearchDrawerVisible.value && personPreferenceDrawer.isDrawerVisible.value) {
            personPreferenceDrawer.isDrawerVisible.value = false;
        }
    }

    /**
     * Toggles the visibility of the person preference drawer.
     */
    function onTogglePersonPreferenceDrawer(): void {
        personPreferenceDrawer.isDrawerVisible.value = !personPreferenceDrawer.isDrawerVisible.value;
        if (personPreferenceDrawer.isDrawerVisible.value && isSearchDrawerVisible.value) {
            isSearchDrawerVisible.value = false;
        }
    }

    /**
     * Handles the toggling of the "Hide Inactive Items" preference.
     */
    function onToggleHideInactiveItems(): void {
        setPersonPreference(PersonPreferenceKey.HideInactiveItems, personPreferenceDrawer.personPreferences.isHidingInactiveItems.value);
        refreshAfterPersonPreferenceChange(false);
    }

    /**
     * Handles the expansion of a tree item.
     *
     * @param item The tree item that was expanded.
     */
    function onTreeItemExpanded(item: TreeItemBag): void {
        if (item.value) {
            treeListExpandedItems.value.push(item.value);
        }
    }

    /**
     * Handles the collapsing of a tree item.
     *
     * @param item The tree item that was collapsed.
     */
    function onTreeItemCollapsed(item: TreeItemBag): void {
        if (item.value) {
            treeListExpandedItems.value = treeListExpandedItems.value.filter(id => id !== item.value);
        }
    }

    /**
     * Handles the selection of tree items.
     *
     * @param value The array of selected item values.
     */
    async function onSelect(value: string[]): Promise<void> {
        if (isTreeListDataInitialized.value === false) {
            return;
        }

        if (value.length > 1 || value.length < 0) {
            treeListSelectedItems.value = [];
            return;
        }

        if (options.blockProperties?.pageParameterKey && treeListItems.value) {
            // Recursively search for the matching item in treeListItems and their children
            const findMatchingTreeListItem = (items: TreeItemBag[], targetValue: string): TreeItemBag | undefined => {
                for (const item of items) {
                    if (item.value === targetValue) {
                        return item;
                    }
                    if (item.children && item.children.length > 0) {
                        const found = findMatchingTreeListItem(item.children, targetValue);
                        if (found) {
                            return found;
                        }
                    }
                }
                return undefined;
            };

            const matchingTreeListItem = findMatchingTreeListItem(treeListItems.value, value[0]);

            if (matchingTreeListItem && matchingTreeListItem.value) {
                const isMatchingItemCategory = matchingTreeListItem.type?.toLowerCase() === "category";

                const entityIdKey = await getIdKeysFromGuids(matchingTreeListItem.value, isMatchingItemCategory);
                const expandedIdKeys = await getIdKeysFromGuids(treeListExpandedItems.value, true);

                if (entityIdKey) {
                    treeListSelectedItems.value = [value[0]];

                    const url = new URL(window.location.href, window.location.origin);

                    url.search = "";

                    url.searchParams.append(
                        isMatchingItemCategory ? "CategoryId" : options.blockProperties.pageParameterKey,
                        Array.isArray(entityIdKey) ? entityIdKey.join(",") : entityIdKey ?? ""
                    );

                    if (expandedIdKeys && expandedIdKeys.length > 0) {
                        url.searchParams.append("ExpandedIds", Array.isArray(expandedIdKeys) ? expandedIdKeys.join(",") : expandedIdKeys ?? "");
                    }

                    window.location.href = url.toString();
                }
            }
        }
    }

    /**
     * Handles the updating of tree list items.
     *
     * @param newItems The new array of tree items.
     */
    async function onUpdateItems(newItems: TreeItemBag[]): Promise<void> {
        treeListItems.value = await getFormattedTreeListItems(newItems);
    }

    /**
     * Handles adding a new item (category or entity) based on the selected tree item.
     *
     * @param addingCategory Whether to add a category (true) or an entity (false).
     */
    async function onAddItem(addingCategory: boolean): Promise<void> {
        // if it is a category, it becomes the parentCategoryId in the Url params
        // if it is an entity, we use its parentCategoryId
        if (!treeListSelectedItems.value || treeListSelectedItems.value.length < 0 || treeListSelectedItems.value.length > 1) {
            return;
        }

        /** Recursively search for the selected item anywhere in the tree */
        const findItemRecursively = (items: TreeItemBag[], targetValue: string): TreeItemBag | undefined => {
            for (const item of items) {
                if (item.value === targetValue) {
                    return item;
                }
                if (item.children && item.children.length > 0) {
                    const found = findItemRecursively(item.children, targetValue);
                    if (found) {
                        return found;
                    }
                }
            }
            return undefined;
        };

        const selectedItem = treeListItems.value
            ? findItemRecursively(treeListItems.value, treeListSelectedItems.value[0])
            : undefined;

        if (!selectedItem) {
            return;
        }

        let parentCategoryIdGuid: Guid | null = null;

        if (selectedItem.type?.toLowerCase() === "category") {
            parentCategoryIdGuid = selectedItem.value ?? null;
        }
        else {
            // For entities, we need to get their parent category
            const entityGuid = selectedItem.value ?? null;
            if (entityGuid) {
                /** Recursively find the parent category of this entity */
                const findParentCategory = (items: TreeItemBag[], targetValue: string): Guid | null => {
                    for (const item of items) {
                        if (item.children && item.children.length > 0) {
                            for (const child of item.children) {
                                if (child.value === targetValue) {
                                    return item.type?.toLowerCase() === "category" ? item.value ?? null : null;
                                }
                            }
                            const foundInChildren = findParentCategory(item.children, targetValue);
                            if (foundInChildren) {
                                return foundInChildren;
                            }
                        }
                    }
                    return null;
                };
                parentCategoryIdGuid = treeListItems.value
                    ? findParentCategory(treeListItems.value, entityGuid)
                    : null;
            }
        }

        const parentCategoryId = await getIdKeysFromGuids(parentCategoryIdGuid, true);

        // If the URL does not end with a numeric segment, append "/0" before adding query params.
        let url = new URL(window.location.href);
        let pathname = url.pathname;

        url = new URL(url.origin + pathname);

        url.search = "";

        if (addingCategory) {
            // For categories, we set CategoryId to 0 instead
            url.searchParams.append("CategoryId", "0");
        }
        else {
            if (options.blockProperties && options.blockProperties.pageParameterKey) {
                url.searchParams.append(options.blockProperties.pageParameterKey, "0");
            }
        }

        if (parentCategoryId) {
            url.searchParams.append("ParentCategoryId", parentCategoryId as string);
        }

        if (treeListExpandedItems.value.length > 0) {
            const expandedIdKeys = await getIdKeysFromGuids(treeListExpandedItems.value, true);
            if (expandedIdKeys) {
                url.searchParams.append("ExpandedIds", Array.isArray(expandedIdKeys) ? expandedIdKeys.join(",") : expandedIdKeys ?? "");
            }
        }

        window.location.href = url.toString();
    }

    /**
     * Handles adding a new entity to the selected category or category of the selected entity.
     */
    async function onAddEntity(): Promise<void> {
        await onAddItem(false);
    }

    /**
     * Handles adding a new root category.
     */
    async function onAddCategoryRoot(): Promise<void> {
        let url = new URL(window.location.href);
        let pathname = url.pathname;

        url = new URL(url.origin + pathname);

        url.search = "";

        url.searchParams.append("CategoryId", "0");

        if (treeListExpandedItems.value.length > 0) {
            const expandedIdKeys = await getIdKeysFromGuids(treeListExpandedItems.value, true);
            if (expandedIdKeys) {
                url.searchParams.append("ExpandedIds", Array.isArray(expandedIdKeys) ? expandedIdKeys.join(",") : expandedIdKeys ?? "");
            }
        }

        window.location.href = url.toString();
    }

    /**
     * Handles adding a new child category to the selected category or category of the selected entity.
     */
    async function onAddCategoryChild(): Promise<void> {
        await onAddItem(true);
    }

    // #endregion Event Handlers

    // #region Block Actions

    /**
     * Gets the ID keys corresponding to the provided GUIDs.
     *
     * @param guids The GUID or array of GUIDs to convert.
     * @param areCategories Whether the GUIDs represent categories.
     * @returns A promise that resolves to the corresponding ID key(s) or null.
     */
    async function getIdKeysFromGuids(guids: Guid | Guid[] | null | undefined, areCategories: boolean): Promise<string | string[] | null> {
        if (!guids) {
            return null;
        }

        if (Array.isArray(guids) && guids.length === 0) {
            return null;
        }

        if (!Array.isArray(guids) && (guids === "" || guids === "00000000-0000-0000-0000-000000000000")) {
            return null;
        }

        let guidArray: Guid[];
        if (Array.isArray(guids)) {
            guidArray = guids;
        }
        else {
            guidArray = [guids];
        }

        const result = await invokeBlockAction<Guid[]>("GetIdKeysFromGuids", {
            guids: guidArray,
            areCategories: areCategories,
        });

        if (result.isSuccess && result.data) {
            if (Array.isArray(guids)) {
                return result.data;
            }
            else {
                return result.data[0];
            }
        }

        return null;
    }

    /**
     * Gets the friendly name of an entity type from its GUID.
     *
     * @param guid The GUID of the entity type.
     * @returns A promise that resolves to the friendly name of the entity type.
     */
    async function getEntityTypeFriendlyNameFromGuid(guid: string | null | undefined): Promise<string> {
        if (!guid) {
            return "";
        }
        const result = await invokeBlockAction<string>("GetEntityTypeFriendlyNameFromGuid", {
            entityTypeGuid: guid
        });
        if (result.isSuccess && result.data) {
            return result.data;
        }
        return "";
    }

    /**
     * Sets a person preference.
     *
     * @param preference The preference key to set.
     * @param value The value to set for the preference.
     */
    async function setPersonPreference(preference: PersonPreferenceKey, value: boolean): Promise<void> {
        await invokeBlockAction<boolean>("SetPersonPreference", {
            preference: preference,
            value: value
        });
    }

    // #endregion Block Actions

    if (box.errorMessage) {
        blockError.value = box.errorMessage;
    }

    onBeforeMount(async () => {
        setPanelName();
        await setTreeListItems();
        isTreeListDataInitialized.value = true;
    });

    onConfigurationValuesChanged(useReloadBlock());
</script>
