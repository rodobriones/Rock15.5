<template>
    <Panel type="block" title="">
        <template #default>
            <div class="cyWrap">
                <div class="cyScreen">
                    <!-- Overlays: Estados de carga y exito -->
                    <div v-if="busy || successMessage" class="cyStateOverlay">
                        <!-- Estado de carga -->
                        <div v-if="busy" class="cyStateModal cyLoadingModal">
                            <div class="cySpinner"></div>
                            <h4 class="cyStateTitle">Procesando donación</h4>
                            <p class="cyStateText">Por favor, no cierre esta ventana.</p>
                        </div>

                        <!-- Estado de exito -->
                        <div v-else-if="successMessage" class="cyStateModal cySuccessModal">
                            <div class="cySuccessIcon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                  <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <h4 class="cyStateTitle">¡Gracias por su donación!</h4>
                            <p class="cyStateText">{{ successMessage }}</p>
                            <div class="cyStateActions">
                                <button type="button" class="cyStateBtnPrimary" @click.prevent="resetFormSuccess">Hacer otra donación</button>
                                <button v-if="!config.notLogged" type="button" class="cyStateBtnSecondary" @click.prevent="goToHistoryFromSuccess">Ver historial</button>
                            </div>
                        </div>
                    </div>

                    <header class="cyTopBar">
                        <div class="cyTopBrand">
                            <span class="cyTopLogo">DAR</span>
                        </div>
                        <div class="cyTopMeta" :class="config.mode === 'live' ? 'isLive' : 'isTest'">
                            {{ config.mode === "live" ? "Live" : "Test" }}
                        </div>
                    </header>

                    <section class="cyAmountHero">
                        <div class="cyTopTabs" role="tablist" aria-label="Secciones de pago">
                            <button
                                type="button"
                                class="cyTopTabBtn"
                                :class="{ isActive: activeSubmenu === 'donation' }"
                                @click="activeSubmenu = 'donation'">
                                Donación
                            </button>
                            <button
                                v-if="!config.notLogged"
                                type="button"
                                class="cyTopTabBtn"
                                :class="{ isActive: activeSubmenu === 'history' }"
                                @click="activeSubmenu = 'history'; loadHistory()">
                                Historial
                            </button>
                        </div>

                        <div v-show="activeSubmenu === 'donation'">
                            <div class="cyAmountValue">
                                <span class="cyAmountCurrency">{{ normalizeCurrency(form.currency) === "GTQ" ? "Q" : "$" }}</span>
                                <input
                                    :value="heroAmountInputDisplay"
                                    class="cyAmountNumberInput"
                                    :class="{ isInvalid: !!fieldErrors.amount }"
                                    :style="{ width: heroAmountInputWidth }"
                                    type="text"
                                    inputmode="numeric"
                                    placeholder="0.00"
                                    aria-label="Monto de donación"
                                    @input="onHeroAmountInput" />
                            </div>
                            <div class="cyHeroControls">
                                <div class="cyCurrencySwitch" role="group" aria-label="Seleccionar moneda">
                                    <button
                                        type="button"
                                        class="cyCurrencyBtn"
                                        :class="{ isActive: form.currency === 'GTQ' }"
                                        @click.prevent="switchCurrency('GTQ')">
                                        GTQ
                                    </button>
                                    <button
                                        type="button"
                                        class="cyCurrencyBtn"
                                        :class="{ isActive: form.currency === 'USD' }"
                                        @click.prevent="switchCurrency('USD')">
                                        USD
                                    </button>
                                </div>
                            </div>

                            <div v-if="Number(form.amount || 0) <= 0 || fieldErrors.amount || fieldErrors.currency" class="cyAmountAlert">
                                {{ fieldErrors.amount || fieldErrors.currency || "Ingrese el monto" }}
                            </div>
                        </div>
                    </section>

                    <div class="cyStage">
                        <section class="cyMainCard">
                            <!-- Seccion de tipo de regalo: oculta temporalmente -->
                            <div class="cyPromptRow" v-show="false">
                                <p class="cyPromptLabel">Tipo de regalo</p>
                                <div class="cyGiftToggle" role="group" aria-label="Tipo de regalo">
                                    <button type="button" class="cyGiftBtn isActive" @click.prevent>Dar una vez</button>
                                    <button type="button" class="cyGiftBtn" @click.prevent>Configurar recurrente</button>
                                </div>
                            </div>



                            <div v-show="activeSubmenu === 'donation'">
                                <section class="cySection">
                                    <div class="cySectionHead">
                                        <h4 class="cySectionTitle">Datos de donación</h4>
                                        <p class="cySectionText">Seleccione fondo y agregue una nota opcional.</p>
                                    </div>

                                    <div class="cyGrid">
                                        <div class="cyField cyWide">
                                            <span>Tipo</span>
                                            <div class="cyDropdown" :class="{ isInvalid: !!fieldErrors.accountId, isOpen: accountDropdownOpen }" v-click-outside="() => accountDropdownOpen = false">
                                                <button type="button" class="cyDropdownTrigger" @click="accountDropdownOpen = !accountDropdownOpen">
                                                    <span :class="{ cyDropdownPlaceholder: form.accountId === 0 }">
                                                        {{ form.accountId === 0 ? 'Selecciona un tipo...' : accounts.find(a => a.id === form.accountId)?.publicName }}
                                                    </span>
                                                    <svg class="cyDropdownChevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
                                                    </svg>
                                                </button>
                                                <div v-if="accountDropdownOpen" class="cyDropdownMenu">
                                                    <button
                                                        v-for="a in accounts"
                                                        :key="a.id"
                                                        type="button"
                                                        class="cyDropdownItem"
                                                        :class="{ isSelected: form.accountId === a.id }"
                                                        @click="form.accountId = a.id; fieldErrors.accountId = ''; accountDropdownOpen = false">
                                                        <span>{{ a.publicName }}</span>
                                                        <svg v-if="form.accountId === a.id" class="cyAccountCheck" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                                            <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            </div>
                                            <small v-if="fieldErrors.accountId" class="cyFieldError">{{ fieldErrors.accountId }}</small>
                                        </div>

                                        <label class="cyField cyWide">
                                            <span>Nota (opcional)</span>
                                            <input
                                                v-model="form.note"
                                                class="form-control"
                                                :class="{ isInvalid: !!fieldErrors.note }"
                                                type="text"
                                                maxlength="250"
                                                placeholder="Ejemplo: Ofrenda especial"
                                                @input="fieldErrors.note = ''" />
                                            <small v-if="fieldErrors.note" class="cyFieldError">{{ fieldErrors.note }}</small>
                                        </label>
                                    </div>
                                </section>

                                <section class="cySection">
                                    <div class="cySectionHead">
                                        <h4 class="cySectionTitle">Tarjeta</h4>
                                        <p class="cySectionText">Complete la información de pago segura.</p>
                                    </div>

                                    <div class="cyCardInputs">
                                        <label class="cyCardField">
                                            <span>Número de tarjeta</span>
                                            <div class="cyInputWrap" :class="{ isInvalid: !!fieldErrors.cardNumber }">
                                                <input
                                                    v-model="form.cardNumber"
                                                    class="cyInput"
                                                    type="text"
                                                    maxlength="24"
                                                    inputmode="numeric"
                                                    autocomplete="cc-number"
                                                    placeholder="4111 1111 1111 1111"
                                                    @input="onCardNumberInput" />
                                                <span class="cyCardBrandTag" :class="`brand-${cardBrand}`">{{ cardBrandLabel }}</span>
                                            </div>
                                            <small v-if="fieldErrors.cardNumber" class="cyFieldError">{{ fieldErrors.cardNumber }}</small>
                                        </label>

                                        <div class="cyCardRow">
                                            <label class="cyCardField">
                                                <span>Vencimiento</span>
                                                <div class="cyInputWrap" :class="{ isInvalid: !!fieldErrors.expDate }">
                                                    <input
                                                        v-model="form.expDate"
                                                        class="cyInput"
                                                        type="text"
                                                        maxlength="5"
                                                        inputmode="numeric"
                                                        autocomplete="cc-exp"
                                                        placeholder="MM/AA"
                                                        @input="onExpDateInput" />
                                                </div>
                                                <small class="cyFieldHint">Formato: 05/30</small>
                                                <small v-if="fieldErrors.expDate" class="cyFieldError">{{ fieldErrors.expDate }}</small>
                                            </label>

                                            <label class="cyCardField">
                                                <span>CVV*</span>
                                                <div class="cyInputWrap" :class="{ isInvalid: !!fieldErrors.cvv }">
                                                    <input
                                                        v-model="form.cvv"
                                                        class="cyInput"
                                                        type="password"
                                                        maxlength="4"
                                                        inputmode="numeric"
                                                        autocomplete="cc-csc"
                                                        :placeholder="`CVV (${expectedCvvLength})`"
                                                        @input="onCvvInput" />
                                                </div>
                                                <small class="cyFieldHint">{{ expectedCvvLength }} dígitos de seguridad</small>
                                                <small v-if="fieldErrors.cvv" class="cyFieldError">{{ fieldErrors.cvv }}</small>
                                            </label>
                                        </div>

                                        <label class="cyCardField">
                                            <span>Nombre del tarjetahabiente</span>
                                            <div class="cyInputWrap" :class="{ isInvalid: !!fieldErrors.cardName }">
                                                <input
                                                    v-model="form.cardName"
                                                    class="cyInput"
                                                    type="text"
                                                    maxlength="120"
                                                    autocomplete="cc-name"
                                                    placeholder="Nombre como aparece en la tarjeta"
                                                    @input="fieldErrors.cardName = ''" />
                                            </div>
                                            <small v-if="fieldErrors.cardName" class="cyFieldError">{{ fieldErrors.cardName }}</small>
                                        </label>

                                    </div>
                                </section>

                                <!-- Seccion de recibo fiscal (NIT) -->
                                <section class="cySection cyReceiptSection">
                                    <div class="cyReceiptToggle">
                                        <div class="cyReceiptText">
                                            <h4 class="cyReceiptTitle">¿Desea su recibo de donación?</h4>
                                            <p class="cyReceiptDesc">Active esta opción para ingresar su NIT.</p>
                                        </div>
                                        <label class="cySwitch">
                                            <input type="checkbox" v-model="form.wantsReceipt">
                                            <span class="cySlider"></span>
                                        </label>
                                    </div>
                                    
                                    <div v-show="form.wantsReceipt" class="cyReceiptForm">
                                        <div class="cyNitRow">
                                            <label class="cyField cyNitInput">
                                                <span>NIT</span>
                                                <input
                                                    v-model="form.nit"
                                                    class="form-control"
                                                    :class="{ isInvalid: !!fieldErrors.nit }"
                                                    type="text"
                                                    inputmode="text"
                                                    placeholder="Ej: 12345678"
                                                    @input="onNitInput" />
                                            </label>
                                            
                                            <RockButton class="cyValidateBtn" btnType="default" :disabled="busyNit || !form.nit" @click="validateNit">
                                                {{ busyNit ? "Validando..." : "Validar NIT" }}
                                            </RockButton>
                                        </div>
                                        <small v-if="fieldErrors.nit" class="cyFieldError" style="display: block; margin-top: -8px; margin-bottom: 12px;">{{ fieldErrors.nit }}</small>
                                        
                                        <!-- Datos de solo lectura obtenidos del NIT -->
                                        <div v-if="form.nitName || form.nitAddress" class="cyNitResult">
                                            <label class="cyField">
                                                <span>Nombre / Razón Social</span>
                                                <input
                                                    v-model="form.nitName"
                                                    class="form-control"
                                                    type="text"
                                                    readonly
                                                    disabled />
                                            </label>
                                            
                                            <label class="cyField" v-if="form.nitAddress">
                                                <span>Dirección</span>
                                                <input
                                                    v-model="form.nitAddress"
                                                    class="form-control"
                                                    type="text"
                                                    readonly
                                                    disabled />
                                            </label>
                                        </div>
                                    </div>
                                </section>

                                <!-- Campo de correo electrónico -->
                                <section class="cySection">
                                    <div class="cyGrid">
                                        <label class="cyField cyWide">
                                            <span>Correo Electrónico *</span>
                                            <input
                                                v-model="form.donorEmail"
                                                class="form-control"
                                                :class="{ isInvalid: !!fieldErrors.donorEmail }"
                                                type="email"
                                                maxlength="200"
                                                inputmode="email"
                                                autocomplete="email"
                                                placeholder="tu@correo.com"
                                                @input="fieldErrors.donorEmail = ''" />
                                            <small class="cyFieldHint">
                                                Nota: A este correo se enviará tu confirmación de donación<span v-if="form.wantsReceipt && form.nitName"> y recibo de donación</span>.
                                            </small>
                                            <small v-if="fieldErrors.donorEmail" class="cyFieldError">{{ fieldErrors.donorEmail }}</small>
                                        </label>
                                    </div>
                                </section>

                                <div class="cyActions">
                                    <RockButton btnType="primary" :disabled="busy || (form.wantsReceipt && !form.nitName)" @click="openConfirmModal">
                                        Donar
                                    </RockButton>
                                    <p class="cyActionMeta">*Nota: No se guardará la información de su tarjeta.</p>
                                </div>

                                <NotificationBox v-if="errorMessage" alertType="danger" class="cyAlert">
                                    {{ errorMessage }}
                                </NotificationBox>

                            </div>

                            <section v-show="activeSubmenu === 'history'" class="cyHistoryCard cyHistoryPanel">
                                <div class="cyHistoryHeader">
                                    <h4 class="cyHistoryTitle">Mi historial de pagos</h4>
                                    <RockButton btnType="default" :disabled="busyHistory" @click="loadHistory">
                                        {{ busyHistory ? "Cargando..." : "Actualizar" }}
                                    </RockButton>
                                </div>

                                <div v-if="history.length === 0" class="cyEmpty">No se encontraron pagos Cybersource.</div>

                                <div v-else class="cyHistoryList">
                                    <div v-for="item in history" :key="item.transactionId" class="cyHistoryItem">
                                        <!-- Fila superior: fecha + estado -->
                                        <div class="cyHistoryItemTop">
                                            <span class="cyHistoryDate">{{ formatDate(item.transactionDateTime) }}</span>
                                            <span class="cyStatusBadge" :class="statusClass(item.status)">{{ item.status || "-" }}</span>
                                        </div>
                                        <!-- Fila media: monto + fondo -->
                                        <div class="cyHistoryItemMid">
                                            <span class="cyHistoryAmount">{{ formatMoney(item.amount, item.currency) }}</span>
                                            <span class="cyHistoryFondo">{{ item.accountName || "-" }}</span>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </section>
                    </div>
                </div>
            </div>
        <!-- Modal de confirmación de donación -->
        <Teleport to="body">
            <div v-if="showConfirmModal" class="cyConfirmOverlay" @click.self="showConfirmModal = false">
                <div class="cyConfirmModal">
                    <h3 class="cyConfirmTitle">Confirmar donación</h3>
                    <p class="cyConfirmSubtitle">Revisa los detalles antes de proceder.</p>

                    <div class="cyConfirmRows">
                        <div class="cyConfirmRow">
                            <span class="cyConfirmLabel">Cuenta</span>
                            <span class="cyConfirmValue">{{ accounts.find(a => a.id === form.accountId)?.publicName }}</span>
                        </div>
                        <div class="cyConfirmRow cyConfirmRowHighlight">
                            <span class="cyConfirmLabel">Monto</span>
                            <span class="cyConfirmValue cyConfirmAmount">{{ amountPreview }}</span>
                        </div>
                        <div class="cyConfirmRow">
                            <span class="cyConfirmLabel">Tarjeta</span>
                            <span class="cyConfirmValue">{{ cardBrandLabel }} {{ cardPreviewNumber }}</span>
                        </div>
                        <div class="cyConfirmRow">
                            <span class="cyConfirmLabel">Titular</span>
                            <span class="cyConfirmValue">{{ form.cardName }}</span>
                        </div>
                        <div v-if="form.note" class="cyConfirmRow">
                            <span class="cyConfirmLabel">Nota</span>
                            <span class="cyConfirmValue">{{ form.note }}</span>
                        </div>
                    </div>

                    <div class="cyConfirmActions">
                        <button type="button" class="cyConfirmCancel" @click="showConfirmModal = false">Cancelar</button>
                        <button type="button" class="cyConfirmSubmit" :disabled="busy" @click="confirmAndSubmit">
                            {{ busy ? "Procesando..." : "Confirmar donación" }}
                        </button>
                    </div>

                    <p class="cyConfirmNote">*No se guardará la información de su tarjeta.</p>
                </div>
            </div>
        </Teleport>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, reactive, ref, type DirectiveBinding } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

// Marca de tarjeta detectada por BIN
type CardBrand = "visa" | "mastercard" | "amex" | "discover" | "unknown";

// Opción de cuenta financiera para el dropdown
type AccountOptionBag = {
    id: number;
    publicName: string;
};

// Registro del historial de pagos Cybersource
type PaymentHistoryBag = {
    transactionId: number;
    transactionDateTime: string;
    amount: number;
    accountName: string;
    transactionCode: string;
    responseCode: string;
    status: string;
    statusMessage: string;
    referenceNumber: string;
    auditNumber: string;
    authorizationNumber: string;
    currency: string;
    mode: string;
    accountNumberMasked: string;
    summary: string;
};

// Datos iniciales del bloque enviados desde el servidor C#
type InitBag = {
    notLogged: boolean;
    defaultCurrency: string;
    mode: string;
    accounts: AccountOptionBag[];
    history: PaymentHistoryBag[];
    currentPersonEmail: string;
};

// Resultado devuelto por la acción ProcessPayment del backend
type ProcessPaymentResult = {
    success: boolean;
    message: string;
    responseCode: string;
    authorizationNumber: string;
    referenceNumber: string;
    auditNumber: string;
    currency: string;
    mode: string;
    transactionId?: number;
    history: PaymentHistoryBag[];
};

// Resultado del parseo de fecha de vencimiento MM/YY
type ExpiryParse = {
    month: number;
    year: number;
    valid: boolean;
};

// ========================
// INICIALIZACIÓN DEL BLOQUE
// ========================
const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

// Listas de datos del servidor
const accounts = ref<AccountOptionBag[]>(config.accounts || []);
const history = ref<PaymentHistoryBag[]>(config.history || []);

// Estados de UI
const busy = ref(false);                                    // Procesando pago
const busyHistory = ref(false);                             // Cargando historial
const errorMessage = ref("");                               // Mensaje de error global
const successMessage = ref("");                             // Mensaje de éxito (activa modal)
const lastResult = ref<ProcessPaymentResult | null>(null);  // Último resultado de pago
const activeSubmenu = ref<"donation" | "history">("donation"); // Pestaña activa
const showConfirmModal = ref(false);                        // Modal de confirmación

// Errores individuales por campo del formulario
const fieldErrors = reactive({
    accountId: "",
    amount: "",
    currency: "",
    note: "",
    cardName: "",
    cardNumber: "",
    expDate: "",
    cvv: "",
    nit: "",
    donorEmail: ""
});

// Datos del formulario de donación
const form = reactive({
    accountId: accounts.value.length > 0 ? accounts.value[0].id : 0,
    amount: 0,
    note: "",
    currency: (config.defaultCurrency || "GTQ").toUpperCase(),
    cardName: "",
    cardNumber: "",
    expDate: "",
    cvv: "",
    wantsReceipt: false,   // Si el usuario quiere recibo fiscal
    nit: "",               // NIT ingresado
    nitName: "",           // Nombre/razón social obtenida de la SAT
    nitAddress: "",        // Dirección obtenida de la SAT
    donorEmail: (config.currentPersonEmail || "").trim()
});

// Clave de idempotencia para evitar cobros duplicados
const idemKey = ref(generateIdemKey());

// Estado del dropdown de cuentas
const accountDropdownOpen = ref(false);

// Directiva v-click-outside para cerrar el dropdown al hacer clic fuera
const vClickOutside = {
    mounted(el: HTMLElement, binding: DirectiveBinding) {
        (el as any)._clickOutsideHandler = (event: MouseEvent) => {
            if (!el.contains(event.target as Node)) {
                binding.value();
            }
        };
        document.addEventListener("click", (el as any)._clickOutsideHandler, true);
    },
    unmounted(el: HTMLElement) {
        document.removeEventListener("click", (el as any)._clickOutsideHandler, true);
    }
};

/** Genera una clave única combinando timestamp base36 + aleatorio */
function generateIdemKey(): string {
    return Date.now().toString(36) + Math.random().toString(36).substring(2, 7);
}

// ========================
// PROPIEDADES COMPUTADAS
// ========================

// Valor en centavos — fuente de verdad del monto (comportamiento banco/ATM)
const centValue = ref(0);

// Texto visible derivado de centavos: 1234 → "12.34"
const heroAmountInputDisplay = computed(() =>
    centValue.value === 0 ? "" : (centValue.value / 100).toFixed(2)
);

// Ancho dinámico del input hero (en ch)
const heroAmountInputWidth = computed(() => {
    const text = heroAmountInputDisplay.value || "0.00";
    const widthInCh = Math.min(Math.max(text.length + 0.5, 4.5), 12);
    return `${widthInCh}ch`;
});

// Solo dígitos del número de tarjeta (sin espacios)
const cardNumberDigits = computed(() => (form.cardNumber || "").replace(/[^\d]/g, ""));

// Marca detectada según los primeros dígitos (BIN)
const cardBrand = computed<CardBrand>(() => detectCardBrand(cardNumberDigits.value));

// Nombre legible de la marca de tarjeta
const cardBrandLabel = computed<string>(() => {
    if (cardBrand.value === "visa") return "Visa";
    if (cardBrand.value === "mastercard") return "Mastercard";
    if (cardBrand.value === "amex") return "American Express";
    if (cardBrand.value === "discover") return "Discover";
    return "Tarjeta";
});

// Longitud esperada del CVV según la marca (Amex=4, resto=3)
const expectedCvvLength = computed<number>(() => (cardBrand.value === "amex" ? 4 : 3));

// Vista previa del monto formateado con símbolo de moneda
const amountPreview = computed<string>(() => {
    return formatMoney(form.amount, form.currency);
});

// Vista previa del número de tarjeta con espacios
const cardPreviewNumber = computed<string>(() => {
    const preview = formatCardNumberDigits(cardNumberDigits.value, cardBrand.value);
    return preview || "#### #### #### ####";
});

// Vista previa del nombre del titular en mayúsculas
const cardPreviewName = computed<string>(() => {
    const name = (form.cardName || "").trim();
    return name ? name.toUpperCase() : "NOMBRE TITULAR";
});

// Vista previa de la fecha de vencimiento
const cardPreviewExp = computed<string>(() => {
    return form.expDate || "MM/AA";
});

// ========================
// FUNCIONES DE TARJETA
// ========================

/** Detecta la marca de tarjeta según los primeros dígitos (BIN) */
function detectCardBrand(pan: string): CardBrand {
    if (!pan) return "unknown";

    if (/^4/.test(pan)) return "visa";
    if (/^(5[1-5]|2(?:2[2-9]|[3-6]\d|7[01]|720))/.test(pan)) return "mastercard";
    if (/^3[47]/.test(pan)) return "amex";
    if (/^(6011|65|64[4-9])/.test(pan)) return "discover";

    return "unknown";
}

/** Valida el número de tarjeta usando el algoritmo de Luhn */
function luhnCheck(pan: string): boolean {
    if (!/^\d{12,19}$/.test(pan)) {
        return false;
    }

    let sum = 0;
    let shouldDouble = false;

    for (let i = pan.length - 1; i >= 0; i--) {
        let digit = Number(pan.charAt(i));

        if (shouldDouble) {
            digit *= 2;
            if (digit > 9) {
                digit -= 9;
            }
        }

        sum += digit;
        shouldDouble = !shouldDouble;
    }

    return sum % 10 === 0;
}

/** Formatea los dígitos de tarjeta con espacios según la marca (Amex: 4-6-5, resto: 4-4-4-...) */
function formatCardNumberDigits(digits: string, brand: CardBrand): string {
    const max = brand === "amex" ? 15 : 19;
    const clean = digits.slice(0, max);

    if (brand === "amex") {
        const p1 = clean.slice(0, 4);
        const p2 = clean.slice(4, 10);
        const p3 = clean.slice(10, 15);
        return [p1, p2, p3].filter(Boolean).join(" ");
    }

    return clean.match(/.{1,4}/g)?.join(" ") || clean;
}

/** Parsea la fecha de vencimiento MM/YY y devuelve mes, año y si es válida */
function parseExpiry(value: string): ExpiryParse {
    const digits = (value || "").replace(/[^\d]/g, "");

    if (digits.length !== 4) {
        return { month: 0, year: 0, valid: false };
    }

    const month = Number(digits.slice(0, 2));
    const yy = Number(digits.slice(2, 4));

    if (!Number.isFinite(month) || month < 1 || month > 12) {
        return { month: 0, year: 0, valid: false };
    }

    const year = 2000 + yy;
    return { month, year, valid: true };
}

/** Verifica si la tarjeta ya venció comparando con la fecha actual */
function isExpired(month: number, year: number): boolean {
    const now = new Date();
    const currentMonth = now.getMonth() + 1;
    const currentYear = now.getFullYear();

    if (year < currentYear) {
        return true;
    }

    if (year === currentYear && month < currentMonth) {
        return true;
    }

    return false;
}

// ========================
// HANDLERS DE INPUTS
// ========================

/** Limpia datos sensibles de tarjeta del formulario y sus errores de campo */
function clearSensitive(): void {
    form.cardNumber = "";
    form.expDate = "";
    form.cvv = "";
    fieldErrors.cardNumber = "";
    fieldErrors.expDate = "";
    fieldErrors.cvv = "";
}

/** Formatea el número de tarjeta mientras el usuario escribe */
function onCardNumberInput(): void {
    fieldErrors.cardNumber = "";
    const digits = (form.cardNumber || "").replace(/[^\d]/g, "");
    const brand = detectCardBrand(digits);
    form.cardNumber = formatCardNumberDigits(digits, brand);
}

/** Formatea la fecha de vencimiento con slash automático (MM/YY) */
function onExpDateInput(): void {
    fieldErrors.expDate = "";

    const digits = (form.expDate || "").replace(/[^\d]/g, "").slice(0, 4);
    if (digits.length <= 2) {
        form.expDate = digits;
        return;
    }

    form.expDate = `${digits.slice(0, 2)}/${digits.slice(2)}`;
}

/** Cambia la moneda y resetea el monto a 0 */
function switchCurrency(currency: string): void {
    if (form.currency === currency) return;
    form.currency = currency;
    form.amount = 0;
    centValue.value = 0;
    fieldErrors.currency = "";
    fieldErrors.amount = "";
}

/** Limita el CVV a solo dígitos (máx 4) */
function onCvvInput(): void {
    fieldErrors.cvv = "";
    form.cvv = (form.cvv || "").replace(/[^\d]/g, "").slice(0, 4);
}

/** Limpia caracteres especiales del NIT. Permite letras (ej: K) y números.
 *  Si el usuario edita el NIT, se limpian los datos validados previamente. */
function onNitInput(): void {
    fieldErrors.nit = "";
    form.nit = (form.nit || "").replace(/[^0-9a-zA-Z]/g, "").toUpperCase();

    // Limpiar datos validados si el usuario modifica el NIT
    form.nitName = "";
    form.nitAddress = "";
}

/** Comportamiento banco/ATM: los dígitos empujan desde la derecha en centavos.
 *  Escribir "5" con "12.34" visible → "1.235" → cents=1235 → display "12.35". */
function onHeroAmountInput(event: Event): void {
    fieldErrors.amount = "";
    const input = event.target as HTMLInputElement;

    // Extraer solo dígitos de lo que el browser tiene ahora
    const digits = input.value.replace(/\D/g, "");
    const cents = Math.min(parseInt(digits || "0", 10), 99999999); // máx 999,999.99

    centValue.value = cents;
    form.amount = cents / 100;

    // Forzar valor formateado y cursor al final
    const display = cents === 0 ? "" : (cents / 100).toFixed(2);
    input.value = display;
    input.setSelectionRange(display.length, display.length);
}

// ========================
// VALIDACIÓN DEL FORMULARIO
// ========================

/** Limpia todos los errores de campo */
function clearAllFieldErrors(): void {
    fieldErrors.accountId = "";
    fieldErrors.amount = "";
    fieldErrors.currency = "";
    fieldErrors.note = "";
    fieldErrors.cardName = "";
    fieldErrors.cardNumber = "";
    fieldErrors.expDate = "";
    fieldErrors.cvv = "";
    fieldErrors.nit = "";
    fieldErrors.donorEmail = "";
}

/** Hace scroll suave al primer campo con error visible */
function scrollToFirstError(): void {
    setTimeout(() => {
        const el = document.querySelector(".cyFieldError, .cyAmountAlert, .isInvalid");
        if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    }, 50);
}

/** Valida todos los campos del formulario. Retorna true si todo es válido. */
function validateForm(): boolean {
    clearAllFieldErrors();

    let isValid = true;

    if (!Number.isFinite(form.accountId) || form.accountId <= 0) {
        fieldErrors.accountId = "Seleccione una cuenta.";
        isValid = false;
    }

    if (!Number.isFinite(form.amount) || Number(form.amount) <= 0) {
        fieldErrors.amount = "Ingrese un monto válido mayor a cero.";
        isValid = false;
    }

    if (form.wantsReceipt) {
        if (!form.nit || form.nit.trim() === "") {
            fieldErrors.nit = "Ingrese un número de NIT.";
            isValid = false;
        } else if (!form.nitName) {
            fieldErrors.nit = "Valide el NIT antes de continuar.";
            isValid = false;
        }
    }

    const emailTrimmed = (form.donorEmail || "").trim();
    if (!emailTrimmed) {
        fieldErrors.donorEmail = "El correo electrónico es requerido.";
        isValid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailTrimmed)) {
        fieldErrors.donorEmail = "Ingrese un correo electrónico válido.";
        isValid = false;
    }

    if (form.currency !== "GTQ" && form.currency !== "USD") {
        fieldErrors.currency = "Solo se permite GTQ o USD.";
        isValid = false;
    }

    if ((form.note || "").length > 250) {
        fieldErrors.note = "Máximo 250 caracteres.";
        isValid = false;
    }

    if ((form.cardName || "").trim().length < 3) {
        fieldErrors.cardName = "Ingrese el nombre del titular.";
        isValid = false;
    }

    if (!luhnCheck(cardNumberDigits.value)) {
        fieldErrors.cardNumber = "Número de tarjeta inválido.";
        isValid = false;
    }

    const expiry = parseExpiry(form.expDate);
    if (!expiry.valid) {
        fieldErrors.expDate = "Usa el formato MM/AA.";
        isValid = false;
    } else if (isExpired(expiry.month, expiry.year)) {
        fieldErrors.expDate = "La tarjeta está vencida.";
        isValid = false;
    }

    const cvv = (form.cvv || "").replace(/[^\d]/g, "");
    const validCvvLength = cardBrand.value === "amex" ? cvv.length === 4 : cvv.length === 3;
    if (!validCvvLength) {
        fieldErrors.cvv = `El CVV debe tener ${expectedCvvLength.value} dígitos.`;
        isValid = false;
    }

    return isValid;
}

// ========================
// ACCIONES PRINCIPALES
// ========================

/** Valida el formulario y abre el modal de confirmación */
function openConfirmModal(): void {
    errorMessage.value = "";
    if (!validateForm()) {
        errorMessage.value = "Corrija los campos resaltados para proceder.";
        scrollToFirstError();
        return;
    }
    showConfirmModal.value = true;
}

/** Confirma desde el modal y ejecuta el pago */
async function confirmAndSubmit(): Promise<void> {
    showConfirmModal.value = false;
    await submitPayment();
}

/** Envía el pago al backend Cybersource. Usa clave de idempotencia para evitar cobros duplicados. */
async function submitPayment(): Promise<void> {
    if (busy.value) {
        return;
    }

    errorMessage.value = "";
    successMessage.value = "";

    if (!validateForm()) {
        errorMessage.value = "Corrija los campos resaltados para procesar.";
        scrollToFirstError();
        return;
    }

    const expiry = parseExpiry(form.expDate);
    if (!expiry.valid) {
        errorMessage.value = "Fecha de vencimiento inválida.";
        return;
    }

    busy.value = true;

    try {
        const response = await invokeBlockAction<any>("ProcessPayment", {
            bag: {
                accountId: Number(form.accountId || 0),
                amount: Number(form.amount || 0),
                note: (form.note || "").trim(),
                currency: (form.currency || "GTQ").toUpperCase(),
                cardName: (form.cardName || "").trim(),
                cardNumber: cardNumberDigits.value,
                expMonth: expiry.month,
                expYear: expiry.year,
                cvv: (form.cvv || "").trim(),
                wantsReceipt: form.wantsReceipt,
                nit: form.wantsReceipt ? form.nit : "",
                nitName: form.wantsReceipt ? form.nitName : "",
                nitAddress: form.wantsReceipt ? form.nitAddress : "",
                donorEmail: (form.donorEmail || "").trim(),
                idemKey: idemKey.value
            }
        });

        if (!response.isSuccess) {
            errorMessage.value = response.errorMessage || "La solicitud de pago falló.";
            return;
        }

        const data = response.data as ProcessPaymentResult;
        lastResult.value = data;
        history.value = data.history || [];

        if (data.success) {
            successMessage.value = data.message || "Pago aprobado.";
            form.note = "";
            idemKey.value = generateIdemKey(); // Nueva clave para el proximo pago
        } else {
            errorMessage.value = data.message || "El pago no pudo ser procesado. Intenta de nuevo o usa otra tarjeta.";

            // Limpiar errores de campo anteriores antes de establecer los nuevos,
            // para que no queden pegados si el usuario reintenta sin tocar los campos.
            fieldErrors.cardNumber = "";
            fieldErrors.expDate = "";
            fieldErrors.cvv = "";

            // Resaltar el campo específico que causó el rechazo para guiar al usuario.
            const rc = data.responseCode || "";
            if (rc === "INVALID_CVN" || rc === "CV_FAILED") {
                fieldErrors.cvv = "Código de seguridad incorrecto.";
            } else if (rc === "INVALID_EXPIRY_DATE" || rc === "EXPIRED_CARD") {
                fieldErrors.expDate = "Fecha de vencimiento inválida o tarjeta vencida.";
            } else if (rc === "INVALID_ACCOUNT" || rc === "INVALID_NUMBER" || rc === "INVALID_CARD_NUMBER") {
                fieldErrors.cardNumber = "Número de tarjeta inválido.";
            }

            // Regenerar idemKey solo para errores de input/validación (reintento seguro).
            // Para timeouts u estados desconocidos, mantener la clave para que el backend
            // evite doble cobro si la solicitud original ya fue procesada.
            const safeRetry = new Set([
                "INVALID_INPUT", "DECLINED", "CONFIG",
                "INVALID_CVN", "CV_FAILED",
                "INVALID_ACCOUNT", "INVALID_NUMBER", "INVALID_CARD_NUMBER",
                "INVALID_EXPIRY_DATE", "EXPIRED_CARD",
                "INSUFFICIENT_FUND", "INSUFFICIENT_FUNDS",
                "CREDIT_LIMIT_REACHED", "EXCEEDS_CREDIT_LIMIT",
                "CARD_VELOCITY_EXCEEDED",
                "INVALID_DATA", "MISSING_FIELD", "INVALID_REQUEST",
                "AVS_FAILED", "FRAUD_SCORE_EXCEEDS_THRESHOLD",
                "GENERAL_DECLINE", "PROCESSOR_DECLINED", "DO_NOT_HONOR"
            ]);
            if (safeRetry.has(rc)) {
                idemKey.value = generateIdemKey();
            }
        }
    } catch {
        errorMessage.value = "Error inesperado al procesar el pago.";
        // En error de red del cliente, NO regeneramos la clave intencionalmente
        // para que un reintento inmediato actue idempotentemente en el backend.
    } finally {
        busy.value = false;
        clearSensitive();
    }
}

/** Carga el historial de pagos del usuario desde el backend */
async function loadHistory(): Promise<void> {
    if (busyHistory.value) {
        return;
    }

    busyHistory.value = true;

    try {
        const response = await invokeBlockAction<any>("GetPaymentHistory", {});
        if (response.isSuccess) {
            history.value = response.data?.history || [];
        }
    } finally {
        busyHistory.value = false;
    }
}

/** Reinicia el formulario después de un pago exitoso para hacer otra donación */
function resetFormSuccess(): void {
    successMessage.value = "";
    lastResult.value = null;
    form.amount = 0;
    centValue.value = 0;
    form.note = "";
    clearAllFieldErrors();
    activeSubmenu.value = "donation";
    idemKey.value = generateIdemKey();
    window.scrollTo({ top: 0, behavior: "smooth" });
}

/** Navega al historial desde el modal de éxito */
function goToHistoryFromSuccess(): void {
    successMessage.value = "";
    activeSubmenu.value = "history";
    loadHistory();
}

// ========================
// VALIDACIÓN DE NIT (SAT Guatemala)
// ========================

const busyNit = ref(false);

/** Valida el NIT contra el servicio de la SAT y obtiene nombre/dirección */
async function validateNit(): Promise<void> {
    if (busyNit.value || !form.nit) {
        return;
    }
    
    busyNit.value = true;
    fieldErrors.nit = "";
    
    try {
        const response = await invokeBlockAction<any>("ValidateNitInfo", {
            nit: form.nit
        });
        
        if (response.isSuccess && response.data?.name) {
            form.nitName = response.data.name;
            form.nitAddress = response.data.address || "";
        } else {
            fieldErrors.nit = response.errorMessage || "NIT inválido o no encontrado.";
            form.nitName = "";
            form.nitAddress = "";
        }
    } catch {
        fieldErrors.nit = "Error de conexión al validar NIT.";
        form.nitName = "";
        form.nitAddress = "";
    } finally {
        busyNit.value = false;
    }
}

// ========================
// FUNCIONES DE FORMATO
// ========================

/** Formatea fecha ISO a dd/mm/yyyy */
function formatDate(value: string): string {
    if (!value) {
        return "-";
    }

    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
        return value;
    }

    const d = String(date.getDate()).padStart(2, "0");
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const y = date.getFullYear();
    const h = String(date.getHours()).padStart(2, "0");
    const min = String(date.getMinutes()).padStart(2, "0");
    return `${d}/${m}/${y} ${h}:${min}`;
}

/** Normaliza el código de moneda a GTQ o USD */
function normalizeCurrency(value?: string): string {
    const upper = String(value || form.currency || "USD").toUpperCase();
    return upper === "GTQ" ? "GTQ" : "USD";
}

/** Formatea un monto con símbolo de moneda (Q para GTQ, $ para USD) */
function formatMoney(value: number, currencyCode?: string): string {
    const amount = Number(value || 0);
    const currency = normalizeCurrency(currencyCode);

    const numStr = amount.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    return currency === "GTQ" ? `Q${numStr}` : `$${numStr}`;
}

/** Retorna la clase CSS según el estado del pago (aprobado, rechazado, neutro) */
function statusClass(status?: string): string {
    const s = String(status || "").toUpperCase();

    if (s === "APPROVED" || s === "SUCCESS" || s === "COMPLETED") {
        return "isGood";
    }

    if (s === "DECLINED" || s === "FAILED" || s === "REJECTED") {
        return "isBad";
    }

    return "isNeutral";
}

</script>

