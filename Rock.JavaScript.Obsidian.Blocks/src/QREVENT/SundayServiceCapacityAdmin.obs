.caPage .btn-primary { background-color: #272B32 !important; border-color: #272B32 !important; font-weight: 700; }
.caPage .btn-primary:hover { background-color: #1a1d22 !important; border-color: #1a1d22 !important; }

/* Toast */
.caToast {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 10000;
    max-width: 420px;
    width: calc(100% - 24px);
