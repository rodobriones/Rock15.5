<template>
    <Panel type="block" title="Cupos Servicios Dominicales" :hasNoBodyPadding="true">
        <template #default>
            <div class="caPage">
                <div class="caTopBar">
                    <div class="caBrand">Disponibilidad · Servicios Dominicales</div>
                    <!-- Segmentado propio: TabbedBar de Rock mide su ancho para decidir qué
                         pestañas caben y, dentro de un flex que se encoge al contenido, concluía
                         que no cabía ninguna y escondía «Métricas» bajo un menú «More». -->
                    <div class="caSeg" role="tablist" aria-label="Vista">
                        <button v-for="t in tabs"
                                :key="t"
                                type="button"
                                role="tab"
                                class="caSegBtn"
                                :class="{ isActive: activeTab === t }"
                                :aria-selected="activeTab === t"
                                @click="activeTab = t">{{ t }}</button>
                    </div>
                </div>

                <div class="caContainer">
                    <NotificationBox v-if="config.notAuthorized" alertType="warning">
                        No tienes permiso para administrar la disponibilidad.
                    </NotificationBox>

                    <NotificationBox v-else-if="config.configError" alertType="warning">
                        {{ config.configError }}
                    </NotificationBox>

                    <div v-else>
                        <!-- ===== Zona 1: Contexto ===== -->
                        <div class="caCard caContext">
                            <div class="caField">
                                <label class="caLabel">Sede</label>
                                <select v-model.number="campusId" class="caSelect">
                                    <option :value="0" disabled>Selecciona sede…</option>
                                    <option v-for="c in config.campuses" :key="c.value" :value="c.value">{{ c.text }}</option>
                                </select>
                            </div>

                            <div class="caField">
                                <label class="caLabel">Desde</label>
                                <input type="date" v-model="rangeStart" class="caInput" />
                            </div>

                            <div class="caField">
                                <label class="caLabel">Hasta</label>
                                <input type="date" v-model="rangeEnd" class="caInput" />
                            </div>

                            <div v-if="activeTab === 'Métricas'" class="caPresets">
                                <button type="button" class="caChip" @click="applyWeekPreset(0)">Esta semana</button>
                                <button type="button" class="caChip" @click="applyWeekPreset(-1)">Semana pasada</button>
                                <button type="button" class="caChip" @click="applyPastPreset(4)">Últimas 4 sem.</button>
                                <button type="button" class="caChip" @click="applyPastPreset(12)">Últimas 12</button>
                                <button type="button" class="caChip" @click="applyPastPreset(26)">Últimas 26</button>
                            </div>
                            <div v-else class="caPresets">
                                <button type="button" class="caChip" @click="applyConfigWeekPreset(0)">Esta semana</button>
                                <button type="button" class="caChip" @click="applyConfigWeekPreset(-1)">Semana pasada</button>
                                <button type="button" class="caChip" @click="applyPreset(28)">4 semanas</button>
                                <button type="button" class="caChip" @click="applyPreset(91)">3 meses</button>
                                <button type="button" class="caChip" @click="applyPreset(182)">6 meses</button>
                            </div>
                        </div>

                        <div v-if="!campusId" class="caEmpty">
                            Selecciona una sede para ver y administrar su disponibilidad.
                        </div>

                        <!-- ===== Pestaña: Métricas ===== -->
                        <template v-else-if="activeTab === 'Métricas'">
                            <div v-if="metricsBusy && metricsWeeks.length === 0" class="caMuted caSmall caEmpty">Cargando…</div>
                            <div v-else-if="metricsError" class="caGenResult">
                                <NotificationBox alertType="danger">{{ metricsError }}</NotificationBox>
                            </div>
                            <div v-else-if="metricsWeeks.length === 0" class="caEmpty">
                                No hay servicios en este rango.
                                <div class="caEmptyAction caPresets">
                                    <button type="button" class="caChip" @click="applyWeekPreset(-1)">Ver semana pasada</button>
                                    <button type="button" class="caChip" @click="applyPastPreset(12)">Ver últimas 12 semanas</button>
                                </div>
                            </div>

                            <template v-else>
                                <!-- Semana seleccionada: KPIs -->
                                <div class="caCard">
                                    <div class="caMetricsHead">
                                        <div>
                                            <div class="caCardTitle">Semana del {{ selectedWeek?.label ?? "—" }}</div>
                                            <div class="caCardSub">
                                                <template v-if="selectedWeek?.isPast">Servicio ya realizado: la diferencia entre reservados e ingresados son los que no vinieron.</template>
                                                <template v-else>Servicio pendiente o en curso: todavía pueden ingresar.</template>
                                            </div>
                                        </div>
                                        <label class="caWeekPick">
                                            <span class="caLabel">Semana</span>
                                            <select v-model="selectedWeekKey" class="caSelect caSelectSm">
                                                <option v-for="w in metricsWeeks" :key="w.weekStart" :value="w.weekStart">{{ w.label }}</option>
                                            </select>
                                        </label>
                                    </div>

                                    <div v-if="selectedWeek" class="caKpis">
                                        <div class="caKpi">
                                            <div class="caKpiValue">{{ selectedWeek.reserved }}</div>
                                            <div class="caKpiLabel">Reservados <span class="caKpiSub">de {{ selectedWeek.capacity }} cupos</span></div>
                                        </div>
                                        <div class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.checkedIn.color }"></span>{{ selectedWeek.checkedIn }}</div>
                                            <div class="caKpiLabel">Ingresaron <span class="caKpiSub">{{ pct(selectedWeek.checkedIn, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div v-if="selectedWeek.isPast" class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.noShow.color }"></span>{{ selectedWeek.noShow }}</div>
                                            <div class="caKpiLabel">No vinieron <span class="caKpiSub">{{ pct(selectedWeek.noShow, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div v-else class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.pending.color }"></span>{{ selectedWeek.pending }}</div>
                                            <div class="caKpiLabel">Pendientes <span class="caKpiSub">{{ pct(selectedWeek.pending, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div class="caKpi">
                                            <div class="caKpiValue">{{ pct(selectedWeek.reserved, selectedWeek.capacity, true) }}</div>
                                            <div class="caKpiLabel">Ocupación <span class="caKpiSub">reservados sobre cupos</span></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Por horario, semana seleccionada -->
                                <div class="caCard">
                                    <div class="caCardTitle">Por horario · {{ selectedWeek?.label ?? "" }}</div>
                                    <div class="caCardSub">Personas por servicio. La altura total de cada barra son los reservados.</div>
                                    <div class="caChartWrap caChartWrapShort">
                                        <canvas ref="scheduleChartCanvas" role="img" aria-label="Barras apiladas por horario: ingresaron, no vinieron y pendientes"></canvas>
                                    </div>
                                </div>

                                <!-- Por semana -->
                                <div class="caCard">
                                    <div class="caCardTitle">Por semana</div>
                                    <div class="caCardSub">Todos los horarios sumados. Toca una barra para ver esa semana arriba.</div>
                                    <div class="caChartWrap">
                                        <canvas ref="weekChartCanvas" role="img" aria-label="Barras apiladas por semana: ingresaron, no vinieron y pendientes"></canvas>
                                    </div>
                                </div>

                                <!-- Tabla (vista accesible y respaldo de las etiquetas) -->
                                <div class="caCard" v-if="selectedWeek">
                                    <div class="caCardTitle">Detalle · {{ selectedWeek.label }}</div>
                                    <div class="caTableWrap">
                                        <table class="caTable">
                                            <thead>
                                                <tr>
                                                    <th>Horario</th>
                                                    <th class="num">Cupos</th>
                                                    <th class="num">Reservados</th>
                                                    <th class="num">Ingresaron</th>
                                                    <th class="num">{{ selectedWeek.isPast ? "No vinieron" : "Pendientes" }}</th>
                                                    <th class="num">Asistencia</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="m in selectedWeek.schedules" :key="m.scheduleId">
                                                    <td>{{ m.scheduleName }}</td>
                                                    <td class="num">{{ m.capacity }}</td>
                                                    <td class="num">{{ m.reserved }}</td>
                                                    <td class="num">{{ m.checkedIn }}</td>
                                                    <td class="num">{{ m.isPast ? m.noShow : m.pending }}</td>
                                                    <td class="num">{{ pct(m.checkedIn, m.reserved) }}</td>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td>Total</td>
                                                    <td class="num">{{ selectedWeek.capacity }}</td>
                                                    <td class="num">{{ selectedWeek.reserved }}</td>
                                                    <td class="num">{{ selectedWeek.checkedIn }}</td>
                                                    <td class="num">{{ selectedWeek.isPast ? selectedWeek.noShow : selectedWeek.pending }}</td>
                                                    <td class="num">{{ pct(selectedWeek.checkedIn, selectedWeek.reserved) }}</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </template>
                        </template>

                        <template v-else>
                            <!-- ===== Zona 2: Plantilla ===== -->
                            <div class="caCard">
                                <div class="caCardTitle">Plantilla de horarios</div>
                                <div class="caCardSub">
                                    Define la capacidad de cada horario y aplícala a todas las fechas del rango de arriba.
                                </div>

                                <div class="caTplRows">
                                    <div v-for="row in templateRows" :key="row.scheduleId" class="caTplRow" :class="{ isOff: !row.include }">
                                        <label class="caTplToggle">
                                            <input type="checkbox" v-model="row.include" />
                                            <span class="caTplName">{{ row.name }}</span>
                                            <span class="caTplMeta">{{ row.dayText }}<template v-if="row.timeText"> · {{ row.timeText }}</template></span>
                                        </label>

                                        <div class="caTplCap">
                                            <span class="caTplCapLabel">Capacidad</span>
                                            <input type="number" min="0" step="1" v-model.number="row.capacity" class="caInput caCapInput" :disabled="!row.include" />
                                        </div>
                                    </div>
                                </div>

                                <label class="caOption">
                                    <input type="checkbox" v-model="overwriteCapacity" />
                                    <span>Sobrescribir la capacidad de las fechas que ya existen <span class="caMuted">(nunca por debajo de los lugares ya tomados)</span></span>
                                </label>

                                <label class="caOption">
                                    <input type="checkbox" v-model="deactivateOthers" />
                                    <span>Desactivar horarios del rango que NO estén en esta plantilla <span class="caMuted">(solo si no tienen reservas ni holds)</span></span>
                                </label>

                                <div class="caPreviewBar">
                                    <div class="caPreviewText">{{ previewText }}</div>
                                    <RockButton btnType="primary" @click="generate" :disabled="genBusy || previewTotal === 0">
                                        {{ genBusy ? "Aplicando…" : "Aplicar plantilla" }}
                                    </RockButton>
                                </div>

                                <NotificationBox v-if="genResult" :alertType="genResult.kind" class="caGenResult">
                                    <div>{{ genResult.summary }}</div>
                                    <ul v-if="genResult.warnings.length" class="caWarnList">
                                        <li v-for="(w, i) in genResult.warnings.slice(0, 8)" :key="i">{{ w }}</li>
                                        <li v-if="genResult.warnings.length > 8">… y {{ genResult.warnings.length - 8 }} advertencias más.</li>
                                    </ul>
                                </NotificationBox>
                            </div>

                            <!-- ===== Zona 3: Disponibilidad actual ===== -->
                            <div class="caCard">
                                <div class="caCardTitle">Disponibilidad del rango</div>

                                <div v-if="slotsBusy" class="caMuted caSmall">Cargando…</div>
                                <div v-else-if="slotsError" class="caGenResult">
                                    <NotificationBox alertType="danger">{{ slotsError }}</NotificationBox>
                                </div>
                                <div v-else-if="days.length === 0" class="caEmpty">
                                    No hay disponibilidad creada en este rango. Usa la plantilla de arriba para generarla.
                                </div>

                                <div v-for="d in days" :key="d.occurrenceDate" class="caDay">
                                    <div class="caDayTitle">{{ d.occurrenceDateText }}</div>

                                    <div v-for="s in d.slots" :key="s.slotId" class="caSlot" :class="{ isInactive: !s.isActive }">
                                        <div class="caSlotMain">
                                            <div class="caSlotName">
                                                {{ s.scheduleName }}
                                                <span v-if="!s.isActive" class="caBadge caBadgeOff">Inactivo</span>
                                            </div>
                                            <div class="caOccBar">
                                                <div class="caOccFill" :style="{ width: occupancyPercent(s) + '%' }" :class="{ isFull: s.available === 0 }"></div>
                                            </div>
                                            <div class="caSlotStats">
                                                <span>Reservados <b>{{ s.reservedCount }}</b></span>
                                                <span>Ingresaron <b>{{ s.checkedInCount }}</b></span>
                                                <span>Holds <b>{{ s.holdCount }}</b></span>
                                                <span :class="s.available === 0 ? 'caStatDanger' : 'caStatOk'">Disponibles <b>{{ s.available }}</b></span>
                                            </div>
                                        </div>

                                        <div class="caSlotActions">
                                            <div class="caTplCap">
                                                <span class="caTplCapLabel">Capacidad</span>
                                                <input type="number" min="0" step="1" v-model.number="s.draftCapacity" class="caInput caCapInput" :disabled="rowBusy === s.slotId" />
                                                <button
                                                    v-if="s.draftCapacity !== s.capacity"
                                                    type="button"
                                                    class="caMiniBtn caMiniBtnSave"
                                                    :disabled="rowBusy === s.slotId"
                                                    @click="saveCapacity(s)">
                                                    Guardar
                                                </button>
                                            </div>

                                            <button
                                                type="button"
                                                class="caMiniBtn"
                                                :disabled="rowBusy === s.slotId"
                                                @click="toggleActive(s)">
                                                {{ s.isActive ? "Desactivar" : "Reactivar" }}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Toast -->
                    <div v-if="toast.show" class="caToast" :class="toast.kind">
                        {{ toast.message }}
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, nextTick, onBeforeUnmount, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import { Chart } from "@Obsidian/Libs/chart";
import type { ChartOptions } from "@Obsidian/Libs/chart";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type OptionBag = { value: number; text: string };

type ScheduleBag = {
    id: number;
    name: string;
    dayOfWeek: number;
    dayText: string;
    timeText: string;
};

type InitBag = {
    notAuthorized: boolean;
    configError: string | null;
    campuses: OptionBag[];
    schedules: ScheduleBag[];
    defaultCampusId: number;
    startDate: string;
    endDate: string;
};

type SlotBag = {
    slotId: number;
    scheduleId: number;
    scheduleName: string;
    capacity: number;
    reservedCount: number;
    holdCount: number;
    checkedInCount: number;
    available: number;
    isActive: boolean;
    draftCapacity: number;
};

type ScheduleMetricsBag = {
    scheduleId: number;
    scheduleName: string;
    capacity: number;
    reserved: number;
    checkedIn: number;
    noShow: number;
    pending: number;
    isPast: boolean;
};

type WeekMetricsBag = {
    weekStart: string;
    sundayDate: string;
    label: string;
    isPast: boolean;
    capacity: number;
    reserved: number;
    checkedIn: number;
    noShow: number;
    pending: number;
    schedules: ScheduleMetricsBag[];
};

type DaySlotsBag = {
    occurrenceDate: string;
    occurrenceDateText: string;
    slots: SlotBag[];
};

type TemplateRow = {
    scheduleId: number;
    name: string;
    dayOfWeek: number;
    dayText: string;
    timeText: string;
    include: boolean;
    capacity: number;
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const campusId = ref<number>(config.defaultCampusId || 0);
// Configuración abre en la semana en curso (lunes a domingo); ver applyConfigWeekPreset(0)
// más abajo. El rango que manda el servidor (hoy → +3 meses) ya no se usa como inicial.
const startDate = ref<string>("");
const endDate = ref<string>("");

// Métricas tiene su propio rango: por omisión la semana en curso (lunes a domingo).
// Así entrar al dashboard no altera el rango de trabajo de Configuración ni al revés.
const metricsStartDate = ref<string>("");
const metricsEndDate = ref<string>("");

/** Lunes de la semana de `d` (las semanas del dashboard van de lunes a domingo). */
function mondayOf(d: Date): Date {
    const m = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    m.setDate(m.getDate() - ((m.getDay() + 6) % 7));
    return m;
}

/** Rango [lunes, domingo] de la semana actual desplazada `offsetWeeks` (0 = esta, -1 = pasada). */
function weekRange(offsetWeeks: number): { start: string; end: string } {
    const mon = mondayOf(new Date());
    mon.setDate(mon.getDate() + offsetWeeks * 7);
    const sun = new Date(mon.getTime());
    sun.setDate(sun.getDate() + 6);
    return { start: toIso(mon), end: toIso(sun) };
}

function applyWeekPreset(offsetWeeks: number): void {
    const r = weekRange(offsetWeeks);
    metricsStartDate.value = r.start;
    metricsEndDate.value = r.end;
}

function applyConfigWeekPreset(offsetWeeks: number): void {
    const r = weekRange(offsetWeeks);
    startDate.value = r.start;
    endDate.value = r.end;
}

applyConfigWeekPreset(0);
applyWeekPreset(0);

/** Los inputs Desde/Hasta editan el rango de la pestaña activa. */
const rangeStart = computed<string>({
    get: () => activeTab.value === "Métricas" ? metricsStartDate.value : startDate.value,
    set: v => { if (activeTab.value === "Métricas") metricsStartDate.value = v; else startDate.value = v; }
});
const rangeEnd = computed<string>({
    get: () => activeTab.value === "Métricas" ? metricsEndDate.value : endDate.value,
    set: v => { if (activeTab.value === "Métricas") metricsEndDate.value = v; else endDate.value = v; }
});

const templateRows = ref<TemplateRow[]>((config.schedules || []).map(s => ({
    scheduleId: s.id,
    name: s.name,
    dayOfWeek: s.dayOfWeek,
    dayText: s.dayText,
    timeText: s.timeText,
    include: true,
    capacity: 0
})));

const overwriteCapacity = ref<boolean>(true);
const deactivateOthers = ref<boolean>(false);

const days = ref<DaySlotsBag[]>([]);
const slotsBusy = ref<boolean>(false);
const slotsError = ref<string>("");
const genBusy = ref<boolean>(false);
const rowBusy = ref<number>(0);

const genResult = ref<{ kind: "success" | "warning"; summary: string; warnings: string[] } | null>(null);

const toast = ref<{ show: boolean; kind: "success" | "danger"; message: string }>({ show: false, kind: "success", message: "" });
let toastTimer: number | null = null;

function showToast(kind: "success" | "danger", message: string): void {
    toast.value = { show: true, kind, message };
    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
    }
    toastTimer = window.setTimeout(() => {
        toast.value.show = false;
        toastTimer = null;
    }, 2800);
}

// ---- Fechas (parseo local, sin sorpresas de zona horaria) ----

function parseIso(d: string): Date | null {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d || "");
    if (!m) {
        return null;
    }
    return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
}

function toIso(d: Date): string {
    const mm = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    return `${d.getFullYear()}-${mm}-${dd}`;
}

function applyPreset(daysCount: number): void {
    const start = parseIso(startDate.value) || new Date();
    startDate.value = toIso(start);
    const end = new Date(start.getTime());
    end.setDate(end.getDate() + daysCount);
    endDate.value = toIso(end);
}

function countDatesForDow(dow: number, startIso: string, endIso: string): number {
    if (dow < 0) {
        return 0;
    }
    const start = parseIso(startIso);
    const end = parseIso(endIso);
    if (!start || !end || start > end) {
        return 0;
    }
    const offset = (dow - start.getDay() + 7) % 7;
    const first = new Date(start.getTime());
    first.setDate(first.getDate() + offset);
    if (first > end) {
        return 0;
    }
    return 1 + Math.floor((end.getTime() - first.getTime()) / (7 * 86400000));
}

// ---- Vista previa en vivo ----

const previewTotal = computed<number>(() => {
    return templateRows.value
        .filter(r => r.include)
        .reduce((sum, r) => sum + countDatesForDow(r.dayOfWeek, startDate.value, endDate.value), 0);
});

const previewText = computed<string>(() => {
    const included = templateRows.value.filter(r => r.include);
    if (included.length === 0) {
        return "Selecciona al menos un horario.";
    }
    if (previewTotal.value === 0) {
        return "El rango de fechas no contiene días de los horarios seleccionados.";
    }
    return `Se aplicará a ${previewTotal.value} slots (${included.length} horario${included.length === 1 ? "" : "s"} en el rango).`;
});

// ---- Métricas (pestaña dashboard) ----
const tabs = ["Configuración", "Métricas"];
const activeTab = ref<string>("Configuración");

const metricsWeeks = ref<WeekMetricsBag[]>([]);
const metricsBusy = ref<boolean>(false);
const metricsError = ref<string>("");
const selectedWeekKey = ref<string>("");

const selectedWeek = computed<WeekMetricsBag | null>(() =>
    metricsWeeks.value.find(w => w.weekStart === selectedWeekKey.value) ?? null);

const weekChartCanvas = ref<HTMLCanvasElement | null>(null);
const scheduleChartCanvas = ref<HTMLCanvasElement | null>(null);
let weekChart: Chart | null = null;
let scheduleChart: Chart | null = null;

// Paleta categórica validada (orden fijo, no se recicla). El texto nunca
// lleva el color de la serie: identidad por swatch/segmento, valores en tinta.
const SERIES = {
    checkedIn: { label: "Ingresaron", color: "#2a78d6" },
    noShow: { label: "No vinieron", color: "#eb6834" },
    pending: { label: "Pendientes", color: "#1baf7a" }
} as const;
const INK = "#111827";
const INK_MUTED = "#6B7280";
const SURFACE = "#FFFFFF";
const GRID = "rgba(17,24,39,.08)";
const FONT = "Roboto, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif";

function pct(part: number, whole: number, bare = false): string {
    if (!whole || whole <= 0) {
        return bare ? "—" : "";
    }
    const v = Math.round((part / whole) * 100);
    return bare ? `${v}%` : `· ${v}%`;
}

function applyPastPreset(weeks: number): void {
    const end = new Date();
    const start = new Date(end.getTime());
    start.setDate(start.getDate() - weeks * 7);
    metricsStartDate.value = toIso(start);
    metricsEndDate.value = toIso(end);
}

async function loadMetrics(): Promise<void> {
    if (!campusId.value || !parseIso(metricsStartDate.value) || !parseIso(metricsEndDate.value)) {
        return;
    }
    metricsBusy.value = true;
    metricsError.value = "";
    try {
        const res = await invokeBlockAction<{ weeks: WeekMetricsBag[] }>("GetWeeklyMetrics", {
            bag: { campusId: campusId.value, startDate: metricsStartDate.value, endDate: metricsEndDate.value }
        });
        if (!res.isSuccess || !res.data) {
            metricsError.value = res.errorMessage || "No se pudieron cargar las métricas.";
            metricsWeeks.value = [];
            return;
        }
        metricsWeeks.value = res.data.weeks || [];

        // Semana por omisión: la más reciente ya realizada; si no hay, la última.
        if (!metricsWeeks.value.some(w => w.weekStart === selectedWeekKey.value)) {
            const past = metricsWeeks.value.filter(w => w.isPast);
            const def = past.length > 0 ? past[past.length - 1] : metricsWeeks.value[metricsWeeks.value.length - 1];
            selectedWeekKey.value = def ? def.weekStart : "";
        }
    }
    catch {
        metricsError.value = "No se pudieron cargar las métricas.";
        metricsWeeks.value = [];
    }
    finally {
        metricsBusy.value = false;
        await nextTick();
        renderCharts();
    }
}

type Stack = { labels: string[]; checkedIn: number[]; noShow: number[]; pending: number[] };

function stackFromWeeks(weeks: WeekMetricsBag[]): Stack {
    return {
        labels: weeks.map(w => w.label),
        checkedIn: weeks.map(w => w.checkedIn),
        noShow: weeks.map(w => w.noShow),
        pending: weeks.map(w => w.pending)
    };
}

function stackFromSchedules(items: ScheduleMetricsBag[]): Stack {
    return {
        labels: items.map(m => m.scheduleName),
        checkedIn: items.map(m => m.checkedIn),
        noShow: items.map(m => m.noShow),
        pending: items.map(m => m.pending)
    };
}

/** Índice del dataset que queda arriba de la pila en la barra i (para redondear solo ese extremo). */
function topDatasetIndex(st: Stack, i: number): number {
    if ((st.pending[i] || 0) > 0) return 2;
    if ((st.noShow[i] || 0) > 0) return 1;
    if ((st.checkedIn[i] || 0) > 0) return 0;
    return -1;
}

function buildDatasets(st: Stack): Array<Record<string, unknown>> {
    const order: Array<{ key: keyof typeof SERIES; data: number[] }> = [
        { key: "checkedIn", data: st.checkedIn },
        { key: "noShow", data: st.noShow },
        { key: "pending", data: st.pending }
    ];
    return order.map((s, idx) => ({
        label: SERIES[s.key].label,
        data: s.data,
        backgroundColor: SERIES[s.key].color,
        // Spec: 2px de superficie entre segmentos apilados (gap, no borde).
        borderColor: SURFACE,
        borderWidth: { top: 2, right: 0, bottom: 0, left: 0 },
        borderSkipped: false,
        maxBarThickness: 24,
        // Spec: extremo de dato redondeado (4px), cuadrado en la base. Solo el
        // segmento superior visible de cada pila lleva el redondeo.
        borderRadius: (ctx: { dataIndex: number }) =>
            topDatasetIndex(st, ctx.dataIndex) === idx
                ? { topLeft: 4, topRight: 4, bottomLeft: 0, bottomRight: 0 }
                : 0
    }));
}

function baseOptions(showTotals: boolean, onBarClick?: (index: number) => void): ChartOptions<"bar"> {
    const tick = { color: INK_MUTED, font: { family: FONT, size: 12 } };
    return {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 250 },
        interaction: { mode: "index", intersect: false },
        onClick: (_evt, elements) => {
            if (onBarClick && elements.length > 0) {
                onBarClick(elements[0].index);
            }
        },
        layout: { padding: { top: showTotals ? 20 : 8, right: 4, left: 0, bottom: 0 } },
        scales: {
            x: { stacked: true, grid: { display: false }, border: { color: GRID }, ticks: tick },
            y: {
                stacked: true,
                beginAtZero: true,
                grid: { color: GRID, drawTicks: false },
                border: { display: false },
                ticks: { ...tick, precision: 0, padding: 6 }
            }
        },
        plugins: {
            legend: {
                position: "bottom",
                labels: { color: INK, boxWidth: 10, boxHeight: 10, padding: 14, font: { family: FONT, size: 12 } }
            },
            tooltip: {
                backgroundColor: INK,
                titleColor: "#FFFFFF",
                bodyColor: "#FFFFFF",
                footerColor: "#FFFFFF",
                titleFont: { family: FONT, weight: "bold" },
                bodyFont: { family: FONT },
                footerFont: { family: FONT, weight: "bold" },
                padding: 10,
                boxWidth: 8,
                boxHeight: 8,
                boxPadding: 4,
                callbacks: {
                    footer: items => "Reservados: " + items.reduce((sum, it) => sum + (Number(it.raw) || 0), 0)
                }
            }
        }
    };
}

/** Total de la pila sobre cada barra (solo en la gráfica corta, ≤ 6 barras). */
const stackTotalsPlugin = {
    id: "caStackTotals",
    afterDatasetsDraw(chart: Chart): void {
        const x = chart.scales.x;
        const y = chart.scales.y;
        if (!x || !y) {
            return;
        }
        const n = chart.data.labels?.length ?? 0;
        const ctx = chart.ctx;
        ctx.save();
        ctx.fillStyle = INK;
        ctx.font = `600 12px ${FONT}`;
        ctx.textAlign = "center";
        ctx.textBaseline = "bottom";
        for (let i = 0; i < n; i++) {
            let total = 0;
            chart.data.datasets.forEach((ds, di) => {
                if (chart.isDatasetVisible(di)) {
                    total += Number((ds.data as number[])[i]) || 0;
                }
            });
            if (total > 0) {
                ctx.fillText(String(total), x.getPixelForValue(i), y.getPixelForValue(total) - 4);
            }
        }
        ctx.restore();
    }
};

function upsertChart(
    existing: Chart | null,
    canvas: HTMLCanvasElement | null,
    st: Stack,
    options: ChartOptions<"bar">,
    withTotals: boolean
): Chart | null {
    // El canvas se desmonta al cambiar de pestaña (v-if): si el chart apunta a
    // uno viejo, se destruye y se crea de nuevo sobre el actual.
    if (existing && existing.canvas !== canvas) {
        existing.destroy();
        existing = null;
    }
    if (!canvas) {
        return existing;
    }
    const data = { labels: st.labels, datasets: buildDatasets(st) };
    if (existing) {
        // Chart.js tipa data/options con el tipo de gráfica genérico; el paso por
        // unknown es el patrón que TS exige para asignar nuestro shape concreto.
        existing.data = data as unknown as typeof existing.data;
        existing.options = options as unknown as typeof existing.options;
        existing.update();
        return existing;
    }
    return new Chart(canvas, {
        type: "bar",
        data: data as never,
        options,
        plugins: withTotals ? [stackTotalsPlugin] : []
    });
}

function renderCharts(): void {
    if (activeTab.value !== "Métricas" || metricsWeeks.value.length === 0) {
        return;
    }
    const weeks = metricsWeeks.value;
    weekChart = upsertChart(
        weekChart,
        weekChartCanvas.value,
        stackFromWeeks(weeks),
        baseOptions(false, i => { selectedWeekKey.value = weeks[i]?.weekStart ?? selectedWeekKey.value; }),
        false
    );
    const sched = selectedWeek.value?.schedules ?? [];
    scheduleChart = upsertChart(
        scheduleChart,
        scheduleChartCanvas.value,
        stackFromSchedules(sched),
        baseOptions(true),
        true
    );
}

watch(activeTab, async tab => {
    if (tab === "Métricas") {
        if (metricsWeeks.value.length === 0) {
            await loadMetrics();
        }
        else {
            await nextTick();
            renderCharts();
        }
    }
});

watch(selectedWeekKey, async () => {
    await nextTick();
    renderCharts();
});

watch([campusId, metricsStartDate, metricsEndDate], () => {
    if (activeTab.value === "Métricas") {
        loadMetrics();
    }
    else {
        // Cambió la sede (o el rango de métricas) estando en Configuración: la próxima
        // visita a Métricas recarga.
        metricsWeeks.value = [];
    }
});

onBeforeUnmount(() => {
    weekChart?.destroy();
    scheduleChart?.destroy();
    weekChart = null;
    scheduleChart = null;
});

// ---- Carga de slots ----

async function loadSlots(fillTemplate: boolean): Promise<void> {
    if (!campusId.value || !parseIso(startDate.value) || !parseIso(endDate.value)) {
        return;
    }

    slotsBusy.value = true;
    slotsError.value = "";

    try {
        const res = await invokeBlockAction<{ days: DaySlotsBag[]; templateCapacities: Record<number, number> }>("GetSlots", {
            bag: { campusId: campusId.value, startDate: startDate.value, endDate: endDate.value }
        });

        if (!res.isSuccess || !res.data) {
            slotsError.value = res.errorMessage || "No se pudo cargar la disponibilidad.";
            days.value = [];
            return;
        }

        days.value = (res.data.days || []).map(d => ({
            ...d,
            slots: (d.slots || []).map(s => ({ ...s, draftCapacity: s.capacity }))
        }));

        if (fillTemplate) {
            const caps = res.data.templateCapacities || {};
            for (const row of templateRows.value) {
                const cap = caps[row.scheduleId];
                if (typeof cap === "number") {
                    row.capacity = cap;
                }
            }
        }
    }
    catch {
        slotsError.value = "Error cargando la disponibilidad.";
        days.value = [];
    }
    finally {
        slotsBusy.value = false;
    }
}

watch(campusId, () => {
    genResult.value = null;
    void loadSlots(true);
});

watch([startDate, endDate], () => {
    void loadSlots(false);
});

if (campusId.value) {
    void loadSlots(true);
}

// ---- Aplicar plantilla ----

async function generate(): Promise<void> {
    if (genBusy.value || !campusId.value) {
        return;
    }

    genResult.value = null;
    genBusy.value = true;

    try {
        const res = await invokeBlockAction<{ inserted: number; updated: number; reactivated: number; deactivated: number; skippedLowCapacity: number; warnings: string[] }>("Generate", {
            bag: {
                campusId: campusId.value,
                startDate: startDate.value,
                endDate: endDate.value,
                items: templateRows.value.filter(r => r.include).map(r => ({ scheduleId: r.scheduleId, capacity: r.capacity || 0 })),
                overwriteCapacity: overwriteCapacity.value,
                deactivateOthers: deactivateOthers.value
            }
        });

        if (!res.isSuccess || !res.data) {
            genResult.value = { kind: "warning", summary: res.errorMessage || "No se pudo aplicar la plantilla.", warnings: [] };
            return;
        }

        const d = res.data;
        const parts: string[] = [];
        if (d.inserted) parts.push(`${d.inserted} creados`);
        if (d.updated) parts.push(`${d.updated} actualizados`);
        if (d.reactivated) parts.push(`${d.reactivated} reactivados`);
        if (d.deactivated) parts.push(`${d.deactivated} desactivados`);
        if (d.skippedLowCapacity) parts.push(`${d.skippedLowCapacity} omitidos por lugares ya tomados`);

        const warnings = d.warnings || [];
        genResult.value = {
            kind: warnings.length ? "warning" : "success",
            summary: parts.length ? `Listo: ${parts.join(", ")}.` : "Listo: no había nada que cambiar.",
            warnings
        };

        await loadSlots(false);
    }
    catch {
        genResult.value = { kind: "warning", summary: "Error aplicando la plantilla.", warnings: [] };
    }
    finally {
        genBusy.value = false;
    }
}

// ---- Edición individual ----

async function saveCapacity(slot: SlotBag): Promise<void> {
    if (rowBusy.value) {
        return;
    }

    const capacity = Number(slot.draftCapacity);
    if (!Number.isFinite(capacity) || capacity < 0) {
        showToast("danger", "Capacidad inválida.");
        slot.draftCapacity = slot.capacity;
        return;
    }

    rowBusy.value = slot.slotId;
    try {
        const res = await invokeBlockAction<{ resultCode: number; message: string }>("UpdateSlot", {
            bag: { slotId: slot.slotId, capacity }
        });

        if (res.isSuccess && res.data?.resultCode === 1) {
            slot.capacity = capacity;
            slot.available = Math.max(0, capacity - slot.reservedCount - slot.holdCount);
            showToast("success", "Capacidad guardada.");
        }
        else {
            slot.draftCapacity = slot.capacity;
            showToast("danger", res.data?.message || res.errorMessage || "No se pudo guardar.");
        }
    }
    catch {
        slot.draftCapacity = slot.capacity;
        showToast("danger", "Error guardando la capacidad.");
    }
    finally {
        rowBusy.value = 0;
    }
}

async function toggleActive(slot: SlotBag): Promise<void> {
    if (rowBusy.value) {
        return;
    }

    rowBusy.value = slot.slotId;
    try {
        const res = await invokeBlockAction<{ resultCode: number; message: string }>("UpdateSlot", {
            bag: { slotId: slot.slotId, isActive: !slot.isActive }
        });

        if (res.isSuccess && res.data?.resultCode === 1) {
            slot.isActive = !slot.isActive;
            showToast("success", slot.isActive ? "Horario reactivado." : "Horario desactivado.");
        }
        else {
            showToast("danger", res.data?.message || res.errorMessage || "No se pudo cambiar el estado.");
        }
    }
    catch {
        showToast("danger", "Error cambiando el estado.");
    }
    finally {
        rowBusy.value = 0;
    }
}

function occupancyPercent(slot: SlotBag): number {
    if (slot.capacity <= 0) {
        return 0;
    }
    return Math.min(100, Math.round(((slot.reservedCount + slot.holdCount) / slot.capacity) * 100));
}

onBeforeUnmount(() => {
    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
        toastTimer = null;
    }
});
</script>

<style>
:root {
    --ca-font: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    --ca-bg: #F4F6FB;
    --ca-surface: #FFFFFF;
    --ca-text: #111827;
    --ca-muted: #6B7280;
    --ca-border: rgba(17,24,39,.10);
    --ca-radius: 14px;
    --ca-accent: #2563EB;
    --ca-ok: #10B981;
    --ca-danger: #EF4444;
}

.panel-block .panel-heading,
.panel-block .panel-header { display: none !important; }
.panel-block { background: transparent !important; border: none !important; box-shadow: none !important; }

.caPage {
    font-family: var(--ca-font);
    background: var(--ca-bg);
    min-height: 100vh;
    color: var(--ca-text);
    padding-bottom: 24px;
}

.caTopBar {
    height: 54px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid rgba(17,24,39,.06);
}

.caBrand { font-weight: 800; font-size: 17px; }

.caContainer {
    max-width: 980px;
    margin: 0 auto;
    padding: 12px 10px 24px;
}

.caCard {
    background: var(--ca-surface);
    border: 1px solid var(--ca-border);
    border-radius: var(--ca-radius);
    box-shadow: 0 6px 18px rgba(17,24,39,.06);
    padding: 16px;
    margin-bottom: 14px;
}

.caCardTitle { font-weight: 900; font-size: 15px; margin-bottom: 2px; }
.caCardSub { font-size: 12px; color: var(--ca-muted); margin-bottom: 12px; }

/* Contexto */
.caContext {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 12px;
    align-items: end;
    position: sticky;
    top: 0;
    z-index: 20;
}

@media (max-width: 720px) {
    .caContext { grid-template-columns: 1fr 1fr; position: static; }
}

.caField { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.caLabel { font-size: 11px; font-weight: 800; color: var(--ca-muted); text-transform: uppercase; letter-spacing: .4px; }

.caSelect, .caInput {
    height: 40px;
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 0 10px;
    font-family: var(--ca-font);
    font-size: 14px;
    background: var(--ca-surface);
    color: var(--ca-text);
    width: 100%;
}

.caPresets { display: flex; gap: 6px; align-items: center; padding-bottom: 4px; }

.caChip {
    border: 1px solid var(--ca-border);
    background: var(--ca-surface);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
}
.caChip:hover { border-color: rgba(37,99,235,.45); color: var(--ca-accent); }

.caEmpty {
    text-align: center;
    color: var(--ca-muted);
    font-size: 13px;
    padding: 28px 12px;
}

/* Plantilla */
.caTplRows { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }

.caTplRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 10px 12px;
}
.caTplRow.isOff { opacity: .55; }

.caTplToggle { display: flex; align-items: center; gap: 10px; margin: 0; cursor: pointer; min-width: 0; }
.caTplToggle input { width: 18px; height: 18px; margin: 0; }
.caTplName { font-weight: 700; font-size: 14px; }
.caTplMeta { font-size: 12px; color: var(--ca-muted); white-space: nowrap; }

.caTplCap { display: flex; align-items: center; gap: 8px; }
.caTplCapLabel { font-size: 11px; font-weight: 800; color: var(--ca-muted); }
.caCapInput { width: 90px; text-align: center; }

.caOption {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    font-weight: 500;
    margin: 8px 0 0;
    cursor: pointer;
}
.caOption input { width: 17px; height: 17px; margin-top: 1px; flex-shrink: 0; }
.caMuted { color: var(--ca-muted); font-weight: 400; }
.caSmall { font-size: 12px; }

.caPreviewBar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding: 12px;
    background: rgba(37,99,235,.06);
    border: 1px solid rgba(37,99,235,.18);
    border-radius: 10px;
}

@media (max-width: 576px) {
    .caPreviewBar { flex-direction: column; align-items: stretch; text-align: center; }
    .caTplRow { flex-direction: column; align-items: stretch; }
    .caTplCap { justify-content: space-between; }
}

.caPreviewText { font-size: 13px; font-weight: 700; }

.caGenResult { margin-top: 12px; }
.caWarnList { margin: 8px 0 0; padding-left: 18px; font-size: 12px; }

/* Disponibilidad */
.caDay { margin-top: 14px; }
.caDayTitle {
    font-weight: 900;
    font-size: 13px;
    color: var(--ca-muted);
    margin-bottom: 8px;
    text-transform: capitalize;
    border-bottom: 1px solid rgba(17,24,39,.06);
    padding-bottom: 6px;
}

.caSlot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.caSlot.isInactive { background: rgba(17,24,39,.03); opacity: .75; }

@media (max-width: 720px) {
    .caSlot { flex-direction: column; align-items: stretch; }
    .caSlotActions { justify-content: space-between; }
}

.caSlotMain { flex: 1; min-width: 0; }
.caSlotName { font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px; }

.caBadge {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: .4px;
}
.caBadgeOff { background: rgba(239,68,68,.10); color: #B91C1C; border: 1px solid rgba(239,68,68,.25); }

.caOccBar {
    height: 6px;
    background: rgba(17,24,39,.08);
    border-radius: 999px;
    overflow: hidden;
    margin: 8px 0 6px;
    max-width: 340px;
}
.caOccFill {
    height: 100%;
    background: linear-gradient(90deg, var(--ca-ok), var(--ca-accent));
    border-radius: 999px;
    transition: width .3s ease;
}
.caOccFill.isFull { background: var(--ca-danger); }

.caSlotStats { display: flex; gap: 14px; font-size: 12px; color: var(--ca-muted); flex-wrap: wrap; }
.caSlotStats b { color: var(--ca-text); }
.caStatOk b { color: #047857; }
.caStatDanger b { color: #B91C1C; }

/* ===== Pestañas y métricas ===== */
.caTopBar { justify-content: space-between; gap: 12px; }
.caSeg {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border-radius: 999px;
    background: #EEF0F3;
    border: 1px solid var(--ca-border);
    flex: 0 0 auto;
}
.caSegBtn {
    border: 0;
    background: transparent;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--ca-muted);
    cursor: pointer;
    white-space: nowrap;
    line-height: 1.2;
    transition: background-color .15s ease, color .15s ease;
}
.caSegBtn:hover { color: var(--ca-text); }
.caSegBtn:focus-visible { outline: 2px solid var(--ca-accent); outline-offset: 1px; }
.caSegBtn.isActive {
    background: var(--ca-surface);
    color: var(--ca-text);
    box-shadow: 0 1px 2px rgba(17,24,39,.12);
}
.caEmptyAction { margin-top: 10px; }
.caMetricsHead { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
.caWeekPick { display: flex; flex-direction: column; gap: 4px; min-width: 160px; }
.caSelectSm { height: 34px; font-size: 13px; }
.caKpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
@media (max-width: 720px) { .caKpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.caKpi {
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--ca-surface);
}
.caKpiValue {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ca-text);
