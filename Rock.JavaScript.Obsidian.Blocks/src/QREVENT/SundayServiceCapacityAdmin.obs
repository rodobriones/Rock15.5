.caMiniBtn:hover:not(:disabled) { background: #E5E7EB; }
.caMiniBtn:disabled { opacity: .5; cursor: default; }
.caMiniBtnSave { background: #272B32; border-color: #272B32; color: #fff; }
.caMiniBtnSave:hover:not(:disabled) { background: #1a1d22; }

