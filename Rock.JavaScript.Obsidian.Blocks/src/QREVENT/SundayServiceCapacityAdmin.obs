}
.caKpiLabel { margin-top: 4px; font-size: 12px; font-weight: 700; color: var(--ca-text); }
.caKpiSub { font-weight: 400; color: var(--ca-muted); }
.caSwatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; flex: 0 0 auto; }
/* Alto = área de trazo + banda del eje X + leyenda; nunca un scroll interno. */
.caChartWrap { position: relative; height: 320px; }
.caChartWrapShort { height: 280px; }
.caTableWrap { overflow-x: auto; }
.caTable { width: 100%; border-collapse: collapse; font-size: 13px; }
.caTable th, .caTable td { padding: 8px 10px; border-bottom: 1px solid var(--ca-border); text-align: left; }
.caTable th { font-size: 11px; font-weight: 800; color: var(--ca-muted); text-transform: uppercase; letter-spacing: .4px; }
.caTable .num { text-align: right; font-variant-numeric: tabular-nums; }
.caTable tfoot td { font-weight: 800; border-bottom: none; }

.caSlotActions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }

.caMiniBtn {
    border: 1px solid var(--ca-border);
    background: #F3F4F6;
