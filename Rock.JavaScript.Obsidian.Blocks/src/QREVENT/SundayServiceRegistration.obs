<template>
    <Panel type="block" title="Registro Servicio Dominical" :hasNoBodyPadding="true">
        <template #default>
            <!-- ===== Blank Layout: página implícita ===== -->
            <div ref="pageEl" class="vrPage">
                <!-- Banda institucional: navy sin contenido (la marca se quito el 2026-08-26) -->
                <div class="vrTopBar"></div>

                <div class="vrContainer">
                    <div class="sswrap">
                        <NotificationBox v-if="config.notLogged" alertType="warning">
                            Debes iniciar sesión para registrarte.
                        </NotificationBox>

                        <div v-else>
                            <!-- Stepper -->
                            <div v-if="!activeReservation || replacing" class="ssStepper">
                                <div class="ssStep" :class="{ active: step === 1, done: step > 1 }">
                                    <div class="ssDot">1</div>
                                    <div class="ssStepText">Sede</div>
                                </div>
                                <div class="ssLine" :class="{ done: step > 1 }"></div>
                                <div class="ssStep" :class="{ active: step === 2, done: step > 2 }">
                                    <div class="ssDot">2</div>
                                    <div class="ssStepText">Cantidad</div>
                                </div>
                                <div class="ssLine" :class="{ done: step > 2 }"></div>
                                <div class="ssStep" :class="{ active: step === 3, done: step > 3 }">
                                    <div class="ssDot">3</div>
                                    <div class="ssStepText">Horario</div>
                                </div>
                                <div class="ssLine" :class="{ done: step > 3 }"></div>
                                <div class="ssStep" :class="{ active: step === 4 }">
                                    <div class="ssDot">4</div>
                                    <div class="ssStepText">Confirmar</div>
                                </div>
                            </div>

                            <div v-if="statusHtml" v-html="statusHtml"></div>

                            <!-- Reserva activa -->
                            <div v-if="activeReservation && !replacing" class="card ssCard">
                                <div class="card-body">
                                    <div class="ssCardTitle">Tu reserva activa</div>

                                    <div class="ssSummaryCard">
                                        <div class="ssSummaryRow">
                                            <div class="ssLabel">Sede</div>
                                            <div class="ssVal">{{ activeReservation.campusName }}</div>
                                        </div>
                                        <div class="ssSummaryRow">
                                            <div class="ssLabel">Día</div>
                                            <div class="ssVal">{{ activeReservation.occurrenceDateText }}</div>
                                        </div>
                                        <div class="ssSummaryRow">
                                            <div class="ssLabel">Horario</div>
                                            <div class="ssVal">{{ activeReservation.scheduleName }}</div>
                                        </div>
                                        <div class="ssSummaryRow">
                                            <div class="ssLabel">Cantidad</div>
                                            <div class="ssVal">{{ activeReservation.quantity }}</div>
                                        </div>
                                    </div>

                                    <div class="ssQrWrap">
                                        <div class="ssQrImgClip">
                                            <img
                                                ref="qrImgEl"
                                                class="ssQrImg"
                                                :src="qrUrl(activeReservation.reservationCode)"
                                                alt="QR Reserva" />
                                        </div>
                                    </div>

                                    <div class="ssQrInfoText text-muted">
                                        Presenta este código QR al ingresar al evento. También quedará guardado en Reservas z.10 en tu app, o puedes descargarlo aquí.
                                    </div>

                                    <div class="ssActions" style="flex-direction: column; align-items: center; display: flex; gap: 14px;">
                                        <RockButton btnType="primary" @click="downloadImage" :disabled="busy || downloadBusy" style="width: 100%;">
                                            {{ downloadBusy ? "Generando..." : "Guardar imagen" }}
                                        </RockButton>

                                        <RockButton btnType="default" @click="startReplaceFlow" :disabled="busy" style="width: 100%;">
                                            Cambiar horario
                                        </RockButton>

                                        <a v-if="!busy" href="#" class="ssBackLink" @click.prevent="openCancelModal">Cancelar reserva</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Flujo por pasos -->
                            <div v-else class="card ssCard">
                                <div class="card-body">
                                    <!-- STEP 1: Campus -->
                                    <div v-if="step === 1" class="ssScreen">
                                        <div class="ssScreenTitle">Selecciona tu sede</div>
                                        <div class="ssScreenSub text-muted">Elige la sede para ver horarios disponibles.</div>

                                        <div class="ssCampusGrid">
                                            <div
                                                v-for="c in campusOptions"
                                                :key="c.value"
                                                role="button"
                                                tabindex="0"
                                                class="ssCampusCard"
                                                :class="{ isSelected: String(c.value) === String(campusId), isDisabled: busy }"
                                                @click="!busy && selectCampus(c)"
                                                @keydown.enter="!busy && selectCampus(c)">
                                                <div class="ssCampusImg">
                                                    <img v-if="c.imageUrl" :src="c.imageUrl" alt="Campus" class="ssCampusRealImg" />
                                                    <div v-else class="ssCampusInitials">{{ campusInitials(c.text) }}</div>
                                                </div>
                                                <div class="ssCampusName">{{ c.text }}</div>
                                            </div>
                                        </div>

                                        <div class="ssNav ssNavSingle">
                                            <RockButton v-if="replacing" btnType="default" @click="cancelReplaceFlow" :disabled="busy">
                                                Volver a mi reserva
                                            </RockButton>
                                        </div>
                                    </div>

                                    <!-- STEP 2: Cantidad -->
                                    <div v-else-if="step === 2" class="ssScreen">

                                        <div v-if="campusNameSelected" class="ssCampusHeading">Sede: {{ campusNameSelected }}</div>

                                        <div class="ssQtyWrap">
                                            <div class="ssQtyTitle">Cantidad de personas</div>
                                            <div class="ssQtySub text-muted">Máximo 8 personas.</div>

                                            <div class="ssQtyRow">
                                                <button class="ssQtyBtn" type="button" @click="decQty" :disabled="holdBusy || quantity <= 1">-</button>
                                                <div class="ssQtyVal">{{ quantity }}</div>
                                                <button class="ssQtyBtn" type="button" @click="incQty" :disabled="holdBusy || quantity >= 8">+</button>
                                            </div>
                                        </div>

                                        <div class="ssNav" :class="{ ssNavSingle: campusOptions.length === 1 }">
                                            <a v-if="campusOptions.length > 1 && !busy" href="#" class="ssBackLink" @click.prevent="step = 1">Atr&aacute;s</a>

                                            <RockButton
                                                btnType="primary"
                                                @click="goStep3"
                                                :disabled="busy || !campusId">
                                                Siguiente
                                            </RockButton>
                                        </div>
                                    </div>

                                    <!-- STEP 3: Horario -->
                                    <div v-else-if="step === 3" class="ssScreen">
                                        <div class="ssSummaryCard">
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Sede</div>
                                                <div class="ssVal">{{ campusNameSelected }}</div>
                                            </div>
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Cantidad</div>
                                                <div class="ssVal">{{ quantity }}</div>
                                            </div>
                                        </div>

                                        <div class="ssScreenTitle" style="margin-top: 16px;">Selecciona horario</div>

                                        <div v-if="weekBusy" class="text-muted ssSmall">Cargando horarios...</div>

                                        <div v-if="weekError" class="ssAlert">
                                            <NotificationBox alertType="danger">{{ weekError }}</NotificationBox>
                                        </div>

                                        <div v-if="!weekBusy && !weekError && availableDays.length === 0" class="text-muted ssSmall">
                                            No hay horarios con cupo disponible para esta sede esta semana. Prob&aacute; con otra sede o volv&eacute; a intentar m&aacute;s tarde.
                                        </div>

                                        <div v-if="availableDays.length > 0" class="ssSlots">
                                            <div v-for="d in availableDays" :key="d.occurrenceDate" class="ssDayBlock">
                                                <div class="ssDayTitle">{{ d.occurrenceDateText }}</div>

                                                <button
                                                    v-for="s in d.slots"
                                                    :key="s.slotId"
                                                    type="button"
                                                    class="ssSlotBtn"
                                                    :class="{ isSelected: s.slotId === selectedSlotId }"
                                                    :aria-pressed="s.slotId === selectedSlotId"
                                                    :disabled="busy"
                                                    @click="selectSlot(s)">
                                                    <div class="ssSlotTop">
                                                        <div class="ssSlotName">{{ s.scheduleName }}</div>
                                                        <div class="ssSlotCap">Cupo: {{ s.available }}</div>
                                                        <div class="ssSlotCheck" aria-hidden="true"></div>
                                                    </div>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="ssNav">
                                            <a v-if="!busy" href="#" class="ssBackLink" @click.prevent="step = 2">Atr&aacute;s</a>
                                        </div>
                                    </div>

                                    <!-- STEP 4: Confirmar -->
                                    <div v-else class="ssScreen">
                                        <div class="ssScreenTitle">Confirmar reserva</div>
                                        <div class="ssScreenSub text-muted">Revisa los detalles antes de confirmar.</div>

                                        <div v-if="selectedSummary" class="ssSummaryCard">
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Sede</div>
                                                <div class="ssVal">{{ selectedSummary.campusName }}</div>
                                            </div>
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Dia</div>
                                                <div class="ssVal">{{ selectedSummary.occurrenceDateText }}</div>
                                            </div>
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Horario</div>
                                                <div class="ssVal">{{ selectedSummary.scheduleName }}</div>
                                            </div>
                                            <div class="ssSummaryRow">
                                                <div class="ssLabel">Cantidad</div>
                                                <div class="ssVal">{{ quantity }}</div>
                                            </div>
                                        </div>

                                        <!-- Barra de progreso del hold -->
                                        <div v-if="holdToken && holdTimeRemaining > 0" class="ssHoldProgress">
                                            <div class="ssHoldProgressLabel">
                                                <span>Reservado</span>
                                                <span class="ssHoldTime">{{ holdCountdownText }}</span>
                                            </div>
                                            <div class="ssHoldProgressBar">
                                                <div class="ssHoldProgressFill" :style="{ width: holdProgressPercent + '%' }"></div>
                                            </div>
                                        </div>

                                        <div v-else-if="!holdToken && !holdError" class="ssSmall text-muted">
                                            {{ holdStatusText }}
                                        </div>

                                        <div v-if="holdError" class="ssAlert">
                                            <NotificationBox alertType="danger">{{ holdError }}</NotificationBox>
                                        </div>

                                        <div class="ssConfirmRow">
                                            <RockButton btnType="primary" @click="confirm" :disabled="busy || holdBusy || !holdToken">
                                                {{ busy ? "Procesando..." : "Confirmar reserva" }}
                                            </RockButton>

                                            <a href="#" class="ssBackLink" @click.prevent="step = 3" v-if="!busy">Atr&aacute;s</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Confirmar Cancelación -->
                        <div v-if="showCancelModal" class="ssModalOverlay" @click.self="closeCancelModal">
                            <div class="ssModalCard">
                                <div class="ssModalTitle">Cancelar reserva</div>
                                <div class="ssModalText">
                                    ¿Seguro que deseas cancelar tu reserva? Se liberar&aacute; tu lugar y tendr&aacute;s que registrarte de nuevo.
                                </div>

                                <div class="ssModalSummary" v-if="activeReservation">
                                    <div class="ssModalRow">
                                        <div class="ssModalLabel">Sede</div>
                                        <div class="ssModalVal">{{ activeReservation.campusName }}</div>
                                    </div>
                                    <div class="ssModalRow">
                                        <div class="ssModalLabel">Día</div>
                                        <div class="ssModalVal">{{ activeReservation.occurrenceDateText }}</div>
                                    </div>
                                    <div class="ssModalRow">
                                        <div class="ssModalLabel">Horario</div>
                                        <div class="ssModalVal">{{ activeReservation.scheduleName }}</div>
                                    </div>
                                    <div class="ssModalRow">
                                        <div class="ssModalLabel">Cantidad</div>
                                        <div class="ssModalVal">{{ activeReservation.quantity }}</div>
                                    </div>
                                </div>

                                <div class="ssModalActions">
                                    <RockButton btnType="default" @click="closeCancelModal" :disabled="busy">
                                        No, mantener
                                    </RockButton>

                                    <RockButton btnType="danger" @click="confirmCancelReservation" :disabled="busy">
                                        Sí, cancelar
                                    </RockButton>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Guardar Imagen -->
                        <!-- Fallback para WebView de iOS: ahi <a download>, data: y blob: no
                             descargan nada. Mostrar la imagen y dejar que el usuario la
                             mantenga presionada SI funciona en WKWebView. -->
                        <div v-if="showSaveModal" class="ssModalOverlay" @click.self="closeSaveModal">
                            <div class="ssModalCard">
                                <div class="ssModalTitle">Guardar tu QR</div>
                                <div class="ssModalText">
                                    Mantén presionada la imagen y elige <strong>Guardar en Fotos</strong>.
                                </div>

                                <div class="ssSaveImgWrap">
                                    <img :src="savedImageUrl" class="ssSaveImg" alt="Comprobante de reserva" />
                                </div>

                                <div class="ssModalActions" style="grid-template-columns: 1fr;">
                                    <RockButton btnType="primary" @click="closeSaveModal">
                                        Listo
                                    </RockButton>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Tiempo Expirado -->
                        <div v-if="showExpiredModal" class="ssModalOverlay" @click.self="closeExpiredModal">
                            <div class="ssModalCard">
                                <div class="ssModalTitle">Tiempo expirado</div>
                                <div class="ssModalText">
                                    El tiempo de reserva ha expirado. Por favor, intenta seleccionar tu horario nuevamente.
                                </div>

                                <div class="ssModalActions" style="grid-template-columns: 1fr;">
                                    <RockButton btnType="primary" @click="closeExpiredModal">
                                        Entendido
                                    </RockButton>
                                </div>
                            </div>
                        </div>

                        <!-- Toast -->
                        <div v-if="toast.show" class="ssToast" :class="toast.kind">
                            <div class="ssToastText">{{ toast.message }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, onBeforeUnmount, onMounted, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type CampusOptionBag = { text: string; value: string; imageUrl?: string };

type SlotBag = {
    slotId: number;
    campusId: number;
    occurrenceDate: string;
    scheduleId: number | null;
    scheduleName: string;

    capacity: number;
    reservedCount: number;
    holdCount: number;
    available: number;
    isAvailable: boolean;
};

type DaySlotsBag = {
    occurrenceDate: string;
    occurrenceDateText: string;
    slots: SlotBag[];
};

type ActiveReservationBag = {
    reservationId: number;
    reservationCode: string;
    quantity: number;
    status: number;

    campusId: number;
    campusName: string;
    occurrenceDate: string;
    occurrenceDateText: string;
    scheduleId: number | null;
    scheduleName: string;
};

type InitBag = {
    notLogged: boolean;
    statusHtml: string;
    campuses: CampusOptionBag[];
    activeReservation: ActiveReservationBag | null;
};

type GetWeekSlotsResponse = { days: DaySlotsBag[] };

type HoldUpsertResponse = {
    resultCode: number;
    holdToken: string;
    availableAfter: number;
    holdSeconds: number;
};

type ConfirmResponse = {
    resultCode: number;
    reservationId: number;
    reservationCode: string;
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const busy = ref<boolean>(false);
const holdBusy = ref<boolean>(false);
const holdUpdating = ref<boolean>(false);

const statusHtml = ref<string>(config.statusHtml || "");

const campusOptions = ref<CampusOptionBag[]>(config.campuses || []);
const activeReservation = ref<ActiveReservationBag | null>(config.activeReservation || null);
const replacing = ref<boolean>(false);

const step = ref<number>(1);

const campusId = ref<number | null>(null);

const days = ref<DaySlotsBag[]>([]);
const weekBusy = ref<boolean>(false);
const weekError = ref<string>("");

const selectedSlotId = ref<number | null>(null);
const selectedScheduleId = ref<number | null>(null);
const selectedOccurrenceDate = ref<string>("");

const quantity = ref<number>(1);

const holdToken = ref<string>("");
const holdError = ref<string>("");
const holdTimeRemaining = ref<number>(0); // segundos restantes

let holdDebounceTimer: number | null = null;
let holdCountdownTimer: number | null = null;
let holdRequestSeq = 0;
let holdInFlightSeq = 0;

const showCancelModal = ref<boolean>(false);
const showExpiredModal = ref<boolean>(false);

// Guardado del comprobante con QR
const qrImgEl = ref<HTMLImageElement | null>(null);
const pageEl = ref<HTMLElement | null>(null);
const downloadBusy = ref<boolean>(false);
const showSaveModal = ref<boolean>(false);
const savedImageUrl = ref<string>("");

type ToastKind = "success" | "danger" | "info";
const toast = ref<{ show: boolean; kind: ToastKind; message: string }>({
    show: false,
    kind: "info",
    message: ""
});

let toastTimer: number | null = null;

function showToast(kind: ToastKind, message: string) {
    toast.value = { show: true, kind, message };

    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
        toastTimer = null;
    }

    toastTimer = window.setTimeout(() => {
        toast.value.show = false;
        toastTimer = null;
    }, 2800);
}

function openCancelModal() {
    if (!activeReservation.value) return;
    showCancelModal.value = true;
}

function closeCancelModal() {
    showCancelModal.value = false;
}

function closeExpiredModal() {
    showExpiredModal.value = false;
    resetSelection();

    // Si solo hay un campus, seleccionarlo automáticamente y ir al paso 2
    if (campusOptions.value.length === 1) {
        const singleCampus = campusOptions.value[0];
        selectCampus(singleCampus);
    } else {
        step.value = 1;
    }
}

function qrUrl(code: string): string {
    // Sin parametro 'size': GetQRCode.ashx no lo lee (solo data, outputType,
    // foreground, background, pixelsPerModule). Una sola URL para el <img> y para
    // el canvas, asi el guardado reusa la imagen ya cacheada en vez de re-pedirla.
    return `/GetQRCode.ashx?data=${encodeURIComponent(code)}`;
}

/**
 * Detecta iOS, incluido iPadOS 13+ que se reporta como Macintosh con touch.
 */
function isIOS(): boolean {
    const ua = navigator.userAgent || "";
    const isTouchMac = /Macintosh/.test(ua) && (navigator.maxTouchPoints ?? 0) > 1;
    return /iPad|iPhone|iPod/.test(ua) || isTouchMac;
}

/**
 * Dibuja el comprobante en un canvas y devuelve el data URL del JPEG.
 *
 * Es deliberadamente SINCRONO: usa el <img> del QR que ya esta renderizado en
 * pantalla en vez de volver a pedir la imagen por red. Dos razones:
 *  1. navigator.share() exige user activation. Un await de red antes de llamarlo
 *     hace que Safari lo rechace con NotAllowedError.
 *  2. Evita un round-trip inutil: GetQRCode.ashx no manda Cache-Control.
 */
function buildReservationDataUrl(qrImg: HTMLImageElement): string | null {
    if (!activeReservation.value) {
        return null;
    }

    const res = activeReservation.value;
    const qrSize = 280;
    const canvasWidth = 420;
    const canvasHeight = 580;
    const padding = 30;

    const canvas = document.createElement("canvas");
    canvas.width = canvasWidth;
    canvas.height = canvasHeight;

    const ctx = canvas.getContext("2d");
    if (!ctx) {
        return null;
    }

    ctx.fillStyle = "#FFFFFF";
    ctx.fillRect(0, 0, canvasWidth, canvasHeight);

    ctx.fillStyle = "#111827";
    ctx.font = "bold 24px -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("VidaReal.tv", canvasWidth / 2, 45);

    const infoY = 80;
    const colWidth = (canvasWidth - padding * 2) / 2;

    const drawInfo = (label: string, value: string, x: number, y: number): void => {
        ctx.fillStyle = "#6B7280";
        ctx.font = "600 11px -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
        ctx.textAlign = "left";
        ctx.fillText(label.toUpperCase(), x, y);

        ctx.fillStyle = "#111827";
        ctx.font = "bold 14px -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
        ctx.fillText(value, x, y + 18);
    };

    drawInfo("Campus", res.campusName, padding, infoY);
    drawInfo("Dia", res.occurrenceDateText, padding + colWidth, infoY);
    drawInfo("Horario", res.scheduleName, padding, infoY + 50);
    drawInfo("Cantidad", String(res.quantity), padding + colWidth, infoY + 50);

    const qrX = (canvasWidth - qrSize) / 2;
    const qrY = 195;

    ctx.strokeStyle = "#E5E7EB";
    ctx.lineWidth = 2;
    ctx.strokeRect(qrX - 4, qrY - 4, qrSize + 8, qrSize + 8);
    ctx.drawImage(qrImg, qrX, qrY, qrSize, qrSize);

    ctx.fillStyle = "#9CA3AF";
    ctx.font = "12px -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("Presenta este codigo QR al ingresar", canvasWidth / 2, qrY + qrSize + 35);

    // toDataURL puede lanzar SecurityError si el canvas quedo tainted, o devolver
    // "data:," cuando iOS se queda sin memoria de canvas. El llamador valida.
    const dataUrl = canvas.toDataURL("image/jpeg", 0.95);
    if (!dataUrl || dataUrl.length < 100) {
        return null;
    }

    return dataUrl;
}

function dataUrlToFile(dataUrl: string, fileName: string): File | null {
    try {
        const comma = dataUrl.indexOf(",");
        if (comma < 0) {
            return null;
        }

        const binary = atob(dataUrl.slice(comma + 1));
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
        }

        return new File([bytes], fileName, { type: "image/jpeg" });
    }
    catch {
        return null;
    }
}

function closeSaveModal(): void {
    showSaveModal.value = false;
    savedImageUrl.value = "";
}

/**
 * Guarda el comprobante con QR.
 *
 * La version anterior hacia link.href = canvas.toDataURL(); link.click(), que en
 * iOS no descarga nada: Safari tiene soporte pobre del atributo download y
 * bloquea la navegacion top-level a data: URIs, asi que el WebView se quedaba
 * "pensando" sin descargar ni avisar. En WKWebView es peor todavia, porque no hay
 * gestor de descargas: ni download, ni blob:, ni data: producen un archivo.
 *
 * Estrategia actual:
 *  1. Web Share API con el archivo, que abre la hoja nativa con "Guardar en Fotos".
 *  2. Si no esta disponible (comun en WebView), modal con la imagen para mantener
 *     presionado y guardar. Eso si funciona en WKWebView.
 *  3. En Android y escritorio, descarga normal con blob URL y <a download>
 *     agregado al DOM (desconectado, varios navegadores ignoran el click).
 */
async function downloadImage(): Promise<void> {
    if (!activeReservation.value || downloadBusy.value) {
        return;
    }

    downloadBusy.value = true;

    try {
        const res = activeReservation.value;
        const fileName = `reserva-${res.reservationCode}.jpg`;
        const imgEl = qrImgEl.value;

        // El QR debe estar ya cargado en pantalla. Si no lo esta no forzamos una
        // carga por red aqui: perderiamos la user activation que necesita share().
        if (!imgEl || !imgEl.complete || imgEl.naturalWidth === 0) {
            showToast("danger", "El codigo QR aun se esta cargando. Intenta de nuevo.");
            return;
        }

        let dataUrl: string | null = null;
        try {
            dataUrl = buildReservationDataUrl(imgEl);
        }
        catch {
            dataUrl = null;
        }

        if (!dataUrl) {
            showToast("danger", "No se pudo generar la imagen.");
            return;
        }

        const file = dataUrlToFile(dataUrl, fileName);

        // 1) Web Share API: la unica via que guarda directo en Fotos en iOS.
        const nav = navigator as Navigator & {
            canShare?: (data: unknown) => boolean;
            share?: (data: unknown) => Promise<void>;
        };

        if (file
            && typeof nav.share === "function"
            && typeof nav.canShare === "function"
            && nav.canShare({ files: [file] })) {
            try {
                await nav.share({ files: [file], title: "Mi reserva" });
                return; // la hoja del sistema ya dio feedback
            }
            catch (err) {
                // El usuario cerro la hoja: no es un error que reportar.
                if ((err as DOMException)?.name === "AbortError") {
                    return;
                }
                // Cualquier otra falla cae al siguiente metodo.
            }
        }

        // 2) iOS o WebView sin Web Share: mostrar para mantener presionado.
        if (isIOS()) {
            savedImageUrl.value = dataUrl;
            showSaveModal.value = true;
            return;
        }

        // 3) Android y escritorio: descarga real con blob URL.
        const objectUrl = file ? URL.createObjectURL(file) : dataUrl;
        try {
            const link = document.createElement("a");
            link.href = objectUrl;
            link.download = fileName;
            link.rel = "noopener";
            document.body.appendChild(link); // debe estar en el DOM para que click() funcione
            link.click();
            document.body.removeChild(link);
            showToast("success", "Imagen descargada");
        }
        finally {
            if (file) {
                window.setTimeout(() => URL.revokeObjectURL(objectUrl), 10000);
            }
        }
    }
    catch {
        showToast("danger", "No se pudo guardar la imagen.");
    }
    finally {
        downloadBusy.value = false;
    }
}

const nextOccurrenceDateText = computed<string>(() => {
    if (!days.value || days.value.length === 0) return "";
    return days.value[0]?.occurrenceDateText || "";
});

const campusNameSelected = computed<string>(() => {
    if (!campusId.value) return "";
    const found = campusOptions.value.find(x => x.value === String(campusId.value));
    return found?.text || "";
});

const availableDays = computed<DaySlotsBag[]>(() => {
    return (days.value || [])
        .map(d => ({
            ...d,
            slots: (d.slots || []).filter(s => s.isAvailable && s.available >= quantity.value)
        }))
        .filter(d => d.slots.length > 0);
});

function campusInitials(name: string): string {
    const parts = (name || "").trim().split(/\s+/).filter(Boolean);
    if (parts.length === 0) return "";
    const first = parts[0]?.charAt(0) || "";
    const second = parts.length > 1 ? parts[1]?.charAt(0) || "" : (parts[0]?.charAt(1) || "");
    return (first + second).toUpperCase();
}

function selectCampus(c: CampusOptionBag) {
    if (busy.value) return;
    const n = Number(c.value);
    campusId.value = Number.isFinite(n) ? n : null;
    if (campusId.value) {
        step.value = 2;
    }
}

function resetHold() {
    holdToken.value = "";
    holdError.value = "";
    holdUpdating.value = false;
    holdTimeRemaining.value = 0;

    if (holdCountdownTimer != null) {
        window.clearInterval(holdCountdownTimer);
        holdCountdownTimer = null;
    }
}

function startHoldCountdown(seconds: number) {
    // Limpiar timer anterior si existe
    if (holdCountdownTimer != null) {
        window.clearInterval(holdCountdownTimer);
        holdCountdownTimer = null;
    }

    // Contamos con el reloj local del dispositivo: el backend manda duración,
    // no fecha, para no depender de la zona horaria del navegador.
    const expiresMs = Date.now() + seconds * 1000;

    const updateRemaining = () => {
        const diffSec = Math.floor((expiresMs - Date.now()) / 1000);

        if (diffSec <= 0) {
            holdTimeRemaining.value = 0;
            if (holdCountdownTimer != null) {
                window.clearInterval(holdCountdownTimer);
                holdCountdownTimer = null;
            }
            // Mostrar modal de expiración
            holdToken.value = "";
            holdError.value = "";
            showExpiredModal.value = true;
        } else {
            holdTimeRemaining.value = diffSec;
        }
    };

    // Actualizar inmediatamente
    updateRemaining();

    // Actualizar cada segundo
    holdCountdownTimer = window.setInterval(updateRemaining, 1000);
}

function resetSelection() {
    days.value = [];
    weekError.value = "";
    selectedSlotId.value = null;
    selectedScheduleId.value = null;
    selectedOccurrenceDate.value = "";
    quantity.value = 1;
    resetHold();
}

function parseTimeFromScheduleName(name: string): number {
    const m = (name || "").match(/(\d{1,2})\s*:\s*(\d{2})/);
    if (!m) return 9999;

    const h = Number(m[1]);
    const min = Number(m[2]);

    if (!Number.isFinite(h) || !Number.isFinite(min)) return 9999;
    return h * 60 + min;
}

function sortDaysAndSlots(input: DaySlotsBag[]): DaySlotsBag[] {
    const daysCopy = (input || []).map(d => ({
        ...d,
        slots: [...(d.slots || [])].sort((a, b) => {
            return parseTimeFromScheduleName(a.scheduleName) - parseTimeFromScheduleName(b.scheduleName);
        })
    }));

    daysCopy.sort((a, b) => (a.occurrenceDate || "").localeCompare(b.occurrenceDate || ""));
    return daysCopy;
}

async function loadWeekSlots(force: boolean) {
    if (!campusId.value) return;

    if (!force && (weekBusy.value || days.value.length > 0 || weekError.value)) return;

    weekBusy.value = true;
    weekError.value = "";

    try {
        const res = await invokeBlockAction<any>("GetWeekSlots", { bag: { campusId: campusId.value } });

        if (!res.isSuccess) {
            weekError.value = res.errorMessage || "No se pudieron cargar los horarios.";
            days.value = [];
            return;
        }

        const data = res.data as GetWeekSlotsResponse;
        days.value = sortDaysAndSlots(data?.days || []);
    } catch {
        weekError.value = "Error cargando horarios.";
        days.value = [];
    } finally {
        weekBusy.value = false;
    }
}

watch(campusId, async () => {
    resetSelection();
    if (!campusId.value) return;
    await loadWeekSlots(true);
});

function startReplaceFlow() {
    replacing.value = true;
    statusHtml.value = "";
    step.value = 1;
    resetSelection();
    void loadWeekSlots(true);
}

function cancelReplaceFlow() {
    replacing.value = false;
    resetSelection();
    step.value = 1;
}

async function goStep3() {
    if (!campusId.value) return;
    step.value = 3;

    if (days.value.length === 0 && !weekBusy.value) {
        await loadWeekSlots(true);
    }
}

function selectSlot(s: SlotBag) {
    if (!s.isAvailable) return;

    selectedSlotId.value = s.slotId;
    selectedScheduleId.value = s.scheduleId ?? null;
    selectedOccurrenceDate.value = s.occurrenceDate;

    resetHold();
    scheduleHoldUpsert();
    
    // Avanzar al paso 4 (Confirmar)
    step.value = 4;
}

function incQty() {
    if (quantity.value >= 8) return;
    quantity.value++;
    scheduleHoldUpsert();
}

function decQty() {
    if (quantity.value <= 1) return;
    quantity.value--;
    scheduleHoldUpsert();
}

function scheduleHoldUpsert() {
    holdError.value = "";

    if (!campusId.value || !selectedOccurrenceDate.value || !selectedScheduleId.value) return;

    holdUpdating.value = true;

    if (holdDebounceTimer != null) {
        window.clearTimeout(holdDebounceTimer);
        holdDebounceTimer = null;
    }

    holdDebounceTimer = window.setTimeout(() => {
        holdDebounceTimer = null;
        void doHoldUpsertLatest();
    }, 250);
}

async function doHoldUpsertLatest() {
    if (!campusId.value || !selectedOccurrenceDate.value || !selectedScheduleId.value) return;

    const mySeq = ++holdRequestSeq;
    holdInFlightSeq = mySeq;

    holdBusy.value = true;

    try {
        const res = await invokeBlockAction<any>("HoldUpsert", {
            bag: {
                campusId: campusId.value,
                occurrenceDate: selectedOccurrenceDate.value,
                scheduleId: selectedScheduleId.value,
                quantity: quantity.value,
                holdMinutes: 2
            }
        });

        if (mySeq !== holdInFlightSeq) return;

        if (!res.isSuccess) {
            holdError.value = res.errorMessage || "No pudimos apartar tu lugar. Reintentá en unos segundos.";
            holdToken.value = "";
            return;
        }

        const data = res.data as HoldUpsertResponse;

        if (data.resultCode !== 1) {
            holdError.value = data.resultCode === 0
                ? "Ese horario ya no tiene lugar para esa cantidad. Probá con menos personas o elegí otro horario."
                : data.resultCode === -1
                    ? "El horario ya no existe o no está activo."
                    : "No pudimos apartar tu lugar. Reintentá en unos segundos.";
            holdToken.value = "";
            void refreshWeekSilent();
            return;
        }

        holdToken.value = data.holdToken || "";

        // Iniciar el countdown
        if (data.holdSeconds > 0) {
            startHoldCountdown(data.holdSeconds);
        }

        void refreshWeekSilent();
    } catch {
        if (mySeq === holdInFlightSeq) {
            holdError.value = "Error creando el hold.";
            holdToken.value = "";
        }
    } finally {
        if (mySeq === holdInFlightSeq) {
            holdBusy.value = false;
            holdUpdating.value = false;
        }
    }
}

async function refreshWeekSilent() {
    if (!campusId.value) return;

    try {
        const res = await invokeBlockAction<any>("GetWeekSlots", { bag: { campusId: campusId.value } });

        if (res.isSuccess && res.data?.days) {
            days.value = sortDaysAndSlots(res.data.days as DaySlotsBag[]);

            // Solo validar disponibilidad si NO tenemos un hold activo
            // Si tenemos hold válido, significa que ya tomamos el cupo
            if (selectedSlotId.value && !holdToken.value) {
                const still = findSlotById(selectedSlotId.value);
                if (!still || !still.isAvailable) {
                    selectedSlotId.value = null;
                    selectedScheduleId.value = null;
                    selectedOccurrenceDate.value = "";
                    resetHold();
                    step.value = 2;
                }
            }
        }
    } catch {
    }
}

function findSlotById(slotId: number): SlotBag | null {
    for (const d of days.value) {
        const s = d.slots.find(x => x.slotId === slotId);
        if (s) return s;
    }
    return null;
}

const holdCountdownText = computed<string>(() => {
    if (holdTimeRemaining.value <= 0) return "00:00";

    const mins = Math.floor(holdTimeRemaining.value / 60);
    const secs = holdTimeRemaining.value % 60;

    const minsStr = String(mins).padStart(2, "0");
    const secsStr = String(secs).padStart(2, "0");

    return `${minsStr}:${secsStr}`;
});

// Porcentaje de tiempo restante (0-100%)
const holdProgressPercent = computed<number>(() => {
    const totalSeconds = 120; // 2 minutos = 120 segundos
    if (holdTimeRemaining.value <= 0) return 0;
    if (holdTimeRemaining.value >= totalSeconds) return 100;
    return (holdTimeRemaining.value / totalSeconds) * 100;
});

const holdStatusText = computed<string>(() => {
    if (!selectedSlotId.value) return "Elegí un horario para apartar tu lugar.";
    if (holdError.value) return "No pudimos apartar tu lugar.";
    if (holdUpdating.value) return "Apartando tu lugar…";
    if (!holdToken.value) return "Apartando tu lugar…";
    if (holdTimeRemaining.value > 0) return `Lugar apartado (${holdCountdownText.value})`;
    return "Lugar apartado.";
});

const selectedSummary = computed<null | { campusName: string; occurrenceDateText: string; scheduleName: string }>(() => {
    if (!selectedSlotId.value) return null;

    const slot = findSlotById(selectedSlotId.value);
    if (!slot) return null;

    const day = days.value.find(d => d.occurrenceDate === slot.occurrenceDate);

    return {
        campusName: campusNameSelected.value || "Campus",
        occurrenceDateText: day?.occurrenceDateText || slot.occurrenceDate,
        scheduleName: slot.scheduleName
    };
});

async function confirm() {
    if (busy.value) return;

    holdError.value = "";

    if (!holdToken.value) {
        holdError.value = "No hay hold vigente. Intenta de nuevo.";
        return;
    }

    const previousReservationId = activeReservation.value?.reservationId ?? null;
    busy.value = true;

    try {
        const res = await invokeBlockAction<any>("ConfirmReservation", {
            bag: {
                // Siempre true: las reservas de fechas pasadas quedan con Status=1
                // en BD (el filtro de "activa" es solo de lectura), asi que sin
                // force la confirmacion fallaria con -3 para esos usuarios.
                forceReplaceExisting: true,
                holdToken: holdToken.value,
                esReemplazo: replacing.value
            }
        });

        if (!res.isSuccess) {
            await refreshActive();

            if (activeReservation.value && activeReservation.value.reservationId !== previousReservationId) {
                replacing.value = false;
                resetSelection();
                await refreshWeekSilent();
                step.value = 1;
                return;
            }

            holdError.value = res.errorMessage || "No se pudo confirmar.";
            return;
        }

        const data = res.data as ConfirmResponse;

        if (data.resultCode !== 1) {
            await refreshActive();

            if (activeReservation.value && activeReservation.value.reservationId !== previousReservationId) {
                replacing.value = false;
                resetSelection();
                await refreshWeekSilent();
                step.value = 1;
                return;
            }

            holdError.value = data.resultCode === 0 || data.resultCode === -1
                ? "Se venció el tiempo para confirmar. Elegí tu horario de nuevo."
                : data.resultCode === -2 || data.resultCode === -3
                    ? "Ya existe otra reserva activa para esta persona."
                    : "No pudimos confirmar tu reserva. Reintentá en unos segundos.";
            void refreshWeekSilent();
            resetHold();
            return;
        }

        await refreshActive();
        await refreshWeekSilent();
        replacing.value = false;
        resetSelection();
        step.value = 1;
    } catch {
        await refreshActive();

        if (activeReservation.value && activeReservation.value.reservationId !== previousReservationId) {
            replacing.value = false;
            resetSelection();
            await refreshWeekSilent();
            step.value = 1;
            return;
        }

        holdError.value = "Error confirmando reserva.";
    } finally {
        busy.value = false;
    }
}

async function refreshActive() {
    try {
        const res = await invokeBlockAction<any>("GetActiveReservation", {});
        if (res.isSuccess) {
            activeReservation.value = (res.data?.activeReservation || null) as ActiveReservationBag | null;
        }
    } catch {
    }
}

async function confirmCancelReservation() {
    if (!activeReservation.value) return;
    if (busy.value) return;

    const reservationId = activeReservation.value.reservationId;
    const previousReservationId = activeReservation.value?.reservationId ?? null;
    busy.value = true;

    try {
        const res = await invokeBlockAction<any>("CancelReservation", {
            bag: { reservationId }
        });

        if (!res.isSuccess) {
            showToast("danger", res.errorMessage || "No se pudo cancelar la reserva.");
            return;
        }

        const resultCode = Number(res.data?.resultCode ?? 0);

        if (resultCode !== 1) {
            await refreshActive();

            // Si backend ya no reporta esa reserva como activa,
            // tratamos la operacion como exitosa para evitar falso error en UI.
            if (!activeReservation.value || activeReservation.value.reservationId !== reservationId) {
                await refreshWeekSilent();
                showCancelModal.value = false;
                activeReservation.value = null;
                replacing.value = false;
                resetSelection();
                showToast("success", "Reserva cancelada.");
                return;
            }

            showToast("danger", resultCode === 0
                ? "La reserva ya no estaba activa."
                : resultCode === -2
                    ? "La reserva ya no existe o ya no te pertenece."
                    : "No se pudo cancelar. Intenta de nuevo.");
            return;
        }

        await refreshActive();
        await refreshWeekSilent();
        showCancelModal.value = false;
        activeReservation.value = null;
        replacing.value = false;
        resetSelection();

        showToast("success", "Reserva cancelada.");
    } catch {
        showToast("danger", "Error cancelando reserva.");
    } finally {
        busy.value = false;

        // Si solo hay un campus, seleccionarlo automáticamente y ir al paso 2
        if (campusOptions.value.length === 1) {
            const singleCampus = campusOptions.value[0];
            const n = Number(singleCampus.value);
            campusId.value = Number.isFinite(n) ? n : null;
            if (campusId.value) {
                step.value = 2;
            }
        } else {
            step.value = 1;
        }
    }
}

// Auto-selección de campus si solo hay uno disponible
/**
 * Full-bleed: el bloque vive dentro de los contenedores de Rock (page-content,
 * container, panel-body...), que aportan padding lateral propio. En vez de
 * adivinar cuanto es, se mide el ancho real del viewport SIN la barra de scroll
 * (clientWidth) y se expone como --vr-viewport; el CSS lo usa para estirarse con
 * margenes negativos. El fallback del CSS es 100vw, que en escritorio incluiria
 * el ancho de la barra y provocaria scroll horizontal.
 */
function applyFullBleed(): void {
    const el = pageEl.value;
    if (!el) return;
    const w = document.documentElement.clientWidth;
    el.style.setProperty("--vr-viewport", `${w}px`);
}

/** Evita el zoom por doble tap sin bloquear el pinch-zoom (accesibilidad). */
function onDoubleClick(e: Event): void {
    e.preventDefault();
}

onMounted(() => {
    applyFullBleed();
    window.addEventListener("resize", applyFullBleed);
    window.addEventListener("orientationchange", applyFullBleed);
    pageEl.value?.addEventListener("dblclick", onDoubleClick);

    // Si no hay reserva activa y solo hay 1 campus, seleccionarlo automáticamente
    if (!activeReservation.value && !replacing.value && campusOptions.value.length === 1) {
        const singleCampus = campusOptions.value[0];
        selectCampus(singleCampus);
    }
});

// También auto-seleccionar cuando se inicia el flujo de reemplazo
watch(replacing, (newVal) => {
    if (newVal && step.value === 1 && campusOptions.value.length === 1) {
        const singleCampus = campusOptions.value[0];
        selectCampus(singleCampus);
    }
});

// Limpiar timers y listeners al desmontar el bloque
onBeforeUnmount(() => {
    window.removeEventListener("resize", applyFullBleed);
    window.removeEventListener("orientationchange", applyFullBleed);
    pageEl.value?.removeEventListener("dblclick", onDoubleClick);

    if (holdCountdownTimer != null) {
        window.clearInterval(holdCountdownTimer);
        holdCountdownTimer = null;
    }
    if (holdDebounceTimer != null) {
        window.clearTimeout(holdDebounceTimer);
        holdDebounceTimer = null;
    }
    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
        toastTimer = null;
    }
});
</script>

<style>
/* ============================================================
   Registro Servicio Dominical — Vida Real
   Design system: Brújula VR (tokens de colors.css / base.css).
   Tipografía: Montserrat (servida por RockWeb, ver más abajo).
   Todo el CSS vive bajo .vrPage para no filtrarse a otros bloques.
   ============================================================ */

/* Montserrat servida por RockWeb (ver /Assets/Fonts/Montserrat/montserrat.css).
   Se declara aquí porque el tema aún no enlaza ese CSS; si el tema lo agrega,
   estas reglas duplicadas son inocuas. Montserrat © Julieta Ulanovsky (SIL OFL 1.1). */
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Regular.woff2") format("woff2"), url("/Assets/Fonts/Montserrat/Montserrat-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Medium.woff2") format("woff2"), url("/Assets/Fonts/Montserrat/Montserrat-Medium.ttf") format("truetype");
    font-weight: 500; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.woff2") format("woff2"), url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.ttf") format("truetype");
    font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Bold.woff2") format("woff2"), url("/Assets/Fonts/Montserrat/Montserrat-Bold.ttf") format("truetype");
    font-weight: 700; font-style: normal; font-display: swap;
}

/* ===== Chrome del panel y contenedores de Rock: solo para este bloque =====
   El bloque se dibuja a sangre completa, asi que se neutraliza el padding y el
   margen que aportan los envoltorios de la pagina. Todos los selectores estan
   condicionados con :has(.vrPage), asi que no tocan otros bloques. */
.panel-block:has(.vrPage) > .panel-heading,
.panel-block:has(.vrPage) > .panel-header { display: none !important; }
.panel-block:has(.vrPage) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}
.panel-block:has(.vrPage) > .panel-body { padding: 0 !important; }

:is(.page-content, .container, .container-fluid, .row, .block-instance,
    .zone, .zone-content, .block-content, [class*="col-"]):has(.vrPage) {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

/* ===== Tokens Brújula VR — tema claro ===== */
.vrPage {
    --vr-navy: #0F334B;
    --vr-navy-800: #143E5A;
    --vr-navy-600: #2B577A;
    --vr-red: #E74133;
    --vr-red-hover: #C93225;
    --vr-steel: #A2BACA;

    --bg: #F3F5F7;
    --paper: #FFFFFF;
    --paper-alt: #F8FAFB;
    --ink: #0F334B;
    --ink-strong: #0F334B;
    --ink-soft: #5A6E7C;
    --ink-faint: #8296A6;
    --rule: #E1E7EC;
    --rule-strong: #C9D4DC;
    --action: #1E5B87;
    --action-soft: #EAF1F6;
    --action-line: #CFE0EC;

    --ok-fill: #39B396;  --ok-text: #1E7A64;  --ok-bg: #E9F6F2;
    --err-fill: #E74133; --err-text: #B02E22; --err-bg: #FCEAE8;
    --neu-text: #5A6E7C; --neu-bg: #EFF3F6;

    --btn-primary: #0F334B;
    --btn-primary-hover: #143E5A;
    --btn-primary-ink: #FFFFFF;
    --focus-ring: rgba(30,91,135,.28);
    --shadow-card: 0 1px 2px rgba(15,51,75,.06), 0 2px 8px rgba(15,51,75,.05);
    --shadow-pop: 0 8px 28px rgba(15,51,75,.18), 0 0 0 1px rgba(15,51,75,.05);

    --radius-sm: 6px;
    --radius: 10px;
    --radius-lg: 14px;

    --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px;
    --sp-4-5: 18px; --sp-5: 20px; --sp-6: 24px;

    --font-body: "Montserrat", "Segoe UI", system-ui, sans-serif;

    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.45;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    padding-bottom: var(--sp-4-5);
    -webkit-font-smoothing: antialiased;
    /* Sin zoom por doble tap (el pinch-zoom sigue disponible) */
    touch-action: manipulation;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;

    /* Full-bleed: anula el padding lateral de los contenedores de Rock.
       --vr-viewport lo fija onMounted con el clientWidth real; 100vw es el
       fallback si el script no llega a correr. */
    --vr-viewport: 100vw;
    width: var(--vr-viewport);
    max-width: var(--vr-viewport);
    margin-left: calc(50% - var(--vr-viewport) / 2);
    margin-right: calc(50% - var(--vr-viewport) / 2);
}

/* El double-tap zoom se dispara en el elemento tocado, no solo en el contenedor */
.vrPage * { touch-action: manipulation; }

/* ===== Tokens Brújula VR — tema oscuro ===== */
[data-theme="dark"] .vrPage {
    --bg: #0B1D2B;
    --paper: #112A3D;
    --paper-alt: #0E2434;
    --ink: #DEE9F0;
    --ink-strong: #EAF2F7;
    --ink-soft: #A7BBC8;
    --ink-faint: #7D93A3;
    --rule: #1F3D53;
    --rule-strong: #2C5069;
    --action: #7FB4D9;
    --action-soft: #16324A;
    --action-line: #2A506C;

    --ok-fill: #4FC7A9;  --ok-text: #63D3B6; --ok-bg: #0F3B32;
    --err-fill: #F0685C; --err-text: #F58C81; --err-bg: #46201C;
    --neu-text: #A7BBC8; --neu-bg: #16303F;

    --btn-primary: #A8CCE4;
    --btn-primary-hover: #BFDAEC;
    --btn-primary-ink: #0B1D2B;
    --focus-ring: rgba(127,180,217,.4);
    --shadow-card: 0 1px 2px rgba(0,0,0,.35), 0 2px 10px rgba(0,0,0,.3);
    --shadow-pop: 0 10px 32px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.06);
}

.vrPage *, .vrPage *::before, .vrPage *::after { box-sizing: border-box; }

/* Permitir selección de texto en campos de entrada y texto informativo */
.vrPage input,
.vrPage textarea,
.vrPage .ssCode,
.vrPage .ssModalText,
.vrPage .ssQrInfoText,
.vrPage .ssScreenSub {
    -webkit-user-select: text;
    -moz-user-select: text;
    user-select: text;
}

/* Foco visible en ambos temas (guía 6) */
.vrPage a:focus-visible,
.vrPage button:focus-visible,
.vrPage [role="button"]:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring);
}

/* ===== Banda institucional (navy 56px, guía 5) =====
   Sin contenido: la marca "VidaReal.tv" se quito el 2026-08-26. Se conserva la
   franja como cabecera de color; con ella se van .vrBrand, .vrTopActions y
   .vrIconBtn, que ya no tienen markup que estilizar. */
.vrTopBar {
    height: 56px;
    background: var(--vr-navy);
    position: sticky;
    top: 0;
    z-index: 50;
}

.vrContainer {
    max-width: 980px;
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-4) var(--sp-6);
}

/* Compat: text-muted estable aunque el theme de Rock cambie */
.vrPage .text-muted { color: var(--ink-soft) !important; }

.sswrap {
    max-width: 980px;
    margin: 0 auto;
    font-family: var(--font-body);
    color: var(--ink);
}

/* ===== Stepper ===== */
.ssStepper {
    position: sticky;
    top: 56px;
    z-index: 10;
    background: var(--bg);
    padding: var(--sp-3) var(--sp-1);
    border-bottom: 1px solid var(--rule);
    display: grid;
    /* 4 steps = 4 autos + 3 frs lines */
    grid-template-columns: auto 1fr auto 1fr auto 1fr auto;
    align-items: center;
    gap: var(--sp-2);
}

.ssStep {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: var(--sp-2);
    align-items: center;
    min-width: 0;
}

@media (max-width: 576px) {
    .ssStepText { display: none; }
    .ssStepper { gap: var(--sp-1); }
}

.ssDot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-faint);
    background: var(--paper);
    transition: background 150ms, border-color 150ms, color 150ms;
}

.ssStepText {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-faint);
    transition: color 150ms;
}

.ssLine {
    height: 2px;
    background: var(--rule);
    border-radius: 50%;
    transition: background 150ms;
}

/* Paso activo = acento rojo (guía 2: tick activo de nav) */
.ssStep.active .ssDot {
    border-color: var(--vr-red);
    color: var(--vr-red);
}
.ssStep.active .ssStepText { color: var(--ink-strong); }

.ssStep.done .ssDot {
    background: var(--vr-navy);
    border-color: var(--vr-navy);
    color: #FFFFFF;
}
[data-theme="dark"] .ssStep.done .ssDot {
    background: var(--btn-primary);
    border-color: var(--btn-primary);
    color: var(--btn-primary-ink);
}
.ssStep.done .ssStepText { color: var(--ink-soft); }
.ssLine.done { background: var(--rule-strong); }

/* ===== Cards (guía 5: fondo paper, radio 10, shadow-card, sin borde) ===== */
.ssCard {
    margin-top: var(--sp-3);
    background: var(--paper);
    border: none;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
}

.ssCard .card-body { padding: var(--sp-5); }

/* ===== Screens ===== */
.ssScreenTitle {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-strong);
    margin-bottom: var(--sp-1);
}

.ssScreenSub {
    font-size: 13px;
    margin-bottom: var(--sp-4);
}

.ssFormGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
}

/* ===== Selector de sede ===== */
.ssCampusGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-4);
    justify-content: center;
}

@media (max-width: 576px) {
    /* Tarjetas más grandes en móvil (casi full width si solo hay una) */
    .ssCampusGrid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .ssCampusImg { height: 170px; flex: 0 0 170px; }
}

.ssCampusCard {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
    padding: 0 0 var(--sp-3);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 150ms, box-shadow 150ms;
    height: auto !important; /* evita restricciones de altura del botón */
}

.ssCampusCard:hover { border-color: var(--action-line); }

.ssCampusCard.isDisabled {
    opacity: .6;
    cursor: not-allowed;
    pointer-events: none;
}

.ssCampusCard.isSelected {
    border-color: var(--action);
    box-shadow: 0 0 0 1px var(--action), var(--shadow-card);
}

/* Superficie plana, sin gradiente decorativo (guía 5) */
.ssCampusImg {
    width: 100%;
    height: 140px;
    flex: 0 0 140px;
    background: var(--paper-alt);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
}

.ssCampusInitials {
    font-weight: 600;
    font-size: 24px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

.ssCampusName {
    padding: var(--sp-3) var(--sp-3) 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-strong);
    background: var(--paper);
    line-height: 1.3;
}

.ssCampusRealImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.ssCampusHeading {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-strong);
    margin-bottom: var(--sp-4);
    text-align: center;
}

/* ===== Navegación entre pasos ===== */
.ssNav {
    margin-top: var(--sp-5);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    align-items: center;
}

.ssNavSingle { grid-template-columns: 1fr; }

/* ===== Resumen (label/valor) ===== */
.ssSummaryCard {
    background: var(--paper-alt);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-3);
}

.ssSummaryRow {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-1) 0;
}

.ssLabel {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    line-height: 1.35;
    color: var(--ink-faint);
}

.ssVal {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-strong);
    text-align: right;
}

.ssSummaryPill {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: center;
    padding: var(--sp-3);
    border-radius: var(--radius);
    background: var(--paper-alt);
    border: 1px solid var(--rule);
    margin-bottom: var(--sp-3);
}

.ssPillLabel {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-faint);
}

.ssPillValue {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ssStep3Header {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
}

.ssStep3Row { display: flex; flex-direction: column; gap: 2px; }

.ssStep3Label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-faint);
}

.ssStep3Value {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-strong);
}

/* ===== Horarios ===== */
.ssSlots { margin-top: var(--sp-2); }
.ssDayBlock { margin-bottom: var(--sp-4); }

.ssDayTitle {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-faint);
    margin: var(--sp-4) 0 var(--sp-2);
}

.ssSlotBtn {
    width: 100%;
    text-align: left;
    border: 1px solid var(--rule);
    background: var(--paper);
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-2);
    cursor: pointer;
    transition: background 150ms, border-color 150ms;
}

.ssSlotBtn:hover { background: var(--action-soft); }

.ssSlotBtn.isSelected {
    border-color: var(--action);
    background: var(--action-soft);
}

.ssSlotBtn.isDisabled { opacity: .55; cursor: not-allowed; }

.ssSlotTop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
}

.ssSlotName {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-strong);
    flex: 1;
    min-width: 0;
    /* Si el nombre no cabe, se recorta el nombre — nunca se rompe la fila */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Cupo disponible del horario.
   El tracking de los eyebrows (.12em) ensanchaba demasiado esta fila en movil y
   partia el renglon, asi que aqui va reducido. */
.ssSlotCap {
    flex: none;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    text-align: right;
    white-space: nowrap;
}

.ssSlotBtn.isSelected .ssSlotCap { color: var(--ink-soft); }

@media (max-width: 400px) {
    /* En pantallas angostas se recupera todo el ancho posible */
    .ssSlotTop { gap: var(--sp-2); }
    .ssSlotCap { letter-spacing: 0; }
    .ssSlotBtn { padding: var(--sp-3); }
}

/* Indicador de selección del horario */
.ssSlotCheck {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    position: relative;
    transition: background 150ms, border-color 150ms;
}

.ssSlotBtn.isSelected .ssSlotCheck {
    background: var(--action);
    border-color: var(--action);
}

/* Palomita dibujada en CSS (sin icon font, guía 7) */
.ssSlotBtn.isSelected .ssSlotCheck::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 3px;
    width: 5px;
    height: 9px;
    border: solid var(--paper);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}
[data-theme="dark"] .ssSlotBtn.isSelected .ssSlotCheck::after { border-color: var(--bg); }

/* ===== Cantidad ===== */
.ssQtyWrap {
    margin-top: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
}

.ssQtyTitle {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-strong);
    margin-bottom: var(--sp-1);
    text-align: center;
}

.ssQtySub {
    font-size: 13px;
    text-align: center;
    margin-bottom: var(--sp-4);
}

.ssQtyRow {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    gap: var(--sp-3);
    align-items: center;
    max-width: 280px;
    margin: 0 auto;
}

.ssQtyBtn {
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--ink-strong);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms, border-color 150ms;
}

.ssQtyBtn:hover:not(:disabled) { background: var(--action-soft); border-color: var(--action-line); }
.ssQtyBtn:disabled { opacity: .45; cursor: not-allowed; }

.ssQtyVal {
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    background: var(--paper-alt);
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    color: var(--ink-strong);
    text-align: center;
}

/* ===== Confirmación ===== */
.ssConfirmRow {
    margin-top: var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
}

.ssConfirmRow .btn-primary { width: 100%; }

.ssBackLink {
    color: var(--action) !important;
    text-decoration: underline !important;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
}

.ssBackLink:hover { color: var(--ink-strong) !important; }

.ssAlert { margin-top: var(--sp-3); }
.ssSmall { font-size: 13px; margin-top: var(--sp-2); }

/* ===== Tiempo para confirmar ===== */
.ssHoldProgress { margin: var(--sp-4) 0; }

.ssHoldProgressLabel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--sp-2);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-faint);
}

.ssHoldTime {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    text-transform: none;
    color: var(--action);
}

.ssHoldProgressBar {
    width: 100%;
    height: 8px;
    background: var(--neu-bg);
    border-radius: 50%;
    overflow: hidden;
    position: relative;
}

/* Relleno plano — sin gradientes decorativos ni glow (guía 5) */
.ssHoldProgressFill {
    height: 100%;
    background: var(--action);
    border-radius: 50%;
    transition: width 500ms linear;
}

/* ===== Reserva activa ===== */
.ssCardTitle {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-strong);
    margin-bottom: var(--sp-4);
}

.ssInfoGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
}

.ssQrWrap {
    margin-top: var(--sp-4);
    display: grid;
    place-items: center;
    gap: var(--sp-2);
    padding: var(--sp-6) var(--sp-5);
    background: var(--vr-navy);
    border-radius: var(--radius);
}

.ssQrInfoText {
    font-size: 13px;
    text-align: left;
    margin-top: var(--sp-3);
    margin-bottom: var(--sp-1);
    line-height: 1.5;
}

.ssQrImg {
    width: 240px;
    height: 240px;
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    border-radius: var(--radius-sm);
    object-fit: cover;
}

.ssQrWrap .ssQrImgClip {
    width: 220px;
    height: 220px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
}

.ssCode {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    word-break: break-all;
    text-align: center;
    padding: 0 var(--sp-2);
}

.ssDownloadWrap {
    margin-top: var(--sp-4);
    display: grid;
    place-items: center;
}

.ssActions {
    margin-top: var(--sp-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
}

@media (min-width: 576px) {
    .ssConfirmRow .btn-primary { max-width: 400px; }
    .ssActions { grid-template-columns: 1fr 1fr; }
    .ssInfoGrid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

@media (max-width: 576px) {
    .vrContainer { padding: var(--sp-3) var(--sp-2) var(--sp-4-5); }
    .ssCard { margin-top: var(--sp-2); }
    .ssCard .card-body { padding: var(--sp-4); }
    .ssInfoGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 768px) {
    .ssInfoGrid--active {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        column-gap: var(--sp-3);
        row-gap: var(--sp-3);
    }
    .ssInfoGrid--active > div { min-width: 0; }
}

/* ===== Modales (shadow-pop + borde rule, guía 4) ===== */
.ssModalOverlay {
    position: fixed;
    inset: 0;
    background: rgba(15,51,75,.45);
    display: grid;
    place-items: center;
    z-index: 9999;
    padding: var(--sp-4);
}

[data-theme="dark"] .ssModalOverlay { background: rgba(0,0,0,.6); }

.ssModalCard {
    width: 100%;
    max-width: 420px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--sp-5);
    box-shadow: var(--shadow-pop);
    font-family: var(--font-body);
    color: var(--ink);
}

.ssModalTitle {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-strong);
    margin-bottom: var(--sp-2);
}

.ssModalText {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.45;
}

.ssModalSummary {
    margin-top: var(--sp-3);
    background: var(--paper-alt);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
}

.ssModalRow {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-1) 0;
}

.ssModalLabel {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-faint);
}

.ssModalVal {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-strong);
    text-align: right;
}

.ssSaveImgWrap {
    display: flex;
    justify-content: center;
    margin: var(--sp-4) 0 var(--sp-1);
}

.ssSaveImg {
    max-width: 100%;
    width: 260px;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    /* Permite el menú contextual de iOS para "Guardar en Fotos" */
    -webkit-touch-callout: default;
    -webkit-user-select: auto;
    user-select: auto;
}

.ssModalActions {
    margin-top: var(--sp-4);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
}

/* ===== Toast (semáforo, guía 2) ===== */
.ssToast {
    position: fixed;
    left: 50%;
    bottom: var(--sp-4);
    transform: translateX(-50%);
    z-index: 10000;
    width: calc(100% - 24px);
    max-width: 420px;
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    box-shadow: var(--shadow-pop);
    border: 1px solid var(--rule);
    background: var(--paper);
    font-family: var(--font-body);
}

.ssToast.success { border-left: 3px solid var(--ok-fill); }
.ssToast.danger  { border-left: 3px solid var(--err-fill); }
.ssToast.info    { border-left: 3px solid var(--vr-steel); }

.ssToastText {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-strong);
}

/* ===== Botones (guía 2: primario navy; rojo solo como danger) ===== */
.vrPage .btn,
.vrPage .rock-button {
    font-family: var(--font-body);
    font-size: 14px;
    border-radius: var(--radius-sm);
    padding: 10px var(--sp-4);
    transition: background-color 150ms, border-color 150ms, color 150ms;
}

.vrPage .btn-primary,
.vrPage .rock-button.btn-primary {
    background-color: var(--btn-primary) !important;
    border-color: var(--btn-primary) !important;
    color: var(--btn-primary-ink) !important;
    font-weight: 600;
}

.vrPage .btn-primary:hover,
.vrPage .rock-button.btn-primary:hover {
    background-color: var(--btn-primary-hover) !important;
