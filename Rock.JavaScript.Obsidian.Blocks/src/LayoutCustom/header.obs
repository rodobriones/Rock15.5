</template>

<script setup lang="ts">
import { nextTick, onMounted, ref } from "vue";
import { injectWebflowBase } from "./_webflowBase";

// El CSS base de Webflow se inyecta antes del primer paint (afecta reglas
// globales como body/html que el contenido principal de la página espera,
// para evitar un FOUC). injectWebflowBase es idempotente: solo aplica una vez
// aunque header.obs y footer.obs lo llamen.
injectWebflowBase();

// El render del template del header sí se difiere hasta después del primer
// paint para que el contenido de la página aparezca primero.
const ready = ref(false);

const ensureGoogleFonts = (): void => {
    if (document.head.querySelector('link[data-header-obs="google-fonts"]')) {
        return;
    }

    const preconnectGoogle = document.createElement("link");
    preconnectGoogle.setAttribute("data-header-obs", "google-preconnect");
    preconnectGoogle.rel = "preconnect";
    preconnectGoogle.href = "https://fonts.googleapis.com";
    document.head.appendChild(preconnectGoogle);

    const preconnectGstatic = document.createElement("link");
    preconnectGstatic.setAttribute("data-header-obs", "gstatic-preconnect");
    preconnectGstatic.rel = "preconnect";
    preconnectGstatic.href = "https://fonts.gstatic.com";
    preconnectGstatic.crossOrigin = "anonymous";
    document.head.appendChild(preconnectGstatic);

    const fonts = document.createElement("link");
    fonts.setAttribute("data-header-obs", "google-fonts");
    fonts.rel = "stylesheet";
    fonts.href = "https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800;900&family=Lato:wght@100;300;400;700;900&family=Vollkorn:wght@400;700&family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;600;700&display=swap";
    document.head.appendChild(fonts);
};

const bindHeaderInteractions = (root: HTMLElement): void => {
    const sideNav = root.querySelector(".ths02-side-navigation-2") as HTMLElement | null;
    const menuOpenBtn = root.querySelector('[data-w-id="1e40c1e0-d28b-cb30-faa1-b4e963de0ff3"]') as HTMLElement | null;
    const menuCloseBtn = root.querySelector('[data-w-id="1e40c1e0-d28b-cb30-faa1-b4e963de0ffa"]') as HTMLElement | null;

    const searchPanel = root.querySelector(".search-5") as HTMLElement | null;
    const searchOpenBtn = root.querySelector('[data-w-id="1e40c1e0-d28b-cb30-faa1-b4e963de0ff0"]') as HTMLElement | null;
    const searchCloseBtn = root.querySelector('[data-w-id="1e40c1e0-d28b-cb30-faa1-b4e963de102d"]') as HTMLElement | null;

    const setMenuOpen = (isOpen: boolean): void => {
        if (!sideNav) {
            return;
        }

        sideNav.style.transition = "inset 260ms ease";
        sideNav.style.inset = isOpen ? "0% 0% 0% 0%" : "0% 0% 0% 100%";
    };

    const setSearchOpen = (isOpen: boolean): void => {
        if (!searchPanel) {
            return;
        }

        searchPanel.style.transition = "height 220ms ease";
        searchPanel.style.overflow = "hidden";
        searchPanel.style.height = isOpen ? "320px" : "0px";
    };

    setMenuOpen(false);
    setSearchOpen(false);

    menuOpenBtn?.addEventListener("click", (ev) => {
        ev.preventDefault();
        setMenuOpen(true);
    });

    menuCloseBtn?.addEventListener("click", (ev) => {
        ev.preventDefault();
        setMenuOpen(false);
    });

    searchOpenBtn?.addEventListener("click", (ev) => {
        ev.preventDefault();
        setSearchOpen(true);
    });

    searchCloseBtn?.addEventListener("click", (ev) => {
        ev.preventDefault();
        setSearchOpen(false);
    });

    document.addEventListener("keydown", (ev: KeyboardEvent) => {
        if (ev.key === "Escape") {
            setMenuOpen(false);
            setSearchOpen(false);
        }
    });
};

onMounted(() => {
    const ric = (window as unknown as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback
        || ((cb: () => void) => setTimeout(cb, 0));

    ric(() => {
        ready.value = true;

        // Esperar a que Vue renderice el root real antes de bindings/fonts.
        nextTick(() => {
            const root = document.querySelector(".obs-header-root") as HTMLElement | null;
            if (!root || root.dataset.obsHeaderInit === "1") {
                return;
            }
            root.dataset.obsHeaderInit = "1";
            ensureGoogleFonts();
            bindHeaderInteractions(root);
        });
    });
});
</script>

<style scoped>
/* Reserva un espacio mínimo mientras el header monta. La altura real es
   responsive; este min-height solo evita un colapso total y reduce el
   layout shift al aparecer. Ajustar si se nota un salto grande. */
.obs-header-placeholder {
    min-height: 60px;
}

.obs-header-root {
    width: 100%;
    position: relative;
}

.obs-header-root .menupruebaheader-3 {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    inset: auto;
}
</style>
