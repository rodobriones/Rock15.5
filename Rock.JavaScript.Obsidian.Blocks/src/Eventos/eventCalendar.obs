<!-- Calendario público de eventos: lista agrupada por mes, tarjetas con enlace al checkout.
     Solo lectura: todo viene en el init bag (los eventos privados/con contraseña ya vienen
     filtrados por EventAccessService en el servidor). -->
<template>
    <Panel type="block" title="Eventos • Calendario">
        <template #default>
            <div class="evcWrap">
                <header class="evcHead">
                    <h1 class="evcTitle">Calendario de Eventos</h1>
                    <p class="evcSub">Próximos eventos con venta de entradas.</p>
                </header>

                <div v-if="!months.length" class="evcEmpty">
                    <div class="evcEmptyIcon">📅</div>
                    <h3>No hay eventos próximos</h3>
                    <p>Cuando se publique un evento con venta de entradas, aparecerá aquí.</p>
                </div>

                <section v-for="m in months" :key="m.key" class="evcMonth">
                    <h2 class="evcMonthName">{{ m.label }}</h2>
                    <div class="evcGrid">
                        <a v-for="e in m.events" :key="e.eventId" class="evcCard" :href="eventUrl(e)">
                            <div class="evcHero" :class="{ 'evcHero--noimg': !e.imageUrl }"
                                 :style="e.imageUrl ? { backgroundImage: `url('${e.imageUrl}')` } : {}">
                                <div class="evcHeroShade"></div>
                                <span v-if="e.category" class="evcBadge" :class="'evcBadge--' + e.category.toLowerCase()">{{ e.category }}</span>
                                <div class="evcHeroInner">
                                    <span class="evcDate evcCap">{{ fmtDate(e.startDateTime) }}</span>
                                    <h3 class="evcName">{{ e.name }}</h3>
                                    <span v-if="e.venueName || e.campusName" class="evcVenue">{{ [e.venueName, e.campusName].filter(Boolean).join(" · ") }}</span>
                                </div>
                            </div>
                            <div class="evcBody">
                                <ul v-if="e.sessions?.length" class="evcSessions">
                                    <li v-for="s in e.sessions.slice(0, 3)" :key="s">{{ s }}</li>
                                    <li v-if="e.sessions.length > 3" class="evcSessionsMore">+{{ e.sessions.length - 3 }} sesiones más</li>
                                </ul>
                                <p v-if="e.description" class="evcDesc">{{ e.description }}</p>
                                <span class="evcCta">Ver entradas →</span>
                            </div>
                        </a>
                    </div>
                </section>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import { useConfigurationValues } from "@Obsidian/Utility/block";

type CalendarEventBag = {
    eventId: number;
    slug: string | null;
    name: string;
    description: string | null;
    category: string | null;
    venueName: string | null;
    campusName: string | null;
    startDateTime: string;
    endDateTime: string;
    sessions: string[] | null;
    imageUrl: string | null;
};
type InitBag = {
    events: CalendarEventBag[];
    checkoutUrlTemplate: string;
    checkoutSlugUrlTemplate: string;
};
type MonthGroup = { key: string; label: string; events: CalendarEventBag[] };

const config = useConfigurationValues<InitBag>();

// Agrupa por mes conservando el orden (ya viene por fecha asc del servidor).
const months = computed<MonthGroup[]>(() => {
    const groups = new Map<string, MonthGroup>();
    for (const e of config.events || []) {
        const d = new Date(e.startDateTime);
        if (Number.isNaN(d.getTime())) continue;
        const key = `${d.getFullYear()}-${d.getMonth()}`;
        let g = groups.get(key);
        if (!g) {
            const label = d.toLocaleDateString("es-GT", { month: "long", year: "numeric" });
            g = { key, label: label.charAt(0).toUpperCase() + label.slice(1), events: [] };
            groups.set(key, g);
        }
        g.events.push(e);
    }
    return Array.from(groups.values());
});

function fmtDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleDateString("es-GT", { weekday: "long", day: "numeric", month: "long" })
        + " · "
        + d.toLocaleTimeString("es-GT", { hour: "numeric", minute: "2-digit" });
}

// URL al checkout: por slug si el evento tiene (URL bonita), si no por EventId.
function eventUrl(e: CalendarEventBag): string {
    if (e.slug && config.checkoutSlugUrlTemplate) {
        return config.checkoutSlugUrlTemplate.replace("((Slug))", encodeURIComponent(e.slug));
    }
    return (config.checkoutUrlTemplate || "").replace("((Key))", String(e.eventId));
}
</script>

<style>
/* ============================================================
   Calendario de Eventos — paleta slate / Roboto del checkout.
   NO-scoped: oculta el chrome del panel vía ancestro (:has).
   ============================================================ */

.panel-block:has(.evcWrap) > .panel-heading,
.panel-block:has(.evcWrap) > .panel-header { display: none !important; }
.panel-block:has(.evcWrap) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}
.panel-block:has(.evcWrap) > .panel-body { padding: 0 !important; }

.evcWrap {
    font-family: Roboto, "Segoe UI", Helvetica, Arial, sans-serif;
    color: #1e293b;
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 16px 60px;
}
.evcCap::first-letter { text-transform: uppercase; }

.evcHead { margin-bottom: 24px; }
.evcTitle { margin: 0; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; color: #0f172a; }
.evcSub { margin: 4px 0 0; color: #64748b; font-size: 15px; }

.evcEmpty {
    text-align: center; padding: 60px 20px; background: #f8fafc;
    border: 1px dashed #cbd5e1; border-radius: 18px; color: #64748b;
}
.evcEmptyIcon { font-size: 40px; margin-bottom: 8px; }
.evcEmpty h3 { margin: 0 0 4px; color: #334155; }
.evcEmpty p { margin: 0; font-size: 14px; }

.evcMonth { margin-bottom: 34px; }
.evcMonthName {
    font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #94a3b8; margin: 0 0 14px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0;
}

.evcGrid {
    display: grid; gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
}

.evcCard {
    display: flex; flex-direction: column;
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 18px;
    overflow: hidden; text-decoration: none !important; color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
}
.evcCard:hover { box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12); transform: translateY(-2px); }

.evcHero {
    position: relative; height: 160px;
    background-size: cover; background-position: center;
}
.evcHero--noimg { background: linear-gradient(160deg, #334155 0%, #0f172a 100%); }
.evcHeroShade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15,23,42,0.08) 0%, rgba(15,23,42,0.45) 55%, rgba(15,23,42,0.85) 100%);
}
.evcBadge {
    position: absolute; top: 12px; left: 12px;
    color: #fff; font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; padding: 5px 11px; border-radius: 999px;
    background: #475569;
}
.evcBadge--conferencia { background: oklch(58% 0.10 255); }
.evcBadge--concierto   { background: oklch(58% 0.13 350); }
.evcBadge--deportivo   { background: oklch(58% 0.11 155); }
.evcBadge--familiar    { background: oklch(62% 0.12 60); }

.evcHeroInner { position: absolute; left: 14px; right: 14px; bottom: 12px; color: #fff; }
.evcDate { display: block; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.92); }
.evcName { margin: 2px 0 0; font-size: 19px; font-weight: 800; line-height: 1.15; color: #fff; }
.evcVenue { display: block; font-size: 12px; color: rgba(255,255,255,0.78); margin-top: 2px; }

.evcBody { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px 16px; flex: 1; }
.evcSessions { list-style: none; margin: 0; padding: 0; font-size: 12.5px; color: #475569; }
.evcSessions li::before { content: "•"; margin-right: 6px; color: #94a3b8; }
.evcSessions .evcSessionsMore { color: #94a3b8; }
.evcDesc {
    margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.evcCta { margin-top: auto; font-size: 13.5px; font-weight: 700; color: #0f172a; }
.evcCard:hover .evcCta { text-decoration: underline; }
</style>
