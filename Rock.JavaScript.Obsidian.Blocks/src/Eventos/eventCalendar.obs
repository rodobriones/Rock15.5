<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<!-- Calendario público de eventos: hero con buscador y panel de filtros plegable (fecha, tipo,
     ministerio) + listado de todos los meses con eventos. Solo lectura: todo viene en el init bag
     (los eventos privados/con contraseña ya vienen filtrados por EventAccessService en el
     servidor) y el filtrado es client-side sobre esa lista.
     Rediseño 2026 (Claude Design · artboard "01.Eventos - eventCalendar").
     El <style> es NO-scoped a propósito: targetea .panel-block, que Rock pone fuera del template. -->
<template>
    <Panel type="block" title="" class="evc-panel">
        <template #default>
            <div class="evcWrap">
                <div class="evcPage">

                    <!-- Hero: título, buscador y acceso a los filtros -->
                    <header class="evcHero">
                        <div class="evcHeroInner">
                            <h1 class="evcTitle">Calendario de Eventos</h1>
                        </div>

                        <div class="evcHeroInner evcFilterBar">
                            <div class="evcSearchRow evcSearchRow--hero">
                                <input v-model="searchText"
                                       type="text"
                                       class="evcSearchInput"
                                       placeholder="Buscar evento…"
                                       aria-label="Buscar evento"
                                       @keyup.enter="applySearch" />
                                <button type="button" class="evcSearchBtn" @click="applySearch">Buscar</button>
                            </div>
                            <button type="button"
                                    class="evcFilterToggle"
                                    :aria-expanded="filtersOpen"
                                    @click="filtersOpen = !filtersOpen">
                                Más filtros <span class="evcFilterChevron">{{ filtersOpen ? "▲" : "▼" }}</span>
                            </button>
                        </div>

                        <div v-if="filtersOpen" class="evcHeroInner">
                            <div class="evcFilterDropdown">
                                <div class="evcFilterSection">
                                    <h3 class="evcFilterTitle">Fecha</h3>
                                    <div class="evcDateField">
                                        <label for="evcDateStart">Desde</label>
                                        <input id="evcDateStart" v-model="dateStart" type="date" />
                                    </div>
                                    <div class="evcDateField">
                                        <label for="evcDateEnd">Hasta</label>
                                        <input id="evcDateEnd" v-model="dateEnd" type="date" />
                                    </div>
                                </div>

                                <div v-if="typeOptions.length" class="evcFilterSection">
                                    <h3 class="evcFilterTitle">Tipo</h3>
                                    <div class="evcCheckList">
                                        <label v-for="t in typeOptions" :key="t" class="evcCheckRow">
                                            <input v-model="activeTypes" type="checkbox" :value="t" /> {{ t }}
                                        </label>
                                    </div>
                                </div>

                                <!-- Las opciones salen de los eventos publicados: si ninguno tiene
                                     ministerio asignado, la sección no se dibuja. -->
                                <div v-if="ministryOptions.length" class="evcFilterSection">
                                    <h3 class="evcFilterTitle">Ministerio</h3>
                                    <div class="evcCheckList">
                                        <label v-for="m in ministryOptions" :key="m" class="evcCheckRow">
                                            <input v-model="activeMinistries" type="checkbox" :value="m" /> {{ m }}
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </header>

                    <div class="evcContainer">

                        <!-- Sin eventos futuros publicados -->
                        <div v-if="!months.length" class="evcEmpty">
                            <div class="evcEmptyIcon">◌</div>
                            <h3>No hay eventos próximos</h3>
                            <p>Cuando se publique un evento con venta de entradas, aparecerá aquí.</p>
                        </div>

                        <div v-else class="evcLayout">
                            <div ref="resultsEl" class="evcContent">

                                <!-- Hay eventos, pero ninguno pasa los filtros -->
                                <div v-if="!resultGroups.length" class="evcEmpty evcEmpty--inline">
                                    <div class="evcEmptyIcon">◌</div>
                                    <h3>No hay eventos con esos filtros</h3>
                                    <p>Ajusta la búsqueda o quita algún filtro.</p>
                                </div>

                                <section v-for="g in resultGroups" :key="g.key" class="evcMonth">
                                    <h2 class="evcMonthName">
                                        <span class="evcCap">{{ g.label }}</span>
                                        <span class="evcMonthCount">
                                            {{ g.events.length }} {{ g.events.length === 1 ? "evento" : "eventos" }}
                                        </span>
                                    </h2>
                                    <div class="evcGrid">
                                        <a v-for="e in g.events" :key="e.eventId" class="evcCard" :href="eventUrl(e)">
                                            <div class="evcCardHero"
                                                 :class="{ 'evcCardHero--noimg': !e.imageUrl }"
                                                 :style="e.imageUrl ? { backgroundImage: `url('${e.imageUrl}')` } : {}">
                                                <div class="evcHeroShade"></div>
                                                <div v-if="e.category || e.ministry" class="evcTagRow">
                                                    <span v-if="e.category" class="evcBadge" :style="chipStyle(e.categoryColor)">{{ e.category }}</span>
                                                    <span v-if="e.ministry" class="evcBadge evcBadge--ministry" :style="chipStyle(e.ministryColor)">{{ e.ministry }}</span>
                                                </div>
                                                <div class="evcDay">
                                                    <span class="evcDayNum">{{ dayNum(e.startDateTime) }}</span>
                                                    <span class="evcDayMon">{{ monAbbr(e.startDateTime) }}</span>
                                                </div>
                                                <div class="evcCardHeroInner">
                                                    <h3 class="evcName">{{ e.name }}</h3>
                                                    <span v-if="venueLine(e)" class="evcVenue">{{ venueLine(e) }}</span>
                                                </div>
                                            </div>
                                            <div class="evcBody">
                                                <p v-if="e.description" class="evcDesc">{{ e.description }}</p>
                                                <span v-if="(e.sessions?.length ?? 0) > 1" class="evcSessionsLabel">
                                                    {{ e.sessions!.length }} horarios disponibles
                                                </span>
                                                <span class="evcCta">Ver entradas <span class="evcCtaArrow">→</span></span>
                                            </div>
                                        </a>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<style>
/* ============================================================
   Vida Real — Eventos • Calendario
   Rediseño 2026 (Claude Design · artboard "01.Eventos - eventCalendar").
   NO-scoped: oculta el chrome del panel vía ancestro (:has).
   ============================================================ */

.panel-block:has(.evcWrap) > .panel-heading,
.panel-block:has(.evcWrap) > .panel-header { display: none !important; }
.panel-block:has(.evcWrap) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}
.panel-block:has(.evcWrap) > .panel-body { padding: 0 !important; }

@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Regular.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Medium.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Medium.ttf") format("truetype");
    font-weight: 500; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.ttf") format("truetype");
    font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Bold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Bold.ttf") format("truetype");
    font-weight: 700; font-style: normal; font-display: swap;
}

.evcWrap {
    /* Tokens Brújula VR */
    --vr-navy: #0E364C;
    --vr-navy-800: #21465A;
    --vr-navy-600: #3E5E70;
    --bg: #F3F5F7;
    --paper: #FFFFFF;
    --paper-alt: #F8FAFB;
    --ink-soft: #5B7685;
    --ink-faint: #8297A2;
    --rule: #E0E5E8;
    --rule-strong: #CAD3D8;
    --action: #1E5B87;
    --action-soft: #EAF1F6;
    --action-line: #CFE0EC;
    --ok-fill: #39B396;
    --warn-fill: #F09E30;
    --font-body: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;
    --font-num: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;

    /* Alias de la paleta anterior, remapeados a los tokens */
    --bg-main: var(--bg);
    --surface-card: var(--paper);
    --surface-mid: var(--paper-alt);
    --surface-alt: var(--action-soft);
    --primary-900: var(--vr-navy);
    --primary-800: var(--vr-navy-800);
    --primary-700: var(--vr-navy-600);
    --primary-500: var(--ink-soft);
    --primary-300: var(--ink-faint);
    --primary-200: var(--rule-strong);

    font-family: var(--font-body);
    color: var(--primary-800);
    -webkit-font-smoothing: antialiased;
}
.evcWrap *,
.evcWrap *::before,
.evcWrap *::after { box-sizing: border-box; }
.evcCap::first-letter { text-transform: uppercase; }

/* ---------- Página full-bleed dentro del ancho de Rock ---------- */
.evcPage {
    background: var(--bg-main);
    margin: 0 -15px;
    padding-bottom: 64px;
    min-height: 70vh;
}

/* ---------- Hero ---------- */
.evcHero {
    background: linear-gradient(160deg, var(--primary-800) 0%, #0F334B 100%);
    padding: clamp(36px, 6vh, 64px) 0 30px;
}
.evcHeroInner {
    max-width: 1160px; margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 24px);
}
.evcTitle {
    margin: 0;
    font-size: 65px;
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.05;
    color: #fff;
}

.evcContainer {
    max-width: 1160px; margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 24px);
}

/* ---------- Barra de búsqueda y filtros ---------- */
.evcFilterBar {
    display: flex; flex-direction: row; align-items: center; flex-wrap: wrap;
    gap: 12px; margin-top: 40px;
}
.evcSearchRow { display: flex; gap: 8px; }
.evcSearchRow--hero { flex: 1; min-width: 220px; }
.evcSearchInput {
    flex: 1; min-width: 0; padding: 9px 12px;
    border: 1px solid rgba(255,255,255,0.4); border-radius: 8px;
    background: #fff; font-size: 13.5px; font-family: inherit;
    color: var(--primary-800); outline: none;
}
.evcSearchInput:focus { border-color: var(--primary-500); }
.evcSearchBtn {
    flex: none; border: 1px solid var(--action); background: var(--action); color: #fff;
    border-radius: 20px; padding: 0 14px; font-size: 13px; font-weight: 600;
    font-family: inherit; cursor: pointer;
}
.evcSearchBtn:hover { background: var(--primary-800); border-color: var(--primary-800); }

.evcFilterToggle {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    align-self: center; width: auto; flex: none;
    background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.4);
    color: #fff; border-radius: 20px; padding: 9px 16px;
    font-size: 13.5px; font-weight: 600; font-family: inherit; cursor: pointer;
}
.evcFilterToggle:hover { background: rgba(255,255,255,0.2); }
.evcFilterChevron { display: inline-block; font-size: 11px; transition: transform .15s ease; }

.evcFilterDropdown {
    margin-top: 14px; background: var(--surface-card); border-radius: 16px;
    box-shadow: 0 12px 34px rgba(15,51,75,0.18); padding: 20px;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
}
.evcFilterSection { display: flex; flex-direction: column; gap: 10px; }
.evcFilterTitle {
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--primary-300); margin: 0;
}
.evcDateField { display: flex; flex-direction: column; gap: 4px; }
.evcDateField label { font-size: 12px; color: var(--primary-500); }
.evcDateField input {
    width: 100%; padding: 8px 10px; border: 1px solid var(--primary-200);
    border-radius: 8px; font-size: 13px; font-family: inherit;
    color: var(--primary-800); outline: none;
}
.evcDateField input:focus { border-color: var(--primary-500); }
.evcCheckList { display: flex; flex-direction: column; gap: 8px; }
.evcCheckRow {
    display: flex; align-items: center; gap: 9px; font-size: 13.5px;
    font-weight: 400; color: var(--primary-800); cursor: pointer; margin: 0;
}
.evcCheckRow input { accent-color: var(--primary-900); width: 15px; height: 15px; flex: none; margin: 0; }

/* ---------- Resultados por mes ---------- */
.evcLayout { display: flex; gap: 32px; align-items: flex-start; }
.evcContent { flex: 1; min-width: 0; padding-top: 20px; }

.evcMonth { margin: 20px 0; }
.evcMonth + .evcMonth { padding-top: 32px; border-top: 1px solid #E1E7EC; }
.evcMonthName {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    margin: 22px 0 22px; padding: 20px 0 12px;
}
.evcMonthName .evcCap {
    font-size: 25px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--action);
}
.evcMonthCount {
    font-family: var(--font-num); font-size: 17px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: none; color: var(--primary-800);
    padding: 10px 25px; border-radius: 999px;
    border: 1px solid var(--rule-strong); background: var(--action-line);
    white-space: nowrap;
}

.evcGrid {
    display: grid; gap: 28px; padding-bottom: 30px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
}

/* ---------- Tarjeta de evento ---------- */
.evcCard {
    display: flex; flex-direction: column;
    background: var(--surface-card); border: 1px solid #E1E7EC; border-radius: 18px;
    overflow: hidden; text-decoration: none !important; color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
}
.evcCard:hover { box-shadow: 0 10px 30px rgba(15, 51, 75, 0.12); transform: translateY(-2px); }

.evcCardHero {
    position: relative; height: 176px;
    background-size: cover; background-position: center;
}
.evcCardHero--noimg { background: linear-gradient(160deg, var(--primary-800) 0%, #0F334B 100%); }
.evcHeroShade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15,51,75,0.08) 0%, rgba(15,51,75,0.45) 55%, rgba(15,51,75,0.85) 100%);
}
/* Chips de tipo y ministerio sobre la portada. El color lo manda el catálogo (DefinedTypes,
   migración 024) vía :style; aquí solo el estilo por defecto cuando no hay color. */
.evcTagRow {
    position: absolute; top: 12px; left: 12px; right: 66px;
    display: flex; flex-wrap: wrap; gap: 6px;
}
.evcBadge {
    color: #fff; font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; padding: 5px 11px; border-radius: 999px;
    background: var(--primary-700); border: 1px solid transparent;
}
/* Sin color propio, el ministerio va de contorno para no competir con el chip de tipo. */
.evcBadge--ministry {
    background: rgba(15,51,75,0.45);
    border-color: rgba(255,255,255,0.6);
}

/* Cubo de fecha (día grande + mes) arriba a la derecha del hero */
.evcDay {
    position: absolute; top: 12px; right: 12px;
    width: 46px; padding: 6px 0 5px;
    background: rgba(255,255,255,0.95); border-radius: 10px;
    display: flex; flex-direction: column; align-items: center; line-height: 1.1;
    box-shadow: 0 2px 8px rgba(15,51,75,0.18);
}
.evcDayNum { font-family: var(--font-num); font-size: 20px; font-weight: 700; color: var(--primary-900); }
.evcDayMon { font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary-500); }

.evcCardHeroInner { position: absolute; left: 16px; right: 16px; bottom: 14px; color: #fff; }
.evcName { margin: 0; font-size: 19px; font-weight: 800; line-height: 1.2; color: #fff; }
.evcVenue { display: block; font-size: 12.5px; color: rgba(255,255,255,0.85); margin-top: 4px; }

.evcBody { display: flex; flex-direction: column; gap: 10px; padding: 18px 20px 20px; flex: 1; }
.evcSessionsLabel { font-size: 12px; font-weight: 600; color: var(--action); }
.evcDesc {
    margin: 0; font-size: 13px; color: var(--primary-500); line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.evcCta { margin-top: auto; padding-top: 4px; font-size: 13.5px; font-weight: 700; color: var(--primary-900); }
.evcCtaArrow { display: inline-block; transition: transform .15s ease; }
.evcCard:hover .evcCta { text-decoration: underline; }
.evcCard:hover .evcCtaArrow { transform: translateX(3px); }

/* ---------- Vacío ---------- */
.evcEmpty {
    position: relative; margin-top: -36px;
    text-align: center; padding: 60px 20px;
    background: var(--surface-card); border-radius: 18px;
    box-shadow: 0 10px 30px rgba(15,51,75,0.06);
    color: var(--primary-500);
}
.evcEmpty--inline { margin-top: 0; }
.evcEmptyIcon { font-size: 40px; margin-bottom: 8px; color: var(--primary-300); }
.evcEmpty h3 { margin: 0 0 4px; color: var(--primary-800); }
.evcEmpty p { margin: 0; font-size: 14px; }

/* ---------- Responsive ---------- */
@media (max-width: 720px) {
    /* Mismo criterio que el checkout: el hero y el fondo llegan al borde de la pantalla
       (el margin: 0 dejaba el marco gris del padding del tema). Las tarjetas conservan el
       padding de .evcContainer para no pegarse al borde. */
    .evcPage { width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
    .evcGrid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
    .evcFilterDropdown { grid-template-columns: repeat(2, 1fr); }
    .evcSearchRow--hero { min-width: 0; }
    .evcSearchRow--hero .evcSearchInput { min-width: 60px; }
}
@media (max-width: 420px) {
    .evcTitle { font-size: 41px; }
    .evcHero { padding: 28px 0 30px; }
    .evcFilterBar { flex-direction: column; align-items: stretch; }
    .evcFilterToggle { width: 100%; align-self: stretch; }
    .evcFilterDropdown { grid-template-columns: 1fr; padding: 16px; gap: 18px; }
    .evcMonthName { flex-wrap: wrap; row-gap: 8px; margin-bottom: 16px; }
    .evcMonthName .evcCap { font-size: 18px; }
    .evcMonthCount { font-size: 12px; padding: 6px 12px; }
    .evcCardHero { height: 150px; }
    .evcName { font-size: 17px; }
    .evcBody { padding: 14px 16px 16px; }
}
@media (prefers-reduced-motion: reduce) {
    .evcCard, .evcCtaArrow { transition: none; }
}
</style>

<script setup lang="ts">
import { computed, ref } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import { useConfigurationValues } from "@Obsidian/Utility/block";

type CalendarEventBag = {
    eventId: number;
    slug: string | null;
    name: string;
    description: string | null;
    category: string | null;
    /** Color del chip de tipo (DefinedType "Tipos de Evento", migración 024); null = azul institucional. */
    categoryColor?: string | null;
    /** Área de la iglesia que organiza (Event.Ministry, migración 022). */
    ministry?: string | null;
    /** Color del chip de ministerio; null = chip de contorno. */
    ministryColor?: string | null;
    venueName: string | null;
    campusName: string | null;
    startDateTime: string;
    endDateTime: string;
    sessions: string[] | null;
    imageUrl: string | null;
};
type InitBag = {
    events: CalendarEventBag[];
    checkoutUrlTemplate: string;
    checkoutSlugUrlTemplate: string;
};
type MonthGroup = { key: string; label: string; events: CalendarEventBag[] };

const config = useConfigurationValues<InitBag>();

const searchText = ref("");
const filtersOpen = ref(false);
const dateStart = ref("");
const dateEnd = ref("");
const activeTypes = ref<string[]>([]);
const activeMinistries = ref<string[]>([]);
const resultsEl = ref<HTMLElement | null>(null);

const allEvents = computed<CalendarEventBag[]>(() => config.events || []);

// Opciones de filtro derivadas de lo que realmente hay publicado: sin catálogos fijos que
// puedan ofrecer un filtro que no devuelve nada.
const typeOptions = computed<string[]>(() => distinct(allEvents.value.map(e => e.category)));
const ministryOptions = computed<string[]>(() => distinct(allEvents.value.map(e => e.ministry ?? null)));

function distinct(values: (string | null | undefined)[]): string[] {
    const seen = new Set<string>();
    for (const v of values) {
        const t = (v ?? "").trim();
        if (t) seen.add(t);
    }
    return Array.from(seen).sort((a, b) => a.localeCompare(b, "es"));
}

// Agrupa por mes conservando el orden (ya viene por fecha asc del servidor).
const months = computed<MonthGroup[]>(() => groupByMonth(allEvents.value));

const filteredEvents = computed<CalendarEventBag[]>(() => {
    const q = searchText.value.trim().toLowerCase();
    const types = activeTypes.value;
    const ministries = activeMinistries.value;

    return allEvents.value.filter(e => {
        if (q) {
            const hay = [e.name, e.venueName, e.campusName, e.description].filter(Boolean).join(" ").toLowerCase();
            if (!hay.includes(q)) return false;
        }
        // Las fechas del filtro son locales (YYYY-MM-DD): se comparan contra el día del evento.
        const day = dayKey(e.startDateTime);
        if (dateStart.value && day < dateStart.value) return false;
        if (dateEnd.value && day > dateEnd.value) return false;
        if (types.length && !types.includes((e.category ?? "").trim())) return false;
        if (ministries.length && !ministries.includes((e.ministry ?? "").trim())) return false;
        return true;
    });
});

const resultGroups = computed<MonthGroup[]>(() => groupByMonth(filteredEvents.value));

function groupByMonth(events: CalendarEventBag[]): MonthGroup[] {
    const groups = new Map<string, MonthGroup>();
    for (const e of events) {
        const d = new Date(e.startDateTime);
        if (Number.isNaN(d.getTime())) continue;
        const key = `${d.getFullYear()}-${d.getMonth()}`;
        let g = groups.get(key);
        if (!g) {
            g = { key, label: d.toLocaleDateString("es-GT", { month: "long", year: "numeric" }), events: [] };
            groups.set(key, g);
        }
        g.events.push(e);
    }
    return Array.from(groups.values());
}

// El botón "Buscar" filtra en vivo igual que al escribir; su trabajo real es cerrar el teclado
// en móvil y llevar la vista a los resultados.
function applySearch(): void {
    (document.activeElement as HTMLElement | null)?.blur();
    resultsEl.value?.scrollIntoView({ behavior: "smooth", block: "start" });
}

// El color de los chips es dato del catálogo; sin color definido manda el CSS.
function chipStyle(color: string | null | undefined): Record<string, string> {
    const c = (color ?? "").trim();
    return c ? { background: c, borderColor: c } : {};
}

function dayKey(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return "";
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${d.getFullYear()}-${m}-${day}`;
}

function dayNum(iso: string): string {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? "" : String(d.getDate());
}

function monAbbr(iso: string): string {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString("es-GT", { month: "short" }).replace(".", "");
}

function venueLine(e: CalendarEventBag): string {
    return [e.venueName, e.campusName].filter(Boolean).join(" · ");
}

// URL al checkout: por slug si el evento tiene (URL bonita), si no por EventId.
function eventUrl(e: CalendarEventBag): string {
    if (e.slug && config.checkoutSlugUrlTemplate) {
        return config.checkoutSlugUrlTemplate.replace("((Slug))", encodeURIComponent(e.slug));
    }
    return (config.checkoutUrlTemplate || "").replace("((Key))", String(e.eventId));
}
</script>
