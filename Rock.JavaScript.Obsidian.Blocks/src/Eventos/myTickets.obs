<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<!-- Mis Entradas: portada, pestañas Próximos / Historial y una card por evento con sus boletos
     (QR, reenvío por correo y visor a pantalla completa con Apple/Google Wallet).
     Rediseño 2026 (Claude Design · artboard "05.Eventos - myTickets").
     Los estilos son NO-scoped a propósito: targetean .panel-block, el chrome que Rock pone
     fuera del template, y posicionan el visor de QR sobre todo el bloque. -->
<template>
    <Panel type="block" title="" class="mt-panel">
        <template #default>
            <div class="mtPage">
                <NotificationBox v-if="config.notLogged" alertType="warning" class="mtGlobalNote">
                    Debes iniciar sesión para ver tus entradas.
                </NotificationBox>

                <div v-else class="mtLogged">
                    <!-- Portada: degradado oscuro fijo (diseño 2026); la foto del evento va en cada card. -->
                    <div class="mtCover">
                        <div class="mtCoverInner">
                            <h1 class="mtCoverTitle">Mis eventos</h1>
                            <div class="mtCoverMeta">
                                <span>Revisa el historial de tus eventos</span>
                            </div>
                        </div>
                    </div>

                    <div class="mtWrap">
                        <NotificationBox v-if="err" alertType="danger" class="mb-3">{{ err }}</NotificationBox>
                        <NotificationBox v-if="notice" alertType="success" class="mb-3">{{ notice }}</NotificationBox>

                        <div v-if="tickets.length === 0" class="mtEmpty">
                            <div class="mtEmptyIcon">🎟️</div>
                            <h3>Aún no tienes entradas</h3>
                            <p>Cuando compres entradas — o alguien de tu familia te asigne una — aparecerán aquí.</p>
                        </div>

                        <template v-else>
                            <div class="mtTabsRow">
                                <div class="mtTabs">
                                    <button type="button"
                                            class="mtTab"
                                            :class="{ 'mtTab--active': activeTab === 'upcoming' }"
                                            @click="activeTab = 'upcoming'">
                                        Próximos eventos ({{ upcomingGroups.length }})
                                    </button>
                                    <button type="button"
                                            class="mtTab"
                                            :class="{ 'mtTab--active': activeTab === 'past' }"
                                            @click="activeTab = 'past'">
                                        Historial de anteriores ({{ pastGroups.length }})
                                    </button>
                                </div>
                            </div>

                            <!-- Próximos eventos -->
                            <section v-if="activeTab === 'upcoming'" class="mtSection">
                                <div v-if="!upcomingGroups.length" class="mtEmpty">
                                    <div class="mtEmptyIcon">🎟️</div>
                                    <h3>No tienes eventos próximos</h3>
                                    <p>Tus entradas de eventos que ya pasaron están en el historial.</p>
                                </div>

                                <div v-for="g in upcomingGroups" :key="g.eventId" class="mtEvent">
                                    <div class="mtEventHero mtEventHero--tappable"
                                         :class="{ 'mtEventHero--noimg': !g.imageUrl }"
                                         :style="g.imageUrl ? { backgroundImage: `url('${g.imageUrl}')` } : {}"
                                         role="button" tabindex="0" :aria-expanded="isExpanded(g)"
                                         @click="toggleEvent(g.eventId)"
                                         @keydown.enter="toggleEvent(g.eventId)">
                                        <div class="mtEventHeroShade"></div>
                                        <div class="mtEventHeroInner">
                                            <span class="mtPill mtPill--neu mtEventTag" :style="chipStyle(g.categoryColor)">{{ g.category || "Evento" }}</span>
                                            <h2 class="mtEventName">{{ g.name }}</h2>
                                        </div>
                                    </div>
                                    <div class="mtEventMeta">
                                        <div class="mtEventMetaRow">
                                            <div class="mtEventMetaText">
                                                <span v-if="g.startDateTime" class="mtEventMetaDate ecCap">{{ formatEventDate(g.startDateTime) }}</span>
                                                <span v-if="venueLine(g)" class="mtEventMetaVenue">{{ venueLine(g) }}</span>
                                            </div>
                                            <button type="button" class="mtEventCount" @click="toggleEvent(g.eventId)">
                                                {{ g.tickets.length }} {{ g.tickets.length === 1 ? "entrada" : "entradas" }}
                                                <span class="mtEventChevron">{{ isExpanded(g) ? "▲" : "▼" }}</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div v-show="isExpanded(g)" class="mtTickets">
                                        <div v-for="t in g.tickets" :key="t.ticketId" class="mtTicket mtTicket--tappable"
                                             role="button" tabindex="0"
                                             @click="showTicket(t, g)"
                                             @keydown.enter="showTicket(t, g)">
                                            <img v-if="t.qrImageUrl" :src="t.qrImageUrl" :alt="'QR ' + t.uniqueCode" class="mtQr" />
                                            <div class="mtTicketInfo">
                                                <div class="mtTicketTags">
                                                    <span v-if="t.isCurrentUser" class="mtPill mtPill--mine">Tu entrada</span>
                                                    <span class="mtPill" :class="t.status === 'CheckedIn' ? 'mtPill--used' : 'mtPill--valid'">
                                                        {{ t.status === "CheckedIn" ? "Utilizada" : "Válida" }}
                                                    </span>
                                                </div>
                                                <span class="mtTicketType">{{ t.ticketTypeName }}</span>
                                                <!-- Un boleto admite TODAS las sesiones del evento (no hay sesión por
                                                     ticket), así que el horario que se muestra es el del evento. -->
                                                <span v-if="g.startDateTime" class="mtTicketTime ecCap">{{ formatEventDate(g.startDateTime) }}</span>
                                                <span class="mtTicketAttendee">{{ t.attendeeName || "Sin nombre asignado" }}</span>
                                                <span class="mtTicketCode ecMono notranslate">{{ t.uniqueCode }}</span>
                                                <div class="mtTicketFoot">
                                                    <button type="button" class="mtResend" :disabled="resendingId === t.ticketId" @click.stop="resend(t.ticketId)" @keydown.enter.stop="resend(t.ticketId)">
                                                        {{ resendingId === t.ticketId ? "Enviando…" : "Reenviar por correo" }}
                                                    </button>
                                                    <span v-if="t.emailSentCount > 0" class="mtSent">Enviado {{ t.emailSentCount }}×</span>
                                                </div>
                                                <span class="mtShowHint">Toca para mostrar el QR en grande</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- Historial -->
                            <section v-if="activeTab === 'past'" class="mtSection">
                                <div v-if="!pastGroups.length" class="mtEmpty">
                                    <div class="mtEmptyIcon">🎟️</div>
                                    <h3>Todavía no hay historial</h3>
                                    <p>Los eventos a los que asististe aparecerán aquí cuando terminen.</p>
                                </div>

                                <div v-for="g in pastGroups" :key="g.eventId" class="mtEvent mtEvent--past">
                                    <div class="mtEventHero mtEventHero--noimg mtEventHero--tappable"
                                         role="button" tabindex="0" :aria-expanded="isExpanded(g)"
                                         @click="toggleEvent(g.eventId)"
                                         @keydown.enter="toggleEvent(g.eventId)">
                                        <div class="mtEventHeroInner">
                                            <span class="mtPill mtEventTag mtEventTag--past">Tus entradas</span>
                                            <h2 class="mtEventName">{{ g.name }}</h2>
                                        </div>
                                    </div>
                                    <div class="mtEventMeta">
                                        <div class="mtEventMetaRow">
                                            <div class="mtEventMetaText">
                                                <span v-if="g.startDateTime" class="mtEventMetaDate ecCap">{{ formatEventDate(g.startDateTime) }}</span>
                                                <span v-if="venueLine(g)" class="mtEventMetaVenue">{{ venueLine(g) }}</span>
                                            </div>
                                            <button type="button" class="mtEventCount" @click="toggleEvent(g.eventId)">
                                                {{ g.tickets.length }} {{ g.tickets.length === 1 ? "entrada" : "entradas" }}
                                                <span class="mtEventChevron">{{ isExpanded(g) ? "▲" : "▼" }}</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div v-show="isExpanded(g)" class="mtTickets">
                                        <div v-for="t in g.tickets" :key="t.ticketId" class="mtTicket">
                                            <div class="mtTicketInfo">
                                                <div class="mtTicketTags">
                                                    <span v-if="t.isCurrentUser" class="mtPill mtPill--mine">Tu entrada</span>
                                                    <span class="mtPill" :class="t.status === 'CheckedIn' ? 'mtPill--used' : 'mtPill--valid'">
                                                        {{ t.status === "CheckedIn" ? "Asististe" : "No utilizada" }}
                                                    </span>
                                                </div>
                                                <span class="mtTicketType">{{ t.ticketTypeName }}</span>
                                                <span class="mtTicketAttendee">{{ t.attendeeName || "Sin nombre asignado" }}</span>
                                                <span class="mtTicketCode ecMono notranslate">{{ t.uniqueCode }}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </template>
                    </div>
                </div>

                <!-- Visor fullscreen: el boleto como "Pase digital", espejo del pase de Apple Wallet
                     (plantilla de Plugin.VidaRealWallet, migraciones 006-008): frente con QR para
                     la puerta y reverso con la información del boleto al tocar "i". -->
                <div v-if="shownTicket && shownGroup" class="mtViewer" @click.self="closeViewer">
                    <div class="mtViewerStage">
                        <button type="button" class="mtViewerClose" aria-label="Cerrar" @click="closeViewer">✕</button>
                        <span class="mtPassEyebrow">Pase digital</span>

                        <div class="mtPass" :class="{ isFlipped: passFlipped }" :style="{ '--pass-accent': passAccent }">
                            <div class="mtPassInner">
                                <!-- Frente -->
                                <div class="mtPassFace mtPassFront" :aria-hidden="passFlipped ? 'true' : undefined" :inert="passFlipped || undefined">
                                    <div class="mtPassHead">
                                        <span class="mtPassLogo" aria-hidden="true">VR</span>
                                        <span class="mtPassBrand">VidaReal.tv</span>
                                        <span v-if="shownTicket.ticketTypeName" class="mtPassType">{{ shownTicket.ticketTypeName }}</span>
                                    </div>
                                    <img v-if="shownGroup.imageUrl" :src="shownGroup.imageUrl" :alt="shownGroup.name" class="mtPassStrip" />
                                    <div class="mtPassBody">
                                        <div class="mtPassTear" aria-hidden="true"></div>
                                        <span v-if="shownGroup.category" class="mtPassChip">{{ shownGroup.category }}</span>
                                        <span class="mtPassLabel">Evento</span>
                                        <span class="mtPassEvent">{{ shownGroup.name }}</span>
                                        <div class="mtPassCols">
                                            <div class="mtPassCol">
                                                <span class="mtPassLabel">Fecha</span>
                                                <span class="mtPassValue">{{ passDay(shownGroup.startDateTime) }}<br />{{ passTime(shownGroup.startDateTime) }}</span>
                                            </div>
                                            <div class="mtPassCol">
                                                <span class="mtPassLabel">Lugar</span>
                                                <span class="mtPassValue">{{ shownGroup.venueName || "—" }}<template v-if="shownGroup.campusName"><br />{{ shownGroup.campusName }}</template></span>
                                            </div>
                                            <div class="mtPassCol">
                                                <span class="mtPassLabel">Asistente</span>
                                                <span class="mtPassValue">{{ shownTicket.attendeeName || "Sin asignar" }}</span>
                                            </div>
                                        </div>
                                        <div class="mtPassQrBox">
                                            <img v-if="shownTicket.qrImageUrl" :src="shownTicket.qrImageUrl" class="mtPassQr" :alt="'QR ' + shownTicket.uniqueCode" />
                                        </div>
                                        <span class="mtPassCode ecMono notranslate">{{ shownTicket.uniqueCode }}</span>
                                        <div class="mtPassFoot">
                                            <!-- ↑ = exportar el pase a la Wallet del dispositivo (como el botón de compartir de Wallet). -->
                                            <button v-if="appleWalletEnabled || googleWalletEnabled"
                                                    type="button" class="mtPassRound"
                                                    :aria-label="appleWalletEnabled ? 'Agregar a Apple Wallet' : 'Guardar en Google Wallet'"
                                                    :disabled="walletBusyId !== null"
                                                    @click="appleWalletEnabled ? addToAppleWallet(shownTicket) : addToGoogleWallet(shownTicket)">↑</button>
                                            <span v-else></span>
                                            <button type="button" class="mtPassRound mtPassRound--info" aria-label="Ver el reverso del pase" @click="passFlipped = true"><i>i</i></button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reverso: mismos campos que BackFields del pase de Apple (migración 007). -->
                                <div class="mtPassFace mtPassBack" :aria-hidden="passFlipped ? undefined : 'true'" :inert="!passFlipped || undefined">
                                    <div class="mtPassHead">
                                        <span class="mtPassLogo" aria-hidden="true">VR</span>
                                        <span class="mtPassBrand">VidaReal.tv</span>
                                    </div>
                                    <dl class="mtPassBackList">
                                        <dt>Información del boleto</dt>
                                        <dd>{{ shownGroup.name }}<template v-if="shownTicket.ticketTypeName"> - {{ shownTicket.ticketTypeName }}</template></dd>
                                        <dt>Código</dt>
                                        <dd class="ecMono notranslate">{{ shownTicket.uniqueCode }}</dd>
                                        <template v-if="shownGroup.sessions.length">
                                            <dt>Sesiones</dt>
                                            <dd><span v-for="s in shownGroup.sessions" :key="s" class="mtPassSession">{{ s }}</span></dd>
                                        </template>
                                        <dt>Organizador</dt>
                                        <dd>Vida Real</dd>
                                        <dt>Política</dt>
                                        <dd>Entrada no reembolsable ni transferible. Presenta este pase e identificación en el ingreso.</dd>
                                        <dt>Soporte</dt>
                                        <dd>soporte@vidareal.tv</dd>
                                    </dl>
                                    <div class="mtPassFoot">
                                        <span></span>
                                        <button type="button" class="mtPassRound mtPassRound--info" aria-label="Volver al frente del pase" @click="passFlipped = false">↺</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <span class="mtPassHint">Toca <i>i</i> para ver el reverso del pase</span>
                        <button v-if="appleWalletEnabled"
                                type="button"
                                class="mtWalletBtn"
                                :disabled="walletBusyId !== null"
                                @click="addToAppleWallet(shownTicket)">
                            <svg viewBox="0 0 384 512" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
                            {{ walletBusyId !== null ? "Generando pase…" : "Agregar a Apple Wallet" }}
                        </button>
                        <button v-if="googleWalletEnabled"
                                type="button"
                                class="mtWalletBtn"
                                :disabled="walletBusyId !== null"
                                @click="addToGoogleWallet(shownTicket)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 11v2.4h5.6c-.2 1.4-1.7 4.2-5.6 4.2-3.4 0-6.1-2.8-6.1-6.3S8.6 5 12 5c1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.9 2.3 14.7 1.3 12 1.3 6.9 1.3 2.7 5.5 2.7 10.6S6.9 20 12 20c5.4 0 8.9-3.8 8.9-9.1 0-.6-.1-1.1-.2-1.6H12z"/></svg>
                            {{ walletBusyId !== null ? "Generando pase…" : "Guardar en Google Wallet" }}
                        </button>
                        <span v-if="walletErr" class="mtWalletErr">{{ walletErr }}</span>
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<style>
/* ============================================================
   Vida Real — Eventos • Mis Entradas
   Rediseño 2026 (Claude Design · artboard "05.Eventos - myTickets").
   NO-scoped: oculta el chrome del panel vía ancestro (:has) y posiciona el
   visor de QR a pantalla completa sobre el bloque.
   ============================================================ */

.panel-block:has(.mtPage) > .panel-heading,
.panel-block:has(.mtPage) > .panel-header { display: none !important; }
.panel-block:has(.mtPage) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}
.panel-block:has(.mtPage) > .panel-body { padding: 0 !important; }

@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Regular.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Medium.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Medium.ttf") format("truetype");
    font-weight: 500; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.ttf") format("truetype");
    font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Bold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Bold.ttf") format("truetype");
    font-weight: 700; font-style: normal; font-display: swap;
}

/* El escenario es el contexto de posicionamiento del visor de QR. */
.mtPage {
    position: relative;
    background: #DDE2E5;
    margin: 0 -15px;
    padding-bottom: 48px;
    min-height: 70vh;
    /* La portada vive fuera de .mtWrap (donde están los tokens): sin esto heredaba la fuente del tema. */
    font-family: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;
}
.mtGlobalNote { max-width: 860px; margin: 24px auto; }
.mtLogged { background: transparent; }

/* ---------- Portada: banda oscura compacta, sin foto ---------- */
.mtCover {
    position: relative; width: 100%;
    background: linear-gradient(170deg, #1E2537 0%, #121725 100%);
}
.mtCoverInner {
    padding: clamp(40px, 6vw, 56px) clamp(20px, 4vw, 64px) clamp(40px, 6vw, 60px);
    display: flex; flex-direction: column; gap: 10px;
    max-width: 1280px; margin: 0 auto;
}
.mtCoverTitle {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 64px);
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.02; color: #fff;
}
.mtCoverMeta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    font-size: 15px; color: rgba(255,255,255,0.8);
}

.mtWrap {
    /* Tokens Brújula VR */
    --vr-navy: #0E364C;
    --vr-navy-800: #21465A;
    --paper: #FFFFFF;
    --paper-alt: #F8FAFB;
    --ink-soft: #5B7685;
    --ink-faint: #8297A2;
    --rule-strong: #CAD3D8;
    --action: #1E5B87;
    --action-soft: #EAF1F6;
    --ok-bg: #E9F6F2; --ok-text: #1E7A64;
    --warn-bg: #FDF2E1; --warn-text: #8F5B0B;
    --err-bg: #FCEAE8; --err-text: #B02E22;
    --font-body: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;
    --font-num: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;

    /* Alias de la paleta anterior, remapeados a los tokens */
    --surface-card: var(--paper);
    --surface-mid: var(--paper-alt);
    --surface-alt: var(--action-soft);
    --primary-900: var(--vr-navy);
    --primary-800: var(--vr-navy-800);
    --primary-500: var(--ink-soft);
    --primary-300: var(--ink-faint);
    --primary-200: var(--rule-strong);
    --success-bg: var(--ok-bg);
    --success-text: var(--ok-text);

    max-width: 860px;
    margin: 0 auto;
    padding: 28px 16px 48px;
    font-family: var(--font-body);
    color: var(--primary-900);
}
.mtWrap *, .mtWrap *::before, .mtWrap *::after { box-sizing: border-box; }
.mtWrap .ecMono { font-family: var(--font-num); }
.mtWrap .ecCap::first-letter { text-transform: uppercase; }

/* ---------- Pestañas ---------- */
.mtTabsRow {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
}
.mtTabs { display: flex; gap: 8px; flex-wrap: wrap; }
.mtTab {
    border: 1px solid var(--ink-faint); cursor: pointer; font-family: inherit;
    background: var(--ink-faint); color: #fff;
    padding: 10px 20px; border-radius: 999px; font-size: 14px; font-weight: 600;
    transition: background .15s ease, color .15s ease, border-color .15s ease, filter .15s ease;
}
.mtTab:hover { filter: brightness(1.2); color: #fff; }
.mtTab--active { color: #fff; background: var(--vr-navy); border-color: var(--vr-navy); }
.mtTab--active:hover { filter: brightness(1.2); color: #fff; }


/* ---------- Vacío ---------- */
.mtEmpty {
    text-align: center; padding: 56px 20px; background: var(--surface-mid);
    border: 1px dashed var(--primary-200); border-radius: 18px;
}
.mtEmptyIcon { font-size: 40px; margin-bottom: 8px; }
.mtEmpty h3 { margin: 0 0 6px; font-size: 18px; font-weight: 700; color: var(--primary-900); }
.mtEmpty p { margin: 0 auto; max-width: 380px; font-size: 14px; color: var(--primary-500); }

/* ---------- Card de evento ---------- */
.mtSection { margin-bottom: 28px; }
.mtEvent {
    background: var(--surface-card); border: 1px solid var(--surface-alt); border-radius: 20px;
    overflow: hidden; box-shadow: 0 8px 24px rgba(15, 51, 75, .06); margin-bottom: 20px;
}
.mtEventHero {
    position: relative; min-height: 136px; display: flex; align-items: flex-end;
    background-size: cover; background-position: center;
}
.mtEventHero--noimg { background: linear-gradient(135deg, #142B40, #17344D); }
.mtEventHeroShade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15,51,75,.15) 0%, rgba(15,51,75,.72) 100%);
}
.mtEventHeroInner {
    position: relative; padding: 26px 24px;
    display: flex; flex-direction: column; gap: 5px; align-items: flex-start;
}
.mtPill--neu { background: #EEF2F5; color: var(--primary-900); }
.mtEventTag { align-self: flex-start; text-transform: uppercase; font-size: 10px; letter-spacing: .04em; }
/* En el historial el tag pierde el fondo y queda como rótulo blanco sobre el hero. */
.mtEventTag--past {
    background: transparent; color: #fff;
    padding: 0; border-radius: 0;
}
.mtEventName { margin: 0; font-size: 27px; font-weight: 600; color: #fff; line-height: 1.28; letter-spacing: -0.01em; }
.mtEventHero--tappable { cursor: pointer; }
.mtEventHero--tappable:hover .mtEventHeroShade {
    background: linear-gradient(180deg, rgba(15,51,75,.28) 0%, rgba(15,51,75,.8) 100%);
}
.mtEventHero--tappable:hover.mtEventHero--noimg { filter: brightness(1.08); }

.mtEventMeta {
    padding: 18px 24px 20px; display: flex; flex-direction: column; gap: 6px;
    background: var(--surface-card); border-bottom: 1px solid var(--surface-alt);
}
.mtEventMetaRow { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.mtEventMetaText { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.mtEventMetaDate { font-size: 13.5px; font-weight: 600; color: var(--primary-800); }
.mtEventMetaVenue { font-size: 13.5px; color: var(--primary-500); }
.mtEvent:not(.mtEvent--past) .mtEventMetaDate,
.mtEvent:not(.mtEvent--past) .mtEventMetaVenue { font-size: 15px; }
.mtEventCount {
    flex: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    background: var(--surface-mid); color: var(--primary-900); border: 1px solid var(--primary-200);
    font-size: 13.5px; font-weight: 600; padding: 10px 16px; border-radius: 999px; font-family: inherit;
}
.mtEventCount:hover { background: var(--surface-alt); }
.mtEventChevron { font-size: 10px; color: var(--primary-500); }

/* ---------- Entradas dentro del evento ---------- */
.mtTickets { display: flex; flex-direction: column; gap: 10px; padding: 4px 18px 18px; }
.mtTicket {
    display: flex; gap: 18px; align-items: center; padding: 16px 18px;
    background: var(--surface-mid); border-radius: 14px;
}
.mtQr {
    width: 108px; height: 108px; flex: none; border: 1px solid var(--surface-alt);
    border-radius: 12px; background: #fff; padding: 5px;
}
.mtTicketInfo { display: flex; flex-direction: column; gap: 6px; min-width: 0; flex: 1; }
.mtTicketTags { display: flex; gap: 6px; flex-wrap: wrap; }
.mtPill { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 999px; }
.mtPill--mine { background: var(--primary-900); color: #fff; }
.mtPill--valid { background: var(--success-bg); color: var(--success-text); }
.mtPill--used { background: var(--surface-alt); color: var(--primary-500); }
.mtTicketType { font-size: 16px; font-weight: 700; color: var(--primary-900); }
.mtTicketTime { font-size: 13px; font-weight: 600; color: var(--primary-800); }
.mtTicketAttendee { font-size: 14px; color: var(--primary-500); }
.mtTicketCode { font-size: 13px; font-weight: 700; letter-spacing: 2px; color: var(--primary-800); }
.mtTicketFoot { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
.mtResend {
    border: none; background: none; padding: 0; color: var(--primary-500);
    font-size: 12px; font-weight: 500; text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer; font-family: inherit;
}
.mtResend:hover:not(:disabled) { color: var(--primary-900); }
.mtResend:disabled { opacity: .6; cursor: default; }
.mtSent { font-size: 11px; color: var(--primary-300); }
.mtTicket--tappable { cursor: pointer; }
.mtTicket--tappable:hover { background: var(--surface-alt); }
.mtShowHint { font-size: 11px; color: var(--primary-300); margin-top: 2px; }

/* ---------- Historial ---------- */
.mtEvent--past { opacity: .82; filter: grayscale(1); }
.mtEvent--past .mtEventHero--noimg { background: linear-gradient(135deg, #929393, #143E5A); }
.mtEvent--past .mtEventHero { min-height: 108px; }

/* ---------- Visor fullscreen: "Pase digital" ---------- */
/* fixed (no absolute): el pase debe quedar a la vista aunque el usuario haya bajado por la
   lista; el visor hace su propio scroll si el pase no cabe. */
.mtViewer {
    position: fixed; inset: 0; z-index: 1050;
    background: rgba(243, 245, 247, .97); backdrop-filter: blur(3px);
    display: flex; align-items: flex-start; justify-content: center;
    padding: clamp(32px, 8vh, 88px) 16px 32px; overflow-y: auto;
}
.mtViewerStage {
    position: relative; width: 100%; max-width: 360px;
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
.mtViewerClose {
    position: absolute; top: -6px; right: 0; border: none; background: #E3E8EC;
    color: #143E5A; width: 32px; height: 32px; border-radius: 50%;
    font-size: 14px; cursor: pointer; line-height: 1;
}
.mtPassEyebrow { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8297A2; }

/* La tarjeta: barra de acento arriba (color de la categoría), cuerpo blanco. Frente y reverso
   comparten celda de grid y se voltean en 3D. */
.mtPass { --pass-accent: rgb(100,116,139); width: 100%; perspective: 1400px; }
.mtPassInner {
    display: grid; transform-style: preserve-3d;
    transition: transform .55s ease;
}
.mtPass.isFlipped .mtPassInner { transform: rotateY(180deg); }
.mtPassFace[inert] { pointer-events: none; }
.mtPassFace {
    grid-area: 1 / 1; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    /* backface-visibility solo oculta: Safari sigue dando clics a la cara de atrás. `inert` en el
       template quita clics y foco; pointer-events es el respaldo para navegadores sin inert. */
    background: #fff; border-radius: 24px; overflow: hidden;
    border-top: 6px solid var(--pass-accent);
    box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
    display: flex; flex-direction: column;
}
.mtPassBack { transform: rotateY(180deg); }

.mtPassHead { display: flex; align-items: center; gap: 10px; padding: 14px 20px; }
.mtPassLogo {
    width: 32px; height: 32px; flex: none; border-radius: 8px;
    background: #1C2433; color: #fff; font-size: 12px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
}
.mtPassBrand { font-size: 17px; font-weight: 600; color: #0F172A; }
.mtPassType {
    margin-left: auto; padding: 5px 12px; border-radius: 999px; background: #EEF1F5;
    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #334155;
    max-width: 50%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mtPassStrip { display: block; width: 100%; height: 128px; object-fit: cover; }
.mtPassBody { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 0 20px 16px; }
.mtPassTear { align-self: stretch; height: 0; border-top: 2px dashed #CBD5E1; margin: 14px 0 16px; }
.mtPassChip {
    padding: 4px 11px; border-radius: 999px; margin-bottom: 8px;
    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--pass-accent); background: color-mix(in srgb, var(--pass-accent) 14%, #fff);
}
.mtPassLabel { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #64748B; }
.mtPassEvent { font-size: 19px; font-weight: 700; color: #0F172A; line-height: 1.25; margin-bottom: 14px; }
.mtPassCols { align-self: stretch; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.mtPassCol { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.mtPassValue { font-size: 13px; color: #0F172A; line-height: 1.35; overflow-wrap: anywhere; }
.mtPassQrBox {
    align-self: center; margin-top: 22px; width: 156px; height: 156px;
    border: 1px dashed #C7CEE0; border-radius: 14px; padding: 8px; background: #fff;
}
.mtPassQr { width: 100%; height: 100%; image-rendering: pixelated; display: block; }
.mtPassCode { align-self: center; margin-top: 8px; font-size: 12px; font-weight: 500; letter-spacing: 2px; color: #64748B; }
.mtPassFoot { align-self: stretch; display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }
.mtPassBack .mtPassFoot { margin-top: auto; padding: 14px 20px 16px; }
.mtPassRound {
    width: 32px; height: 32px; border-radius: 50%; border: 1px solid #D5DBE3; background: #fff;
    color: #475569; font-size: 15px; line-height: 1; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; font-family: Georgia, serif;
}
.mtPassRound:hover:not(:disabled) { background: #F1F5F9; }
.mtPassRound:disabled { opacity: .5; cursor: default; }
.mtPassBackList { margin: 0; padding: 4px 20px 0; display: flex; flex-direction: column; }
.mtPassBackList dt {
    font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--pass-accent); margin-top: 14px;
}
.mtPassBackList dd { margin: 4px 0 0; font-size: 13px; color: #0F172A; line-height: 1.45; padding-bottom: 12px; border-bottom: 1px solid #EEF1F5; }
.mtPassSession { display: block; }
.mtPassHint { font-size: 12px; color: #64748B; }
.mtPassHint i { font-family: Georgia, serif; }

.mtWalletBtn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px;
    background: #000; color: #fff; border: none; border-radius: 10px;
    font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
}
.mtWalletBtn:hover { background: #1c1c1e; color: #fff; }
.mtWalletBtn:disabled { opacity: .6; cursor: default; }
.mtWalletBtn svg { width: 15px; height: 15px; fill: currentColor; flex: none; }
.mtWalletErr { font-size: 12px; color: #dc2626; }

@media (max-width: 720px) {
    /* Móvil a sangre, igual que el checkout: calc(50% - 50vw) cancela el padding de CUALQUIER
       contenedor del tema. El `margin: 0` anterior quitaba la compensación y dejaba un marco
       gris de 15px a los lados. */
    .mtPage { width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
}
@media (max-width: 560px) {
    .mtTicket { flex-direction: column; align-items: flex-start; }
    .mtQr { width: 140px; height: 140px; align-self: center; }
    .mtTabsRow { flex-direction: column; align-items: stretch; }
    .mtEventMetaRow { flex-wrap: wrap; }
}
@media (prefers-reduced-motion: reduce) {
    .mtTab, .mtEventHero--tappable, .mtPassInner { transition: none; }
}
</style>

<script setup lang="ts">
import { computed, ref } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type TicketBag = {
    ticketId: number;
    eventId: number;
    eventName: string | null;
    eventCategory: string | null;
    /** Color del catálogo "Tipos de Evento"; null = chip neutro y acento slate. */
    eventCategoryColor?: string | null;
    eventStartDateTime: string | null;
    eventEndDateTime: string | null;
    eventSessions: string[] | null;
    eventImageUrl: string | null;
    venueName: string | null;
    campusName?: string | null;
    ticketTypeName: string | null;
    attendeeName: string | null;
    isCurrentUser: boolean;
    uniqueCode: string | null;
    qrImageUrl: string | null;
    status: string | null;
    emailSentCount: number;
    emailSentDateTime: string | null;
};
type InitBag = { notLogged: boolean; appleWalletEnabled?: boolean; googleWalletEnabled?: boolean; tickets: TicketBag[] };

type EventGroup = {
    eventId: number;
    name: string;
    category: string | null;
    categoryColor: string | null;
    startDateTime: string | null;
    endDateTime: string | null;
    sessions: string[];
    imageUrl: string | null;
    venueName: string | null;
    campusName: string | null;
    tickets: TicketBag[];
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const tickets = ref<TicketBag[]>(config.tickets || []);
const resendingId = ref<number | null>(null);
const err = ref<string>("");
const notice = ref<string>("");
// Pestañas del rediseño 2026: próximos e historial dejaron de ser dos secciones apiladas.
const activeTab = ref<"upcoming" | "past">("upcoming");

// Cards de evento plegadas por defecto: con varios eventos (y varias entradas c/u) la página
// se hacía interminable. Tocar el hero despliega sus entradas; con UN solo evento próximo se
// abre solo.
const expandedIds = ref<Set<number>>(new Set());

function toggleEvent(eventId: number): void {
    const next = new Set(expandedIds.value);
    if (next.has(eventId)) {
        next.delete(eventId);
    }
    else {
        next.add(eventId);
    }
    expandedIds.value = next;
}

function isExpanded(g: EventGroup): boolean {
    return expandedIds.value.has(g.eventId)
        || (upcomingGroups.value.length === 1 && upcomingGroups.value[0].eventId === g.eventId);
}

// Visor fullscreen: la entrada seleccionada para enseñar el QR en la puerta.
const shownTicket = ref<TicketBag | null>(null);
const shownGroup = ref<EventGroup | null>(null);
/** Reverso del pase visible (se voltea con el botón "i"). */
const passFlipped = ref<boolean>(false);

function showTicket(t: TicketBag, g: EventGroup): void {
    if (!t.qrImageUrl) {
        return;
    }
    shownTicket.value = t;
    shownGroup.value = g;
    passFlipped.value = false;
    walletErr.value = "";
}

function closeViewer(): void {
    shownTicket.value = null;
    shownGroup.value = null;
    passFlipped.value = false;
}

// Acento del pase: el color del catálogo de la categoría (barra superior y chip), como el
// LabelColor del pase de Apple; sin color, slate.
const passAccent = computed<string>(() => {
    const rgb = parseColor(shownGroup.value?.categoryColor);
    return rgb ? `rgb(${rgb.join(",")})` : "rgb(100,116,139)";
});

// Wallet: cada botón aparece si su plataforma está configurada (init bag) y el dispositivo
// corresponde — Apple en iPhone/iPad/Mac, Google en el resto (Android). El .pkpass no abre
// nada útil en Android y viceversa.
const isApplePlatform = /iPhone|iPad|iPod|Macintosh/i.test(navigator.userAgent);
const appleWalletEnabled = (config.appleWalletEnabled ?? false) && isApplePlatform;
const googleWalletEnabled = (config.googleWalletEnabled ?? false) && !isApplePlatform;
const walletBusyId = ref<number | null>(null);
const walletErr = ref<string>("");

async function addToWallet(t: TicketBag | null, action: "GetApplePass" | "GetGoogleWalletUrl"): Promise<void> {
    if (!t || walletBusyId.value !== null) {
        return;
    }
    walletBusyId.value = t.ticketId;
    walletErr.value = "";
    try {
        const res = await invokeBlockAction<{ url: string }>(action, { bag: { ticketId: t.ticketId } });
        if (!res.isSuccess || !res.data?.url) {
            walletErr.value = res.errorMessage || "No se pudo generar el pase.";
            return;
        }
        // Navegación real (no fetch): Safari detecta el MIME application/vnd.apple.pkpass y abre
        // la hoja nativa "Agregar a Apple Wallet"; el link de Google abre la página de guardado.
        window.location.href = res.data.url;
    }
    catch {
        walletErr.value = "Error de red. Intenta de nuevo.";
    }
    finally {
        walletBusyId.value = null;
    }
}

const addToAppleWallet = (t: TicketBag | null): Promise<void> => addToWallet(t, "GetApplePass");
const addToGoogleWallet = (t: TicketBag | null): Promise<void> => addToWallet(t, "GetGoogleWalletUrl");

// Agrupa los tickets por evento conservando el orden (ya viene por fecha desc del servidor).
function groupByEvent(list: TicketBag[]): EventGroup[] {
    const groups = new Map<number, EventGroup>();
    for (const t of list) {
        let g = groups.get(t.eventId);
        if (!g) {
            g = {
                eventId: t.eventId,
                name: t.eventName || "Evento",
                category: t.eventCategory,
                categoryColor: t.eventCategoryColor ?? null,
                startDateTime: t.eventStartDateTime,
                endDateTime: t.eventEndDateTime,
                sessions: t.eventSessions || [],
                imageUrl: t.eventImageUrl,
                venueName: t.venueName,
                campusName: t.campusName ?? null,
                tickets: []
            };
            groups.set(t.eventId, g);
        }
        g.tickets.push(t);
    }
    // Dentro de cada evento: primero "tu entrada", luego el resto.
    for (const g of groups.values()) {
        g.tickets.sort((a, b) => Number(b.isCurrentUser) - Number(a.isCurrentUser) || a.ticketId - b.ticketId);
    }
    return Array.from(groups.values());
}

// Un evento es "pasado" cuando su HORA DE FIN ya quedó atrás. Si no tiene hora de fin, se asume
// una duración implícita de 12 h desde el inicio, para que un evento en curso (empezó pero no ha
// terminado) siga en "próximos" y conserve su QR visible en la puerta — no se caiga a "pasados"
// apenas pasa la hora de inicio.
const IMPLICIT_EVENT_HOURS = 12;
function isPast(g: EventGroup): boolean {
    let refMs: number;
    if (g.endDateTime) {
        refMs = new Date(g.endDateTime).getTime();
    }
    else if (g.startDateTime) {
        refMs = new Date(g.startDateTime).getTime() + IMPLICIT_EVENT_HOURS * 3600_000;
    }
    else {
        return false;
    }
    return !isNaN(refMs) && refMs < Date.now();
}

const upcomingGroups = computed<EventGroup[]>(() =>
    groupByEvent(tickets.value).filter(g => !isPast(g))
        .sort((a, b) => new Date(a.startDateTime ?? 0).getTime() - new Date(b.startDateTime ?? 0).getTime()));

const pastGroups = computed<EventGroup[]>(() =>
    groupByEvent(tickets.value).filter(g => isPast(g))
        .sort((a, b) => new Date(b.startDateTime ?? 0).getTime() - new Date(a.startDateTime ?? 0).getTime()));

// Línea de lugar "venue · sede", igual que en el calendario.
function venueLine(g: EventGroup): string {
    return [g.venueName, g.campusName].filter(Boolean).join(" · ");
}

/** "#RRGGBB", "#RGB" o "rgb(r,g,b)" → [r, g, b]; null si no se reconoce. */
function parseColor(value: string | null | undefined): [number, number, number] | null {
    const c = (value ?? "").trim();
    let m = /^#([0-9a-f]{6})$/i.exec(c);
    if (m) {
        const n = parseInt(m[1], 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    m = /^#([0-9a-f])([0-9a-f])([0-9a-f])$/i.exec(c);
    if (m) {
        return [parseInt(m[1] + m[1], 16), parseInt(m[2] + m[2], 16), parseInt(m[3] + m[3], 16)];
    }
    m = /^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/i.exec(c);
    return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
}

// Chip de categoría: tinte claro del color del catálogo con el texto en el mismo tono oscurecido
// (JÓVENES verde claro, CONFERENCIA azul claro). Sin color, manda el CSS (.mtPill--neu).
function chipStyle(color: string | null | undefined): Record<string, string> {
    const rgb = parseColor(color);
    if (!rgb) {
        return {};
    }
    const tint = rgb.map(v => Math.round(v * 0.16 + 255 * 0.84));
    const ink = rgb.map(v => Math.round(v * 0.55));
    return { background: `rgb(${tint.join(",")})`, color: `rgb(${ink.join(",")})` };
}

// Fecha del pase en dos renglones, como el campo FECHA de Wallet: "Mié 22 jul" / "03:00 p. m.".
function passDay(value: string | null): string {
    const d = value ? new Date(value) : null;
    if (!d || isNaN(d.getTime())) {
        return "—";
    }
    const wd = d.toLocaleDateString("es-GT", { weekday: "short" }).replace(".", "");
    const mon = d.toLocaleDateString("es-GT", { month: "short" }).replace(".", "");
    return `${wd.charAt(0).toUpperCase()}${wd.slice(1)} ${d.getDate()} ${mon}`;
}

function passTime(value: string | null): string {
    const d = value ? new Date(value) : null;
    return !d || isNaN(d.getTime()) ? "" : d.toLocaleTimeString("es-GT", { hour: "2-digit", minute: "2-digit" });
}

function formatEventDate(value: string | null): string {
    if (!value) {
        return "";
    }
    const d = new Date(value);
    if (isNaN(d.getTime())) {
        return "";
    }
    return d.toLocaleDateString("es-GT", { weekday: "long", day: "numeric", month: "long", year: "numeric" })
        + " · " + d.toLocaleTimeString("es-GT", { hour: "numeric", minute: "2-digit" });
}

async function resend(ticketId: number): Promise<void> {
    resendingId.value = ticketId;
    err.value = "";
    notice.value = "";
    try {
        // Rock bindea los parámetros del block action por NOMBRE: la firma C# es (bag), así que
        // el payload debe ser { bag: { ticketId } } — con { ticketId } suelto responde 400.
        const res = await invokeBlockAction<{ sent: boolean; ticket: TicketBag | null }>("ResendTicketEmail", { bag: { ticketId } });
        if (!res.isSuccess || !res.data || !res.data.sent) {
            err.value = res.errorMessage || "No se pudo reenviar el correo.";
            return;
        }
        if (res.data.ticket) {
            const idx = tickets.value.findIndex(t => t.ticketId === ticketId);
            if (idx >= 0) {
                tickets.value[idx] = res.data.ticket;
            }
        }
        notice.value = "Correo reenviado: revisa tu bandeja (lleva el PDF con tu boleto).";
    }
    catch {
        err.value = "Error reenviando el correo.";
    }
    finally {
        resendingId.value = null;
    }
}
</script>
