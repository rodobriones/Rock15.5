<!-- STEP 5: Listo — confirmación con QR por entrada, descarga de PDF y salida. -->
<template>
    <div class="ecDone">
        <h2 class="ecDoneTitle">¡Listo! Tus boletos<br />están confirmados</h2>
        <p class="ecDoneText">Enviamos el comprobante y tus entradas a tu correo.</p>

        <div v-if="confirmation" class="ecDoneCard">
            <div class="ecDoneTop">
                <span class="ecDoneEvent">{{ event?.name }}</span>
                <div class="ecDoneOrderBox">
                    <span class="ecDoneOrder ecMono">Orden #{{ confirmation.orderId }}</span>
                </div>
            </div>
            <div v-if="eventDayLabel || eventSubtitle" class="ecDoneSub">{{ eventDayLabel }}<span v-if="eventDayLabel && eventSubtitle"> · </span>{{ eventSubtitle }}</div>
            <div class="ecDoneList">
                <div v-for="t in confirmation.tickets" :key="t.uniqueCode" class="ecDoneItem">
                    <img v-if="t.qrImageDataUri" :src="t.qrImageDataUri" class="ecDoneItemQr" alt="Código QR de la entrada" />
                    <div class="ecDoneItemInfo">
                        <span class="ecDoneMeta">{{ t.ticketTypeName }}<span v-if="t.attendeeName"> · {{ t.attendeeName }}</span></span>
                        <span class="ecDoneCode ecMono notranslate">{{ t.uniqueCode }}</span>
                    </div>
                </div>
            </div>
            <div class="ecDoneFooter" :class="{ 'ecDoneFooter--detail': hasBreakdown }">
                <!-- Con descuento o recargo, el desglose explica por qué lo cobrado difiere del precio de lista. -->
                <div v-if="hasBreakdown" class="ecDoneBreak">
                    <div class="ecDoneBreakRow">
                        <span>Subtotal</span>
                        <span class="ecMono">{{ formatCurrency(confirmation.subtotal) }}</span>
                    </div>
                    <div v-if="confirmation.discountTotal > 0" class="ecDoneBreakRow ecDoneBreakRow--disc">
                        <span>Descuento</span>
                        <span class="ecMono">−{{ formatCurrency(confirmation.discountTotal) }}</span>
                    </div>
                    <div v-if="confirmation.surcharge > 0" class="ecDoneBreakRow">
                        <span>Recargo por pago en cuotas</span>
                        <span class="ecMono">+{{ formatCurrency(confirmation.surcharge) }}</span>
                    </div>
                </div>
                <div class="ecDoneTotalBox">
                    <span class="ecDoneTotalLabel">{{ hasBreakdown ? "Total cobrado" : "Total" }}</span>
                    <span class="ecDoneTotalVal ecMono">{{ formatCurrency(chargedTotal) }}</span>
                </div>
            </div>
        </div>

        <div class="ecDoneActions">
            <button type="button" class="ecDoneBtn" :disabled="pdfBusy" @click="downloadPdf"><span class="notranslate">{{ pdfBusy ? "Generando PDF…" : "Descargar PDF" }}</span></button>
            <button v-if="walletKind" type="button" class="ecDoneBtn" :disabled="walletBusy" @click="addToWallet">
                <span class="notranslate">{{ walletBusy ? "Generando pase…" : (walletKind === "apple" ? "Agregar a Apple Wallet" : "Guardar en Google Wallet") }}</span>
            </button>
        </div>
        <span v-if="walletError" class="ecDoneWalletErr">{{ walletError }}</span>
        <button type="button" class="ecDoneRestart" @click="goHome">Regresar a mi listado de eventos</button>
    </div>
</template>

<script setup lang="ts">
import { computed } from "vue";
import { useCheckoutState } from "./checkoutState.partial";

const {
    event,
    confirmation,
    eventDayLabel,
    eventSubtitle,
    formatCurrency,
    pdfBusy,
    downloadPdf,
    walletKind,
    walletBusy,
    walletError,
    addToWallet,
    goHome
} = useCheckoutState();

// Solo hay desglose cuando lo cobrado difiere del precio de lista (descuento o recargo).
const hasBreakdown = computed<boolean>(() =>
    (confirmation.value?.discountTotal ?? 0) > 0 || (confirmation.value?.surcharge ?? 0) > 0);

// Órdenes viejas (bag sin amountCharged) caen al total de la orden.
const chargedTotal = computed<number>(() =>
    confirmation.value?.amountCharged || confirmation.value?.total || 0);
</script>
