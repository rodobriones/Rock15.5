<template>
    <Panel type="block" title="Eventos • Reportería" class="er-panel">
        <template #default>
            <div class="erWrap">
            <NotificationBox v-if="config.notLogged" alertType="warning">
                Debes iniciar sesión para ver la reportería.
            </NotificationBox>

            <NotificationBox v-else-if="!config.canView" alertType="warning">
                No tienes permiso para ver la reportería.
            </NotificationBox>

            <NotificationBox v-else-if="config.events.length === 0" alertType="info">
                No tienes eventos asignados en la reportería. Pide a un administrador que te asigne
                los eventos que puedes ver (Administrar Eventos → Permisos).
            </NotificationBox>

            <div v-else>
                <NotificationBox v-if="err" alertType="danger" class="mb-3">{{ err }}</NotificationBox>

                <div class="row">
                    <div class="col-md-5">
                        <DropDownList v-model="selectedEventId"
                                      label="Evento"
                                      :items="eventItems"
                                      :showBlankItem="false"
                                      :enhanceForLongLists="true"
                                      :grouped="true" />
                    </div>
                    <div class="col-md-7 text-right">
                        <RockButton btnType="default" btnSize="sm" :disabled="busy || !selectedEventId" @click="loadReport">
                            {{ busy ? "Cargando..." : "Recargar" }}
                        </RockButton>
                        <RockButton btnType="primary" btnSize="sm" :disabled="!report || report.rows.length === 0" @click="downloadCsv">
                            Descargar CSV
                        </RockButton>
                    </div>
                </div>

                <div v-if="busy" class="text-muted">Cargando reporte...</div>

                <div v-else-if="report">
                    <!-- Estadísticas -->
                    <div class="erStats">
                        <div class="erStat">
                            <span class="erStatVal">{{ report.soldCount }}</span>
                            <span class="erStatLabel">Inscritos</span>
                        </div>
                        <div class="erStat">
                            <span class="erStatVal">{{ report.checkedInCount }}</span>
                            <span class="erStatLabel">Check-ins</span>
                        </div>
                        <div class="erStat">
                            <span class="erStatVal">{{ report.attendancePct }}%</span>
                            <span class="erStatLabel">Asistencia</span>
                        </div>
                        <div class="erStat">
                            <span class="erStatVal">{{ fmtCurrency(report.revenue) }}</span>
                            <span class="erStatLabel">Ingresos</span>
                        </div>
                        <div class="erStat">
                            <span class="erStatVal">{{ report.paidOrderCount }}</span>
                            <span class="erStatLabel">Órdenes pagadas</span>
                        </div>
                    </div>

                    <!-- Desglose por tipo de entrada -->
                    <h5 class="mt-4">Por tipo de entrada</h5>
                    <table class="grid-table table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th class="text-right">Vendidos</th>
                                <th class="text-right">Check-ins</th>
                                <th class="text-right">Cupo</th>
                                <th class="text-right">Disponibles</th>
                                <th class="text-right">Ingresos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="t in report.byType" :key="t.id">
                                <td>{{ t.name }}</td>
                                <td class="text-right">{{ t.sold }}</td>
                                <td class="text-right">{{ t.checkedIn }}</td>
                                <td class="text-right">{{ t.capacity == null ? "∞" : t.capacity }}</td>
                                <td class="text-right">{{ t.capacity == null ? "∞" : Math.max(0, t.capacity - t.sold) }}</td>
                                <td class="text-right">{{ fmtCurrency(revenueByType[t.id] ?? 0) }}</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Listado de inscritos -->
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                        <h5 class="mb-0">Inscritos ({{ filteredRows.length }})</h5>
                        <div class="d-flex" style="gap: 8px;">
                            <div style="width: 170px;">
                                <DropDownList v-model="checkinFilter" :items="checkinFilterOptions" :showBlankItem="false" />
                            </div>
                            <div style="width: 260px;">
                                <TextBox v-model="search" placeholder="Buscar por nombre, código, comprador..." />
                            </div>
                        </div>
                    </div>

                    <div v-if="report.rows.length === 0" class="text-muted">Este evento aún no tiene inscritos.</div>

                    <table v-else class="grid-table table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Asistente</th>
                                <th>Tipo</th>
                                <th>Código</th>
                                <th>Check-in</th>
                                <th>Comprador</th>
                                <th>Compra</th>
                                <th class="text-right">Orden</th>
                                <th class="text-right">Precio</th>
                                <th v-if="report.canResend"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <template v-for="r in filteredRows" :key="r.ticketId">
                                <tr>
                                    <td>{{ r.attendeeName || "— (sin asignar)" }}</td>
                                    <td>{{ r.ticketTypeName }}</td>
                                    <td class="notranslate" style="font-family: monospace;">{{ r.uniqueCode }}</td>
                                    <td>
                                        <span v-if="r.checkedIn" class="label label-success">✓ {{ fmtDateTime(r.checkedInDateTime) }}</span>
                                        <span v-else class="label label-default">Pendiente</span>
                                    </td>
                                    <td>
                                        {{ r.buyerName }}
                                        <div v-if="report.canResend && r.deliveryEmail" class="text-muted" style="font-size:11px;">{{ r.deliveryEmail }}</div>
                                    </td>
                                    <td style="white-space:nowrap;">{{ r.purchasedDateTime ? fmtDateTime(r.purchasedDateTime) : "—" }}</td>
                                    <td class="text-right">#{{ r.orderId }}</td>
                                    <td class="text-right">{{ fmtCurrency(r.pricePaid) }}</td>
                                    <td v-if="report.canResend" class="text-center" style="white-space:nowrap;">
                                        <button type="button" class="btn btn-xs btn-default" title="Corregir correo y reenviar entradas"
                                                @click="openEmailEdit(r)">
                                            <i class="fa fa-envelope"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="emailEdit && emailEdit.ticketId === r.ticketId" class="erEditRow">
                                    <td colspan="9">
                                        <div class="d-flex align-items-end" style="gap:8px; flex-wrap:wrap;">
                                            <div style="width:320px;">
                                                <TextBox v-model="emailEdit.email" label="Correo de envío" type="email" />
                                            </div>
                                            <div style="padding-bottom:15px;">
                                                <RockButton btnType="primary" btnSize="sm" :disabled="emailEdit.busy || !emailEdit.email.trim()" @click="resendOrderEmail">
                                                    {{ emailEdit.busy ? "Enviando..." : "Guardar y reenviar" }}
                                                </RockButton>
                                                <RockButton btnType="default" btnSize="sm" :disabled="emailEdit.busy" @click="emailEdit = null">
                                                    Cerrar
                                                </RockButton>
                                            </div>
                                        </div>
                                        <div class="text-muted" style="font-size:12px;">
                                            Se reenviarán <strong>todas</strong> las entradas de la orden #{{ emailEdit.orderId }} a este correo.
                                            Si lo corriges, los reintentos automáticos también usarán el correo nuevo.
                                        </div>
                                        <div v-if="emailEdit.msg" :class="emailEdit.ok ? 'text-success' : 'text-danger'" style="font-size:12px; margin-top:4px;">
                                            {{ emailEdit.msg }}
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
            </div>
        </template>
    </Panel>
</template>

<style>
/* ============================================================
   Vida Real — Eventos • Reportería
   Rediseño 2026 (Claude Design · artboard "09. Eventos - eventReport").
   NO-scoped a propósito: este bloque SÍ se apoya en el chrome de Rock
   (Panel + Bootstrap 3 del tema) y el rediseño consiste en re-estilar ese
   chrome desde el ancestro del bloque, sin ocultarlo.
   ============================================================ */

@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Regular.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Medium.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Medium.ttf") format("truetype");
    font-weight: 500; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-SemiBold.ttf") format("truetype");
    font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Montserrat";
    src: url("/Assets/Fonts/Montserrat/Montserrat-Bold.woff2") format("woff2"),
         url("/Assets/Fonts/Montserrat/Montserrat-Bold.ttf") format("truetype");
    font-weight: 700; font-style: normal; font-display: swap;
}

/* ---------- Escenario: el panel flota sobre el gris de página ---------- */
.block-instance:has(.erWrap) {
    background: #F3F5F7;
    margin: 0 -15px;
    padding: 24px;
    position: relative;
}

/* ---------- Panel de Rock (se conserva, se re-estiliza) ---------- */
.panel-block:has(.erWrap) {
    background: #fff !important;
    border: 1px solid #E1E7EC !important;
    border-radius: 6px !important;
    box-shadow: 0 1px 2px rgba(15, 51, 75, .05) !important;
}
.panel-block:has(.erWrap) > .panel-heading,
.panel-block:has(.erWrap) > .panel-header {
    padding: 12px 18px !important;
    background: #fff !important;
    border-bottom: 1px solid #E1E7EC !important;
}
.panel-block:has(.erWrap) > .panel-heading .panel-title,
.panel-block:has(.erWrap) > .panel-header .panel-title {
    font-family: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 28px; font-weight: 600; color: #0F334B; margin: 0;
}
.panel-block:has(.erWrap) > .panel-body { padding: 18px !important; }

.erWrap {
    /* Tokens Brújula VR */
    --vr-navy: #0E364C;
    --paper: #FFFFFF;
    --paper-alt: #F8FAFB;
    --ink: #143E5A;
    --ink-soft: #5A6E7C;
    --ink-faint: #8296A2;
    --rule: #E1E7EC;
    --rule-strong: #C9D4DC;
    --action: #1E5B87;
    --action-soft: #EAF1F6;
    --ok-text: #1E7A64; --ok-bg: #E9F6F2; --ok-fill: #39B396;
    --warn-text: #8F5B0B; --warn-bg: #FDF2E1; --warn-fill: #F09E30;
    --err-text: #B02E22; --err-bg: #FCEAE8; --err-fill: #E74133;
    --font-body: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;
    --font-num: "Montserrat", "Segoe UI", Helvetica, Arial, sans-serif;

    font-family: var(--font-body);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.42857143;
}
.erWrap *, .erWrap *::before, .erWrap *::after { box-sizing: border-box; }

/* ---------- Controles ---------- */
.erWrap .control-label { display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 5px; }
.erWrap .form-control {
    display: block; width: 100%; height: 34px; padding: 6px 12px;
    font-size: 14px; color: var(--ink); background: var(--paper);
    border: 1px solid var(--rule-strong); border-radius: 4px;
    font-family: inherit; outline: none; box-shadow: none;
}
/* Los DropDownList de Obsidian son Ant Select, no <select>: el tema les pone el padding y el alto
   en .ant-select-selector (con !important) y deja el contenedor en padding: 0. Al redefinir aquí
   .form-control se lo devolvíamos al contenedor —texto ~12px más adentro que el de los inputs— y
   el selector conservaba el alto del tema en vez del de este bloque. Estas dos líneas alinean los
   desplegables con los inputs en horizontal y en vertical. */
.erWrap .ant-select.form-control { padding: 0; }
.erWrap .ant-select.form-control .ant-select-selector { height: 100% !important; }
.erWrap .form-control:focus { border-color: var(--action); box-shadow: 0 0 0 3px rgba(30,91,135,.18); }

/* ---------- Botones (píldora del rediseño) ---------- */
.erWrap .btn {
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--rule-strong) !important;
    background: var(--paper) !important; color: var(--ink) !important;
    border-radius: 20px !important; font-family: inherit;
    padding: 10px 20px !important; font-size: 15px !important; font-weight: 500;
    text-decoration: none; box-shadow: none !important;
}
.erWrap .btn.btn-default:hover:not(:disabled) { background: var(--paper-alt) !important; }
.erWrap .btn.btn-primary {
    background: #0F334B !important; border-color: #0F334B !important; color: #fff !important;
}
.erWrap .btn.btn-primary:hover:not(:disabled) { background: var(--vr-navy) !important; color: #fff !important; }
.erWrap .btn:disabled { opacity: .55; cursor: default; }
.erWrap .btn + .btn { margin-left: 6px; }

/* ---------- Tablas ---------- */
.erWrap .grid-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 13px; }
.erWrap .table-bordered,
.erWrap .table-bordered th,
.erWrap .table-bordered td { border: 1px solid var(--rule); }
.erWrap .grid-table th { background: var(--action-soft); font-weight: 600; color: #0F334B; }
.erWrap .grid-table th,
.erWrap .grid-table td { padding: 8px 10px; vertical-align: middle; }
.erWrap .table-striped tbody tr:nth-of-type(odd) { background: var(--paper-alt); }
.erWrap .notranslate { font-family: var(--font-num); }

.erWrap .label {
    display: inline-block; padding: 3px 8px; border-radius: 999px;
    font-size: 11px; font-weight: 600;
}
.erWrap .label-success { background: var(--ok-bg); color: var(--ok-text); }
.erWrap .label-default { background: var(--action-soft); color: var(--ink-soft); }

.erWrap .alert {
    padding: 12px 16px; border-radius: 6px; font-size: 14px; border: 1px solid transparent;
}
.erWrap .alert-warning { background: var(--warn-bg); border-color: var(--warn-fill); color: var(--warn-text); }
.erWrap .alert-info { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
.erWrap .alert-danger { background: var(--err-bg); border-color: var(--err-fill); color: var(--err-text); }

.erWrap h5 { font-size: 15px; font-weight: 700; color: #0F334B; margin: 0 0 10px; }
.erWrap .text-muted { color: var(--ink-soft); }

/* ---------- KPIs ---------- */
.erStats { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
.erStat {
    flex: 1; min-width: 130px;
    background: var(--paper-alt); border: 1px solid var(--rule); border-radius: 12px;
    padding: 14px 18px; display: flex; flex-direction: column; gap: 2px;
}
.erStatVal { font-size: 22px; font-weight: 700; color: #0F334B; font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.erStatLabel { font-size: 12px; color: var(--ink-soft); }

/* ---------- Editor de correo en línea ---------- */
.erEditRow > td { background: var(--paper-alt); }

@media (max-width: 900px) {
    /* La tabla scrollea sola en vez de desbordar la página. */
    .erWrap .table { display: block; overflow-x: auto; }
    .panel-block:has(.erWrap) > .panel-heading .panel-title,
    .panel-block:has(.erWrap) > .panel-header .panel-title { font-size: 22px; }
}
</style>

<script setup lang="ts">
import { computed, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import DropDownList from "@Obsidian/Controls/dropDownList.obs";
import TextBox from "@Obsidian/Controls/textBox.obs";
import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type EventOptionBag = { eventId: number; name: string; startDateTime: string; status: string };
type TypeStatBag = { id: number; name: string; sold: number; checkedIn: number; capacity: number | null };
type AttendeeRowBag = {
    ticketId: number; attendeeName: string | null; ticketTypeId: number; ticketTypeName: string; uniqueCode: string;
    checkedIn: boolean; checkedInDateTime: string | null; buyerName: string; orderId: number; pricePaid: number;
    purchasedDateTime?: string | null;
    deliveryEmail?: string | null;
    answers?: Record<string, string> | null;
};
type ReportBag = {
    eventName: string; startDateTime: string; venueName: string | null; status: string;
    soldCount: number; checkedInCount: number; attendancePct: number; revenue: number; paidOrderCount: number;
    byType: TypeStatBag[]; rows: AttendeeRowBag[];
    questionColumns?: string[] | null;
    canResend?: boolean;
};
type InitBag = { notLogged: boolean; canView: boolean; events: EventOptionBag[] };

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const busy = ref(false);
const err = ref("");
const report = ref<ReportBag | null>(null);
const search = ref("");
const checkinFilter = ref<string>("all");

const checkinFilterOptions: ListItemBag[] = [
    { value: "all", text: "Todos" },
    { value: "in", text: "Con check-in" },
    { value: "pending", text: "Pendientes" }
];

const statusEs: Record<string, string> = { Draft: "Borrador", Published: "Publicado", Closed: "Cerrado", Cancelled: "Cancelado", Archived: "Archivado" };

// Selector agrupado: "Próximos" arriba, luego los pasados por año (con 200+ eventos al año
// el dropdown plano era inmanejable; enhanceForLongLists agrega el buscador).
const eventItems = computed<ListItemBag[]>(() =>
    (config.events ?? []).map(e => {
        const isUpcoming = new Date(e.startDateTime).getTime() >= Date.now() - 24 * 3600 * 1000;
        return {
            value: String(e.eventId),
            text: `${e.name} — ${fmtDate(e.startDateTime)}${e.status !== "Published" ? ` (${statusEs[e.status] ?? e.status})` : ""}`,
            category: isUpcoming ? "Próximos y en curso" : String(new Date(e.startDateTime).getFullYear())
        };
    }));

const selectedEventId = ref<string>(config.events?.length ? String(config.events[0].eventId) : "");

// Ingresos por tipo de entrada (suma de pricePaid de las filas; mismo criterio que el listado).
const revenueByType = computed<Record<number, number>>(() => {
    const map: Record<number, number> = {};
    for (const r of report.value?.rows ?? []) {
        map[r.ticketTypeId] = (map[r.ticketTypeId] ?? 0) + r.pricePaid;
    }
    return map;
});

const filteredRows = computed<AttendeeRowBag[]>(() => {
    if (!report.value) {
        return [];
    }
    const q = search.value.trim().toLowerCase();
    return report.value.rows.filter(r => {
        if (checkinFilter.value === "in" && !r.checkedIn) return false;
        if (checkinFilter.value === "pending" && r.checkedIn) return false;
        if (!q) return true;
        return (r.attendeeName ?? "").toLowerCase().includes(q)
            || r.uniqueCode.toLowerCase().includes(q)
            || r.buyerName.toLowerCase().includes(q)
            || r.ticketTypeName.toLowerCase().includes(q)
            || String(r.orderId).includes(q);
    });
});

// Editor inline "corregir correo y reenviar": anclado al ticket clickeado, opera sobre la ORDEN.
const emailEdit = ref<{ orderId: number; ticketId: number; email: string; busy: boolean; msg: string; ok: boolean } | null>(null);

function openEmailEdit(r: AttendeeRowBag): void {
    emailEdit.value = { orderId: r.orderId, ticketId: r.ticketId, email: r.deliveryEmail ?? "", busy: false, msg: "", ok: false };
}

async function resendOrderEmail(): Promise<void> {
    const e = emailEdit.value;
    if (!e || !report.value) {
        return;
    }
    e.busy = true;
    e.msg = "";
    try {
        const res = await invokeBlockAction<{ sent: boolean; deliveryEmail: string | null }>("UpdateEmailAndResend",
            { bag: { eventId: Number(selectedEventId.value), orderId: e.orderId, newEmail: e.email.trim() } });
        if (res.isSuccess && res.data?.sent) {
            for (const r of report.value.rows) {
                if (r.orderId === e.orderId) {
                    r.deliveryEmail = res.data.deliveryEmail;
                }
            }
            e.ok = true;
            e.msg = "Entradas reenviadas.";
        }
        else {
            e.ok = false;
            e.msg = res.errorMessage || "No se pudo reenviar.";
        }
    }
    catch {
        e.ok = false;
        e.msg = "Error reenviando las entradas.";
    }
    finally {
        e.busy = false;
    }
}

async function loadReport(): Promise<void> {
    if (!selectedEventId.value) {
        return;
    }
    busy.value = true;
    err.value = "";
    emailEdit.value = null;
    try {
        const res = await invokeBlockAction<ReportBag>("GetReport", { bag: { eventId: Number(selectedEventId.value) } });
        if (res.isSuccess && res.data) {
            report.value = res.data;
        }
        else {
            err.value = res.errorMessage || "No se pudo cargar el reporte.";
        }
    }
    catch {
        err.value = "Error cargando el reporte.";
    }
    finally {
        busy.value = false;
    }
}

// CSV con BOM UTF-8 (para que Excel lea acentos), campos entrecomillados.
// Anti CSV-injection: si el valor inicia con = + - @ (fórmula de Excel), se antepone un apóstrofo.
function downloadCsv(): void {
    if (!report.value) {
        return;
    }
    const esc = (v: unknown): string => {
        let s = String(v ?? "");
        if (/^[=+\-@]/.test(s)) {
            s = "'" + s;
        }
        return `"${s.replace(/"/g, "\"\"")}"`;
    };
    // Columnas dinámicas: las preguntas al asistente configuradas en el evento.
    const qCols = report.value.questionColumns ?? [];
    const lines = [
        ["Asistente", "Tipo", "Código", "Check-in", "Fecha check-in", "Comprador", "Fecha compra", "Orden", "Precio", ...qCols].map(esc).join(","),
        ...report.value.rows.map(r => [
            r.attendeeName || "(sin asignar)",
            r.ticketTypeName,
            r.uniqueCode,
            r.checkedIn ? "Sí" : "No",
            r.checkedInDateTime ? fmtDateTime(r.checkedInDateTime) : "",
            r.buyerName,
            r.purchasedDateTime ? fmtDateTime(r.purchasedDateTime) : "",
            r.orderId,
            r.pricePaid.toFixed(2),
            ...qCols.map(c => r.answers?.[c] ?? "")
        ].map(esc).join(","))
    ];
    const blob = new Blob([String.fromCharCode(0xFEFF) + lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `reporte-${report.value.eventName.replace(/[^\w\dáéíóúñÁÉÍÓÚÑ -]/g, "").trim().replace(/\s+/g, "-").toLowerCase()}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
}

function fmtDate(value: string): string {
    const d = new Date(value);
    return isNaN(d.getTime()) ? "" : d.toLocaleDateString("es-GT", { day: "2-digit", month: "2-digit", year: "numeric" });
}

function fmtDateTime(value: string | null): string {
    if (!value) {
        return "";
    }
    const d = new Date(value);
    return isNaN(d.getTime()) ? "" : d.toLocaleString("es-GT", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
}

function fmtCurrency(value: number): string {
    return new Intl.NumberFormat("es-GT", { style: "currency", currency: "GTQ" }).format(value || 0);
}

// Al cambiar el evento seleccionado se recarga el reporte.
watch(selectedEventId, () => {
    search.value = "";
    checkinFilter.value = "all";
    void loadReport();
});

// Carga inicial del evento más reciente.
if (selectedEventId.value) {
    void loadReport();
}
</script>
