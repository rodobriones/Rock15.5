<template>
    <Panel title="CSV Import" class="panel panel-block">
        <!-- TODO v-if main page-->
        <StepOne v-if="step === 1" :config="config" @stepFinished="onStepOneFinished" />
    </Panel>
</template>

<script setup lang="ts">
    import { computed, ref, watch } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import StepOne from "./stepOne.partial.obs";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { CsvImportBox } from "@Obsidian/ViewModels/Blocks/BulkImport/csvImportBox";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { getTopic } from "@Obsidian/Utility/realTime";
    import { TaskActivityProgressStatusBag } from "@Obsidian/ViewModels/Utility/taskActivityProgressStatusBag";
    import { StepOneResults } from "./csvImport/types.partial";

    const config = useConfigurationValues<CsvImportBox>();
    const invokeBlockAction = useInvokeBlockAction();

    const step = ref<number>(1);

    const dataType = ref<string>("");
    const sourceDescription = ref<string>("");
    const allowUpdatingExistingRecords = ref<boolean>(false);
    const importFile = ref<ListItemBag>();
    const csvColumns = ref<string[]>([]);

    let realTimeConnectionId: string = "";

    function onStepOneFinished(data: StepOneResults): void {
        dataType.value = data.dataType as string;
        sourceDescription.value = data.sourceDescription as string;
        allowUpdatingExistingRecords.value = data.allowUpdatingExistingRecords as boolean;
        importFile.value = data.importFile as ListItemBag;
        csvColumns.value = data.csvColumns as string[];
        step.value = 2;
    }




    /**
     * Initialize the real-time engine and start monitoring for updates to the
     * proxy connection status messages.
     */
    async function startRealTime(): Promise<void> {
        const topic = await getTopic("Rock.RealTime.Topics.TaskActivityProgressTopic");

        topic.onDisconnected(async () => {
            await startRealTime();
        });

        topic.onReconnected(async () => {
            realTimeConnectionId = topic.connectionId ?? "";
        });

        topic.on("taskStarted", onRealtimeUpdate);
        topic.on("taskCompleted", onRealtimeUpdate);
        topic.on("updateTaskProgress", onRealtimeUpdate);
        topic.on("updateTaskLog", onRealtimeUpdate);
        topic.onMessage((...args) => {
            console.debug("Real-time message received:", ...args);
        });

        realTimeConnectionId = topic.connectionId ?? "";
    }

    function onRealtimeUpdate(...args): void {
        // Handle real-time updates
        console.debug("Real-time update received:", ...args);
    }

    // Initialize real-time connection when component mounts
    startRealTime();
</script>
