<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <RootNamespace>com.vidareal.DupDetect</RootNamespace>
    <AssemblyName>com.vidareal.DupDetect</AssemblyName>
  </PropertyGroup>

  <!-- Mismo patron que Plugin.VidaRealWallet: referencias al Bin del repo, sin copiar.
       El nucleo Domain NO usa ninguna de estas; solo las capas de adaptador (Jobs/Store/AI). -->
  <ItemGroup>
    <Reference Include="Rock">
      <HintPath>..\..\RockWeb\Bin\Rock.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Common">
      <HintPath>..\..\RockWeb\Bin\Rock.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Enums">
      <HintPath>..\..\RockWeb\Bin\Rock.Enums.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntityFramework">
      <HintPath>..\..\RockWeb\Bin\EntityFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\RockWeb\Bin\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
