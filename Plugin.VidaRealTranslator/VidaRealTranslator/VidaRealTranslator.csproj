<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <RootNamespace>com.vidareal.Translator</RootNamespace>
    <AssemblyName>com.vidareal.Translator</AssemblyName>
  </PropertyGroup>

  <!-- Referencias a Rock tomadas del build del repo (RockWeb\Bin), mismo patron
       que Plugin.CybersourceInlineRestGateway pero apuntando al Bin del repo. -->
  <ItemGroup>
    <Reference Include="Rock">
      <HintPath>..\..\RockWeb\Bin\Rock.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Common">
      <HintPath>..\..\RockWeb\Bin\Rock.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Enums">
      <HintPath>..\..\RockWeb\Bin\Rock.Enums.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Rest">
      <HintPath>..\..\RockWeb\Bin\Rock.Rest.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rock.Lava.Shared">
      <HintPath>..\..\RockWeb\Bin\Rock.Lava.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntityFramework">
      <HintPath>..\..\RockWeb\Bin\EntityFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\RockWeb\Bin\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Http">
      <HintPath>..\..\RockWeb\Bin\System.Web.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <!-- El dashboard Obsidian se sirve desde la carpeta del plugin (distribuible).
       El fuente vive en Rock.JavaScript.Obsidian.Blocks\src\Translator y se
       compila con npm run build-fast; este paso copia el compilado a la carpeta
       del plugin si existe (si aun no se ha corrido el build de Obsidian, no
       falla el build de C#). -->
  <Target Name="CopyObsidianDashboard" AfterTargets="Build"
          Condition="Exists('..\..\RockWeb\Obsidian\Blocks\Translator\translatorDashboard.obs.js')">
    <Copy SourceFiles="..\..\RockWeb\Obsidian\Blocks\Translator\translatorDashboard.obs.js"
          DestinationFolder="..\..\RockWeb\Plugins\com_vidareal\Translator" />
  </Target>
</Project>
